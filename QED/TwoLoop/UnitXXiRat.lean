/-!
# The coefficients of the `ξ`-antiderivative as single fractions

Each partial-fraction coefficient of `QED.TwoLoop.UnitXXi.xiF` and its `ξ`-derivative, written as
one fraction in `(Y, ξ)` (`xiR0_eq`, `xiR0D_eq`, …, `xiPYD_eq`). The forms were computed by
`scripts/numerics/crossed_graph/xi_integration.py`; each identity is checked by `field_simp` and
`ring`.
-/

@[expose] public section

namespace QED.TwoLoop.UnitXXi

theorem xiR0_eq {Y ξ : ℝ} (hY0 : Y ≠ 0) (hY1 : Y - 1 ≠ 0) (hξ0 : ξ ≠ 0) (hξ1 : ξ - 1 ≠ 0) :
    xiR0 Y ξ = ((-Y ^ 4 * ξ ^ 4 - 13 * Y ^ 4 * ξ ^ 3 + 14 * Y ^ 4 * ξ ^ 2 + 2 * Y ^ 3 * ξ ^ 4 + 27 *
        Y ^ 3 * ξ ^ 3 - 29 * Y ^ 3 * ξ ^ 2 - 2 * Y ^ 3 * ξ - Y ^ 2 * ξ ^ 4 - 4 * Y ^ 2 * ξ ^ 3 + 5 *
        Y ^ 2 * ξ ^ 2 + 12 * Y ^ 2 * ξ - 6 * Y ^ 2 - 4 * Y * ξ ^ 3 + 4 * Y * ξ ^ 2 - 15 * Y * ξ +
        9 * Y + 5 * ξ - 3) / (12 * Y * ξ * (Y - 1) ^ 2 * (ξ - 1))) := by
  unfold xiR0 pfXi
  field_simp
  ring

theorem xiR0D_eq {Y ξ : ℝ} (hY0 : Y ≠ 0) (hY1 : Y - 1 ≠ 0) (hξ0 : ξ ≠ 0) (hξ1 : ξ - 1 ≠ 0) :
