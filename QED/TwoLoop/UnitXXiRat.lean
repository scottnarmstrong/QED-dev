        ξ - 6 * Y ^ 2 - 4 * Y * ξ ^ 4 + 8 * Y * ξ ^ 3 + 11 * Y * ξ ^ 2 - 18 * Y * ξ + 9 * Y - 5 *
        ξ ^ 2 + 6 * ξ - 3) / (12 * Y * ξ ^ 2 * (Y - 1) ^ 2 * (ξ - 1) ^ 2)) := by
  unfold xiR0D pfXiD
