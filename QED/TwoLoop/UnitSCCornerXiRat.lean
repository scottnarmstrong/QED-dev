/-!
# The coefficients of the corner `ξ`-antiderivative as single fractions

Each partial-fraction coefficient of `QED.TwoLoop.UnitSCCornerXi.cxiF` and its `ξ`-derivative, as
one fraction in `(Y, ξ)` (`cxiR0_eq`, …, `cxiPYD_eq`), generated by
`scripts/numerics/sc_graph/corner_integration.py` and checked by `field_simp` and `ring`.
-/

@[expose] public section

namespace QED.TwoLoop.UnitSCCornerXi

open QED.TwoLoop.UnitXClose QED.TwoLoop.UnitXXi QED.TwoLoop.UnitSCCorner

theorem cxiR0_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hξ0 : ξ ≠ 0 := by assumption)
    (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiR0 Y ξ = ((21 * Y ^ 2 * ξ ^ 3 - 21 * Y ^ 2 * ξ ^ 2 + 8 * Y * ξ - 4 * Y - 10 * ξ + 6) / (24 *
        Y * ξ * (ξ - 1))) := by
  unfold cxiR0 pfXi
  field_simp
  ring

theorem cxiR0D_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hξ0 : ξ ≠ 0 := by assumption)
    (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiR0D Y ξ = ((21 * Y ^ 2 * ξ ^ 4 - 42 * Y ^ 2 * ξ ^ 3 + 21 * Y ^ 2 * ξ ^ 2 - 8 * Y * ξ ^ 2 +
        8 *
        Y * ξ - 4 * Y + 10 * ξ ^ 2 - 12 * ξ + 6) / (24 * Y * ξ ^ 2 * (ξ - 1) ^ 2)) := by
  unfold cxiR0D pfXiD
  field_simp
  ring

theorem cxiPx_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPx Y ξ = ((-3 * Y ^ 3 * ξ ^ 4 + 14 * Y ^ 3 * ξ ^ 3 - 18 * Y ^ 3 * ξ ^ 2 + 7 * Y ^ 3 * ξ -
        14 *
        Y ^ 2 * ξ ^ 3 + 18 * Y ^ 2 * ξ ^ 2 - 6 * Y ^ 2 * ξ + 5 * Y * ξ ^ 3 - Y * ξ - 5 * ξ ^ 3 + 9 *
        ξ ^ 2 - 6 * ξ) / (12 * Y ^ 2 * (ξ - 1) ^ 3)) := by
  unfold cxiPx pfXi
  field_simp
  ring

theorem cxiPxD_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPxD Y ξ = ((-3 * Y ^ 3 * ξ ^ 4 + 12 * Y ^ 3 * ξ ^ 3 - 24 * Y ^ 3 * ξ ^ 2 + 22 * Y ^ 3 * ξ -
        7 * Y ^ 3 + 24 * Y ^ 2 * ξ ^ 2 - 24 * Y ^ 2 * ξ + 6 * Y ^ 2 - 15 * Y * ξ ^ 2 + 2 * Y * ξ +
        Y + 6 * ξ ^ 2 - 6 * ξ + 6) / (12 * Y ^ 2 * (ξ - 1) ^ 4)) := by
  unfold cxiPxD pfXiD
  field_simp
  ring

theorem cxiPA_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hY1 : Y - 1 ≠ 0 := by assumption)
    (hξ0 : ξ ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPA Y ξ = ((-3 * Y ^ 5 * ξ ^ 6 + 14 * Y ^ 5 * ξ ^ 5 - 18 * Y ^ 5 * ξ ^ 4 + 7 * Y ^ 5 * ξ ^ 3 +
        6 * Y ^ 4 * ξ ^ 6 - 29 * Y ^ 4 * ξ ^ 5 + 15 * Y ^ 4 * ξ ^ 4 + 19 * Y ^ 4 * ξ ^ 3 - 13 *
        Y ^ 4 * ξ ^ 2 - 3 * Y ^ 3 * ξ ^ 6 + 12 * Y ^ 3 * ξ ^ 5 + 51 * Y ^ 3 * ξ ^ 4 - 87 * Y ^ 3 *
        ξ ^ 3 + 35 * Y ^ 3 * ξ ^ 2 - 5 * Y ^ 2 * ξ ^ 5 - 35 * Y ^ 2 * ξ ^ 4 + 26 * Y ^ 2 * ξ ^ 3 +
        24 * Y ^ 2 * ξ ^ 2 - 28 * Y ^ 2 * ξ + 6 * Y ^ 2 + 6 * Y * ξ ^ 5 + 2 * Y * ξ ^ 4 + 13 * Y *
        ξ ^ 3 - 36 * Y * ξ ^ 2 + 31 * Y * ξ - 8 * Y - 6 * ξ ^ 4 + 6 * ξ ^ 3 + 4 * ξ ^ 2 - 9 * ξ +
        3) / (12 * Y ^ 2 * ξ ^ 2 * (Y - 1) ^ 2 * (ξ - 1) ^ 3)) := by
  unfold cxiPA pfXi
  field_simp
  ring

theorem cxiPAD_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hY1 : Y - 1 ≠ 0 := by assumption)
    (hξ0 : ξ ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPAD Y ξ = ((-3 * Y ^ 5 * ξ ^ 7 + 12 * Y ^ 5 * ξ ^ 6 - 24 * Y ^ 5 * ξ ^ 5 + 22 * Y ^ 5 *
        ξ ^ 4 - 7 * Y ^ 5 * ξ ^ 3 + 6 * Y ^ 4 * ξ ^ 7 - 24 * Y ^ 4 * ξ ^ 6 + 72 * Y ^ 4 * ξ ^ 5 -
        68 * Y ^ 4 * ξ ^ 4 + 20 * Y ^ 4 * ξ ^ 3 - 3 * Y ^ 3 * ξ ^ 7 + 12 * Y ^ 3 * ξ ^ 6 - 87 *
        Y ^ 3 * ξ ^ 5 + 72 * Y ^ 3 * ξ ^ 4 - 18 * Y ^ 3 * ξ ^ 3 + 50 * Y ^ 2 * ξ ^ 5 + 18 * Y ^ 2 *
        ξ ^ 4 - 98 * Y ^ 2 * ξ ^ 3 + 112 * Y ^ 2 * ξ ^ 2 - 58 * Y ^ 2 * ξ + 12 * Y ^ 2 - 20 * Y *
        ξ ^ 5 - 30 * Y * ξ ^ 4 + 95 * Y * ξ ^ 3 - 124 * Y * ξ ^ 2 + 71 * Y * ξ - 16 * Y + 6 *
        ξ ^ 5 - 18 * ξ ^ 3 + 36 * ξ ^ 2 - 24 * ξ + 6) / (12 * Y ^ 2 * ξ ^ 3 * (Y - 1) ^ 2 * (ξ -
        1) ^ 4)) := by
  unfold cxiPAD pfXiD
  field_simp
  ring

theorem cxiPB_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hY1 : Y - 1 ≠ 0 := by assumption)
    (hξ0 : ξ ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPB Y ξ = ((-12 * Y ^ 5 * ξ ^ 5 + 32 * Y ^ 5 * ξ ^ 4 - 31 * Y ^ 5 * ξ ^ 3 + 13 * Y ^ 5 *
        ξ ^ 2 - 2 * Y ^ 5 * ξ + 44 * Y ^ 4 * ξ ^ 5 - 104 * Y ^ 4 * ξ ^ 4 + 99 * Y ^ 4 * ξ ^ 3 - 47 *
        Y ^ 4 * ξ ^ 2 + 11 * Y ^ 4 * ξ - Y ^ 4 - 53 * Y ^ 3 * ξ ^ 5 + 93 * Y ^ 3 * ξ ^ 4 - 69 *
        Y ^ 3 * ξ ^ 3 + 24 * Y ^ 3 * ξ ^ 2 - 3 * Y ^ 3 * ξ + 39 * Y ^ 2 * ξ ^ 5 - 57 * Y ^ 2 *
        ξ ^ 4 + 40 * Y ^ 2 * ξ ^ 3 - 10 * Y ^ 2 * ξ ^ 2 - 21 * Y * ξ ^ 5 + 36 * Y * ξ ^ 4 - 29 * Y *
        ξ ^ 3 + 6 * Y * ξ ^ 2 + 5 * ξ ^ 5 - 9 * ξ ^ 4 + 6 * ξ ^ 3) / (12 * Y ^ 2 * ξ ^ 2 * (Y -
        1) ^ 2 * (ξ - 1) ^ 3)) := by
  unfold cxiPB pfXi
  field_simp
  ring

theorem cxiPBD_eq {Y ξ : ℝ} (hY0 : Y ≠ 0 := by assumption) (hY1 : Y - 1 ≠ 0 := by assumption)
    (hξ0 : ξ ≠ 0 := by assumption) (hξ1 : ξ - 1 ≠ 0 := by assumption) :
    cxiPBD Y ξ = ((4 * Y ^ 5 * ξ ^ 5 - 2 * Y ^ 5 * ξ ^ 4 - 8 * Y ^ 5 * ξ ^ 3 + 8 * Y ^ 5 * ξ ^ 2 -
        2 * Y ^ 5 * ξ - 28 * Y ^ 4 * ξ ^ 5 + 10 * Y ^ 4 * ξ ^ 4 + 42 * Y ^ 4 * ξ ^ 3 - 44 * Y ^ 4 *
        ξ ^ 2 + 16 * Y ^ 4 * ξ - 2 * Y ^ 4 + 66 * Y ^ 3 * ξ ^ 5 - 48 * Y ^ 3 * ξ ^ 4 - 3 * Y ^ 3 *
        ξ ^ 3 + 12 * Y ^ 3 * ξ ^ 2 - 3 * Y ^ 3 * ξ - 60 * Y ^ 2 * ξ ^ 5 + 34 * Y ^ 2 * ξ ^ 4 - 10 *
        Y ^ 2 * ξ ^ 3 + 27 * Y * ξ ^ 5 - 14 * Y * ξ ^ 4 + 11 * Y * ξ ^ 3 - 6 * ξ ^ 5 + 6 * ξ ^ 4 -
        6 * ξ ^ 3) / (12 * Y ^ 2 * ξ ^ 3 * (Y - 1) ^ 2 * (ξ - 1) ^ 4)) := by
  unfold cxiPBD pfXiD
  field_simp
  ring

theorem cxiPY_eq {Y ξ : ℝ} (hY1 : Y - 1 ≠ 0 := by assumption) (hξ0 : ξ ≠ 0 := by assumption) :
    cxiPY Y ξ = ((-3 * Y ^ 3 * ξ ^ 3 - 2 * Y ^ 3 * ξ + 6 * Y ^ 2 * ξ ^ 3 + 8 * Y ^ 2 * ξ - Y ^ 2 -
        3 * Y * ξ ^ 3 - 3 * Y * ξ) / (12 * ξ ^ 2 * (Y - 1) ^ 2)) := by
  unfold cxiPY pfXi
  field_simp
  ring

theorem cxiPYD_eq {Y ξ : ℝ} (hY1 : Y - 1 ≠ 0 := by assumption) (hξ0 : ξ ≠ 0 := by assumption) :
    cxiPYD Y ξ = ((-3 * Y ^ 3 * ξ ^ 3 + 2 * Y ^ 3 * ξ + 6 * Y ^ 2 * ξ ^ 3 - 8 * Y ^ 2 * ξ + 2 *
        Y ^ 2 - 3 * Y * ξ ^ 3 + 3 * Y * ξ) / (12 * ξ ^ 3 * (Y - 1) ^ 2)) := by
  unfold cxiPYD pfXiD
  field_simp
  ring

end QED.TwoLoop.UnitSCCornerXi

end
