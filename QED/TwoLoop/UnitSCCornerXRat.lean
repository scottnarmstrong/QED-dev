module

public import QED.TwoLoop.UnitSCCornerXDefs
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-!
# The corner unit C at `λ = 0`: the derivative identity on the branch `x > x*`

The rational part `cR2` of `G_C` on `x > x*` has simple poles at `x = 1/ξ` and `x = 1/(1 - ξ)`.
Its partial fractions `cR2 = cP2 + cAa/(1 - ξ x) + cBb/(1 - (1 - ξ) x)` (`cR2_split`), the
divisions `ξ cC2a + cAa = (1 - ξ x) cTa`, `(1 - ξ) cC2b + cBb = (1 - (1 - ξ) x) cTb`
(`cC2a_div`, `cC2b_div`) and a polynomial identity (`cA2_poly`) give the derivative identity
`cA2_deriv` of the antiderivative `cornerF2` (generated by
`scripts/numerics/sc_graph/corner_integration.py`).
-/

@[expose] public section

open Real

namespace QED.TwoLoop.UnitSCCorner

/-- The polynomial part of `cR2`. -/
noncomputable def cP2 (Y ξ x : ℝ) : ℝ :=
  px
    ((20 * Y ^ 4 * ξ ^ 6 - 28 * Y ^ 4 * ξ ^ 5 + 16 * Y ^ 4 * ξ ^ 4 - 4 * Y ^ 4 * ξ ^ 3 - 8 * Y ^ 3 *
        ξ ^ 6 + 14 * Y ^ 3 * ξ ^ 5 - 24 * Y ^ 3 * ξ ^ 4 + 18 * Y ^ 3 * ξ ^ 3 - 4 * Y ^ 3 * ξ ^ 2 -
        8 * Y ^ 2 * ξ ^ 6 - 28 * Y ^ 2 * ξ ^ 5 + 73 * Y ^ 2 * ξ ^ 4 - 56 * Y ^ 2 * ξ ^ 3 + 13 *
        Y ^ 2 * ξ ^ 2 + 38 * Y * ξ ^ 5 - 62 * Y * ξ ^ 4 + 34 * Y * ξ ^ 3 + 6 * Y * ξ ^ 2 - 12 * Y *
        ξ + 4 * Y - 13 * ξ ^ 4 + 26 * ξ ^ 3 - 23 * ξ ^ 2 + 10 * ξ - 2) / (8 * Y ^ 4 * ξ ^ 2 * (ξ -
        1) ^ 4))
    ((-8 * Y ^ 4 * ξ ^ 5 - 4 * Y ^ 4 * ξ ^ 4 + 22 * Y ^ 4 * ξ ^ 3 - 12 * Y ^ 4 * ξ ^ 2 + 12 *
        Y ^ 3 * ξ ^ 4 - 24 * Y ^ 3 * ξ ^ 3 + 16 * Y ^ 3 * ξ ^ 2 - 2 * Y ^ 3 * ξ + 16 * Y ^ 2 *
        ξ ^ 5 - 24 * Y ^ 2 * ξ ^ 4 + 40 * Y ^ 2 * ξ ^ 3 - 44 * Y ^ 2 * ξ ^ 2 + 15 * Y ^ 2 * ξ - 8 *
        Y * ξ ^ 5 + 8 * Y * ξ ^ 4 - 20 * Y * ξ ^ 3 + 20 * Y * ξ ^ 2 - 2 * Y * ξ - 2 * Y + 4 *
        ξ ^ 4 - 8 * ξ ^ 3 + 11 * ξ ^ 2 - 7 * ξ + 1) / (4 * Y ^ 4 * ξ * (ξ - 1) ^ 3))
    ((36 * Y ^ 4 * ξ ^ 3 - 16 * Y ^ 4 * ξ ^ 2 - 16 * Y ^ 4 * ξ - 36 * Y ^ 3 * ξ ^ 2 + 38 * Y ^ 3 *
        ξ - 72 * Y ^ 2 * ξ ^ 3 + 74 * Y ^ 2 * ξ ^ 2 - 38 * Y ^ 2 * ξ + 15 * Y ^ 2 + 36 * Y * ξ ^ 3 -
        10 * Y * ξ - 6 * Y - 18 * ξ ^ 2 + 18 * ξ - 5) / (8 * Y ^ 4 * (ξ - 1) ^ 2))
    ((-10 * Y ^ 4 * ξ ^ 2 + 10 * Y ^ 3 * ξ + 20 * Y ^ 2 * ξ ^ 2 - 5 * Y ^ 2 * ξ - 10 * Y * ξ ^ 2 -
        10 * Y * ξ + 5 * ξ) / (4 * Y ^ 4 * (ξ - 1)))
    0
    0
    0
    x

/-- `(ξ cC2a + cAa)/(1 - ξ x)`, a polynomial. -/
noncomputable def cTa (Y ξ x : ℝ) : ℝ :=
  px
    ((4 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 4 * ξ - 2 * Y ^ 3 * ξ ^ 2 + 4 * Y ^ 3 * ξ - 2 * Y ^ 3 - 2 *
        Y ^ 2 * ξ ^ 2 + 7 * Y ^ 2 * ξ - 4 * Y ^ 2 + 6 * Y * ξ ^ 2 - 6 * Y * ξ - 3 * ξ + 3) / (12 *
        Y ^ 4 * ξ ^ 2))
    ((-2 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 4 * ξ - 2 * Y ^ 3 * ξ ^ 2 + 4 * Y ^ 3 * ξ - 2 * Y ^ 3 - 2 *
        Y ^ 2 * ξ ^ 2 + 7 * Y ^ 2 * ξ - 4 * Y ^ 2 + 6 * Y * ξ ^ 2 - 6 * Y * ξ - 3 * ξ + 3) / (12 *
        Y ^ 4 * ξ))
    ((-8 * Y ^ 4 * ξ ^ 2 + 4 * Y ^ 4 * ξ + 4 * Y ^ 3 * ξ ^ 2 - 2 * Y ^ 3 * ξ - 2 * Y ^ 3 - 8 *
        Y ^ 2 * ξ ^ 2 + 13 * Y ^ 2 * ξ - 4 * Y ^ 2 + 6 * Y * ξ ^ 2 - 6 * Y * ξ - 3 * ξ + 3) / (12 *
        Y ^ 4))
    ((2 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 3 * ξ ^ 2 - 4 * Y ^ 2 * ξ ^ 3 + 3 * Y ^ 2 *
        ξ ^ 2 - 3 * Y ^ 2 * ξ + 2 * Y * ξ ^ 3 - ξ ^ 2 + ξ) / (4 * Y ^ 4))
    ((-2 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 3 * ξ ^ 2 + 4 * Y ^ 2 * ξ ^ 3 - Y ^ 2 * ξ ^ 2 - 2 * Y * ξ ^ 3 -
        2 * Y * ξ ^ 2 + ξ ^ 2) / (4 * Y ^ 4))
    0
    0
    x

/-- `((1 - ξ) cC2b + cBb)/(1 - (1 - ξ) x)`, a polynomial. -/
noncomputable def cTb (Y ξ x : ℝ) : ℝ :=
  px
    ((-20 * Y ^ 4 * ξ ^ 4 + 14 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 4 * ξ + 10 * Y ^ 3 *
        ξ ^ 4 - 22 * Y ^ 3 * ξ ^ 3 + 36 * Y ^ 3 * ξ ^ 2 - 22 * Y ^ 3 * ξ + 4 * Y ^ 3 + 10 * Y ^ 2 *
        ξ ^ 4 + 23 * Y ^ 2 * ξ ^ 3 - 35 * Y ^ 2 * ξ ^ 2 + 12 * Y ^ 2 * ξ - Y ^ 2 - 6 * Y * ξ ^ 4 -
        12 * Y * ξ ^ 3 + 6 * Y * ξ ^ 2 + 3 * ξ ^ 3) / (12 * Y ^ 4 * (ξ - 1) ^ 4))
    ((26 * Y ^ 4 * ξ ^ 4 - 38 * Y ^ 4 * ξ ^ 3 + 34 * Y ^ 4 * ξ ^ 2 - 22 * Y ^ 4 * ξ + 6 * Y ^ 4 -
        10 * Y ^ 3 * ξ ^ 4 + 22 * Y ^ 3 * ξ ^ 3 - 36 * Y ^ 3 * ξ ^ 2 + 22 * Y ^ 3 * ξ - 4 * Y ^ 3 -
        10 * Y ^ 2 * ξ ^ 4 - 23 * Y ^ 2 * ξ ^ 3 + 35 * Y ^ 2 * ξ ^ 2 - 12 * Y ^ 2 * ξ + Y ^ 2 + 6 *
        Y * ξ ^ 4 + 12 * Y * ξ ^ 3 - 6 * Y * ξ ^ 2 - 3 * ξ ^ 3) / (12 * Y ^ 4 * (ξ - 1) ^ 3))
    ((-20 * Y ^ 4 * ξ ^ 4 + 14 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 4 * ξ + 4 * Y ^ 3 *
        ξ ^ 4 + 2 * Y ^ 3 * ξ ^ 3 + 2 * Y ^ 3 * ξ - 2 * Y ^ 3 + 16 * Y ^ 2 * ξ ^ 4 - Y ^ 2 * ξ ^ 3 +
        Y ^ 2 * ξ ^ 2 - 12 * Y ^ 2 * ξ + 5 * Y ^ 2 - 6 * Y * ξ ^ 4 - 12 * Y * ξ ^ 3 + 6 * Y *
        ξ ^ 2 + 3 * ξ ^ 3) / (12 * Y ^ 4 * (ξ - 1) ^ 2))
    ((2 * Y ^ 4 * ξ ^ 4 + 4 * Y ^ 4 * ξ ^ 3 - 4 * Y ^ 4 * ξ ^ 2 - 2 * Y ^ 3 * ξ ^ 3 - 2 * Y ^ 3 *
        ξ ^ 2 + 2 * Y ^ 3 * ξ - 4 * Y ^ 2 * ξ ^ 4 - Y ^ 2 * ξ ^ 3 + 2 * Y ^ 2 * ξ + 2 * Y * ξ ^ 4 +
        2 * Y * ξ ^ 3 + 2 * Y * ξ ^ 2 - 2 * Y * ξ - ξ ^ 3) / (4 * Y ^ 4 * (ξ - 1)))
    ((-2 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 3 * ξ ^ 2 + 4 * Y ^ 2 * ξ ^ 3 - Y ^ 2 * ξ ^ 2 - 2 * Y * ξ ^ 3 -
        2 * Y * ξ ^ 2 + ξ ^ 2) / (4 * Y ^ 4))
    0
    0
    x

/-- The residue of `cR2` at `x = 1/ξ`, times `1 - ξ x`. -/
noncomputable def cAa (Y ξ : ℝ) : ℝ :=
  (((ξ - 1) * (4 * Y * ξ ^ 2 - 2 * Y - 2 * ξ + 1)) / (4 * Y ^ 4 * ξ ^ 2 * (2 * ξ - 1)))

/-- The residue of `cR2` at `x = 1/(1 - ξ)`, times `1 - (1 - ξ) x`. -/
noncomputable def cBb (Y ξ : ℝ) : ℝ :=
  ((-16 * Y ^ 4 * ξ ^ 5 + 24 * Y ^ 4 * ξ ^ 4 - 12 * Y ^ 4 * ξ ^ 3 + 2 * Y ^ 4 * ξ ^ 2 + 8 * Y ^ 3 *
      ξ ^ 5 - 8 * Y ^ 3 * ξ ^ 4 + 2 * Y ^ 3 * ξ ^ 3 + 8 * Y ^ 2 * ξ ^ 5 - 4 * Y ^ 2 * ξ ^ 4 - 4 *
      Y ^ 2 * ξ ^ 3 + 4 * Y ^ 2 * ξ ^ 2 - Y ^ 2 * ξ - 4 * Y * ξ ^ 5 - 4 * Y * ξ ^ 4 + 6 * Y *
      ξ ^ 3 - 2 * Y * ξ ^ 2 + 2 * ξ ^ 4 - ξ ^ 3) / (4 * Y ^ 4 * (ξ - 1) ^ 4 * (2 * ξ - 1)))

theorem cR2N_split {Y ξ x : ℝ} (hY0 : Y ≠ 0) (hξ1 : ξ - 1 ≠ 0) (hξ2 : 2 * ξ - 1 ≠ 0)
    (hξ0 : ξ ≠ 0) :
    cR2N Y ξ x = cP2 Y ξ x * ((1 - ξ * x) * (1 - (1 - ξ) * x)) +
      cAa Y ξ * (1 - (1 - ξ) * x) + cBb Y ξ * (1 - ξ * x) := by
  have hξ2' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  unfold cR2N cP2 cAa cBb px
  field_simp
  ring

theorem cR2_split {Y ξ x : ℝ} (hY0 : Y ≠ 0) (hξ1 : ξ - 1 ≠ 0) (hξ2 : 2 * ξ - 1 ≠ 0)
    (hξ0 : ξ ≠ 0) (hA : 1 - ξ * x ≠ 0) (hB : 1 - (1 - ξ) * x ≠ 0) :
    cR2 Y ξ x = cP2 Y ξ x + cAa Y ξ / (1 - ξ * x) + cBb Y ξ / (1 - (1 - ξ) * x) := by
  rw [cR2, cR2N_split hY0 hξ1 hξ2 hξ0, div_eq_iff (mul_ne_zero hA hB), add_mul, add_mul,
    show cAa Y ξ / (1 - ξ * x) * ((1 - ξ * x) * (1 - (1 - ξ) * x)) =
      cAa Y ξ * (1 - (1 - ξ) * x) by field_simp,
    show cBb Y ξ / (1 - (1 - ξ) * x) * ((1 - ξ * x) * (1 - (1 - ξ) * x)) =
      cBb Y ξ * (1 - ξ * x) by field_simp]

theorem cC2a_div {Y ξ x : ℝ} (hY0 : Y ≠ 0) (hξ2 : 2 * ξ - 1 ≠ 0) (hξ0 : ξ ≠ 0) :
    ξ * cC2a Y ξ x + cAa Y ξ = (1 - ξ * x) * cTa Y ξ x := by
  have hξ2' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  unfold cC2a cAa cTa px
  field_simp
  ring

theorem cC2b_div {Y ξ x : ℝ} (hY0 : Y ≠ 0) (hξ1 : ξ - 1 ≠ 0) (hξ2 : 2 * ξ - 1 ≠ 0) :
    (1 - ξ) * cC2b Y ξ x + cBb Y ξ = (1 - (1 - ξ) * x) * cTb Y ξ x := by
  have hξ2' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ1' : 1 - ξ ≠ 0 := fun h => hξ1 (by linarith)
  unfold cC2b cBb cTb px
  field_simp
  ring

theorem cA2_poly {Y ξ x : ℝ} (hY0 : Y ≠ 0) (hξ1 : ξ - 1 ≠ 0) (hξ2 : 2 * ξ - 1 ≠ 0)
    (hξ0 : ξ ≠ 0) :
    cA2D Y ξ x + (1 - x) / 4 + 2 * cQ1x Y ξ x - cTa Y ξ x - cTb Y ξ x = cP2 Y ξ x := by
  have hξ2' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  unfold cA2D cQ1x cTa cTb cP2 px pxD
  field_simp
  ring

theorem cA2_deriv {Y ξ x : ℝ} (hY0 : 0 < Y) (hξ0 : 0 < ξ) (hξ1 : ξ < 1)
    (hx0 : 0 < x) (hx1 : x < 1) (hξ2 : ξ ≠ 1 / 2) :
    cA2D Y ξ x + (1 - x) / 4 + 2 * cQ1x Y ξ x + cC2a Y ξ x * (-ξ / (1 - ξ * x)) +
      cC2b Y ξ x * (-(1 - ξ) / (1 - (1 - ξ) * x)) = cR2 Y ξ x := by
  have hA : 1 - ξ * x ≠ 0 := by nlinarith
  have hB : 1 - (1 - ξ) * x ≠ 0 := by nlinarith
  have hA' : x * ξ - 1 ≠ 0 := fun h => hA (by linarith)
  have hB' : x * ξ - x + 1 ≠ 0 := fun h => hB (by linarith)
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have da := cC2a_div (x := x) hY0.ne' hξ2' hξ0.ne'
  have db := cC2b_div (x := x) hY0.ne' hξ1' hξ2'
  have dp := cA2_poly (x := x) hY0.ne' hξ1' hξ2' hξ0.ne'
  rw [cR2_split hY0.ne' hξ1' hξ2' hξ0.ne' hA hB]
  have ea : cC2a Y ξ x * (-ξ / (1 - ξ * x)) = -cTa Y ξ x + cAa Y ξ / (1 - ξ * x) := by
    rw [eq_comm, ← sub_eq_zero]
    field_simp
    linear_combination da
  have eb : cC2b Y ξ x * (-(1 - ξ) / (1 - (1 - ξ) * x)) =
      -cTb Y ξ x + cBb Y ξ / (1 - (1 - ξ) * x) := by
    rw [eq_comm, ← sub_eq_zero]
    field_simp
    linear_combination db
  rw [ea, eb]
  linear_combination dp

end QED.TwoLoop.UnitSCCorner

end
