module

public import QED.TwoLoop.UnitSCCornerXBranch
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# The corner unit C at `λ = 0`: the endpoint coefficients of the `x`-integration

Section 6.6.1 of `docs/TWO-LOOP-UNITS.md`. The endpoint values
`F₁(x*) - F₁(0) + F₂(1) - F₂(x*)` of the antiderivatives of
`QED.TwoLoop.UnitSCCorner.cornerF1`, `cornerF2`, with the logarithms of the letters at `x*` written
in the letters `Y, ξ, 1 - Y, 1 - ξ, 1 - Y ξ, ξ + Y - 2 Y ξ`, have the coefficients of `Φ_C`
(`cornerF_coeff_LY`, …, `cornerF_coeff_1`); those of `log(1 - Y)` and `log(1 - ξ)` vanish. Each
identity is checked by `field_simp` and `ring` (generated by
`scripts/numerics/sc_graph/corner_integration.py`).
-/

@[expose] public section

open Real Set

namespace QED.TwoLoop.UnitSCCorner

variable {Y ξ : ℝ}

theorem cornerF_coeff_LY (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    -cC1 Y ξ 0 - 1/4 = cφY Y ξ := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [cC1, px, cφY]
  first
  | (field_simp; done)
  | (field_simp; ring)

theorem cornerF_coeff_Lxi (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    cC2b Y ξ 1 + cQ1x Y ξ 1 = cφx Y ξ := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [cQ1x, cC2b, px, cφx]
  first
  | (field_simp; done)
  | (field_simp; ring)

theorem cornerF_coeff_L1xi (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    cC2a Y ξ 1 - cC2a Y ξ (xStar Y ξ) + cQ1x Y ξ 1 - cQ1x Y ξ (xStar Y ξ) * xStar Y ξ + xStar Y
        ξ ^ 2/4 - xStar Y ξ/2 + 1/4 = 0 := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [xStar, cQ1x, cC2a, px]
  first
  | (field_simp; done)
  | (field_simp; ring)

theorem cornerF_coeff_LA (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    -cC1 Y ξ (xStar Y ξ) + cC2a Y ξ (xStar Y ξ) + cC2b Y ξ (xStar Y ξ) + cQ1x Y ξ (xStar Y ξ) *
        xStar Y ξ - xStar Y ξ ^ 2/4 + xStar Y ξ/2 - 1/4 = cφA Y ξ := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [xStar, cQ1x, cC1, cC2a, cC2b, px, cφA]
  first
  | (field_simp; done)
  | (field_simp; ring)

theorem cornerF_coeff_LB (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    cC1 Y ξ (xStar Y ξ) - cC2b Y ξ (xStar Y ξ) = cφB Y ξ := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [xStar, cC1, cC2b, px, cφB]
  first
  | (field_simp; done)
  | (field_simp; ring)

theorem cornerF_coeff_1 (hY : Y ∈ Ioo (0 : ℝ) 1) (hξ : ξ ∈ Ioo (0 : ℝ) 1) (hξ2 : ξ ≠ 1 / 2) :
    -cA1 Y ξ 0 + cA1 Y ξ (xStar Y ξ) + cA2 Y ξ 1 - cA2 Y ξ (xStar Y ξ) = cφ1 Y ξ := by
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hA : 1 - Y * ξ ≠ 0 := by nlinarith
  have hY1' : Y - 1 ≠ 0 := by linarith
  have hξ1' : ξ - 1 ≠ 0 := by linarith
  have hξ2' : 2 * ξ - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have hξ2'' : ξ * 2 - 1 ≠ 0 := fun h => hξ2 (by linarith)
  have := hY0.ne'
  have := hξ0.ne'
  simp only [xStar, cA1, cA2, px, cφ1]
  first
  | (field_simp; done)
  | (field_simp; ring)

end QED.TwoLoop.UnitSCCorner

end
