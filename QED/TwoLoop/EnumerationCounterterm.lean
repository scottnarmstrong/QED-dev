public import QED.TwoLoop.EnumerationDecide
public import QED.Frozen.WickModel.FermionSign

/-!
# The 1PI contractions of order five with counterterms

Obligation O2-2 (section 3.2 of `docs/TWO-LOOP-DERIVATION.md`) for the 27 kind sequences of
total order exactly `5` other than five gauge vertices, `nf = nA = 1`. This file is generated by
`scripts/numerics/two_loop_enumeration_lean.py`; every statement is checked by the kernel.

For each sequence `κ` (named by its kinds: `g` gauge, `C` gaugeCt, `f` fermionCt, `p` photonCt):

* `invs_κ`: the photon pairings; `invs_κ_complete`: there are no others;
* `onePI_κ`: the 1PI contractions, written as an open fermion line and a photon pairing;
* `isOnePI_iff_κ`: a contraction is 1PI iff it is in `onePI_κ`;
* `sign_κ`: each has fermionic sign `+1` (none has a closed loop).

The 1PI contractions with counterterms (each a one-loop vertex graph with one counterterm):

* `ggC`, `gCg`, `Cgg` (`δ₁`): 6 each, two per position of the `gaugeCt` vertex on the open line;
* `gggf`, `ggfg`, `gfgg`, `fggg` (`δ₂`, `δm`): 12 each, 6 on each internal electron line;
* `gggp`, `ggpg`, `gpgg`, `pggg` (`δ₃`): 12 each, 6 for each of the two ways to join the two
  photon fields of the `photonCt` vertex to the internal photon line.

The other 16 sequences (`Cf`, `Cp`, `fC`, `pC`, `gff`, `gfp`, `gpf`, `gpp`, `fgf`, `fgp`, `ffg`,
`fpg`, `pgf`, `pgp`, `pfg`, `ppg`) have no 1PI contraction: they are trees.

## Main statements

* `QED.TwoLoop.Enumeration.isOnePI_iff_<κ>` and `sign_<κ>` for each `κ`;
* `QED.TwoLoop.Enumeration.sum_isOnePI_<κ>`: the signed sum over the 1PI contractions of any
  function `G` is the sum of `G` over `onePI_κ`.
-/

@[expose] public section

namespace QED.TwoLoop.Enumeration

open QED.WickModel

variable {N : ℕ}

/-- The fermion field of vertex `t` of `κ`. -/
def fvK (κ : Fin N → Wick.VertexKind) (t : Fin N) (h : κ t ≠ .photonCt := by decide) :
    Wick.FermionVertex κ := ⟨t, h⟩

/-- The `k`-th photon field of vertex `t` of `κ`. -/
def psK (κ : Fin N → Wick.VertexKind) (t : Fin N) (k : ℕ)
    (h : k < (κ t).photonSlots := by decide) : Wick.PhotonSlot κ := ⟨t, ⟨k, h⟩⟩

/-- The fermion pairing of the open line `y → v₁ → ⋯ → v_k → x`, with no closed loop. -/
def fermionPermK (κ : Fin N → Wick.VertexKind) (openLine : List (Wick.FermionVertex κ)) :
    Equiv.Perm (Fin 1 ⊕ Wick.FermionVertex κ) :=
  (Sum.inl 0 :: openLine.reverse.map Sum.inr).formPerm

/-- The photon pairing with the external photon at `ext` and the internal lines `pairs`. -/
def photonPermK (κ : Fin N → Wick.VertexKind) (ext : Wick.PhotonSlot κ)
    (pairs : List (Wick.PhotonSlot κ × Wick.PhotonSlot κ)) :
    Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot κ) :=
  Equiv.swap (.inl 0) (.inr ext) * (pairs.map fun p => Equiv.swap (.inr p.1) (.inr p.2)).prod

/-- A fixed-point-free involution of the photon fields. -/
def IsInvolK {κ : Fin N → Wick.VertexKind} (τ : Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot κ)) : Prop :=
  ∀ b, τ (τ b) = b ∧ τ b ≠ b

instance {κ : Fin N → Wick.VertexKind} : DecidablePred (IsInvolK (κ := κ)) := fun τ => by
  unfold IsInvolK; infer_instance

/-- Equality of contractions is decidable. -/
scoped instance instDecidableEqContraction {nf nA : ℕ} {κ : Fin N → Wick.VertexKind} :
    DecidableEq (Contraction nf nA κ) := fun a b =>
  decidable_of_iff (a.1.1 = b.1.1 ∧ a.1.2 = b.1.2) (by rw [← Prod.ext_iff, Subtype.ext_iff])

/-- The contractions with fermion pairing `σ` and a photon pairing from the list `invs`. -/
def withSigmaK {κ : Fin N → Wick.VertexKind} (invs : List (Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot κ)))
    (hinv : ∀ τ ∈ invs, IsInvolK τ) (σ : Equiv.Perm (Fin 1 ⊕ Wick.FermionVertex κ)) :
    List (Contraction 1 1 κ) :=
  invs.attach.map fun τ => ⟨(σ, τ.1), fun b => hinv τ.1 τ.2 b⟩

theorem mem_withSigmaK {κ : Fin N → Wick.VertexKind}
    {invs : List (Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot κ))} (hinv : ∀ τ ∈ invs, IsInvolK τ)
    (hcomp : ∀ τ, IsInvolK τ → τ ∈ invs) (C : Contraction 1 1 κ) :
    C ∈ withSigmaK invs hinv C.1.1 :=
  List.mem_map.mpr ⟨⟨C.1.2, hcomp _ C.2⟩, List.mem_attach _ _, rfl⟩

/-- The signed sum over the 1PI contractions, given their list with signs `+1`. -/
theorem sum_isOnePI_of_list {κ : Fin N → Wick.VertexKind} {s : Finset (Contraction 1 1 κ)}
    (L : List (Contraction 1 1 κ)) (hL : L.Nodup) (hs : ∀ C, C ∈ s ↔ C ∈ L)
    (hsign : ∀ C ∈ L, fermionSign C = 1) (G : Contraction 1 1 κ → ℂ) :
    ∑ C ∈ s, ((fermionSign C : ℤ) : ℂ) * G C = (L.map G).sum := by
  have hs' : s = L.toFinset := Finset.ext fun C => by rw [hs, List.mem_toFinset]
  rw [hs', List.sum_toFinset _ hL]
  congr 1
  refine List.map_congr_left fun C hC => ?_
  rw [hsign C hC]
  simp

/-! ### `Cf` -/

/-- The kind sequence `Cf`. -/
def k_Cf : Fin 2 → Wick.VertexKind := ![.gaugeCt, .fermionCt]

/-- The photon pairings of `Cf`. -/
def invs_Cf : List (Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot k_Cf)) :=
  [photonPermK k_Cf (psK k_Cf 0 0)
        []]

theorem invs_Cf_invol : ∀ τ ∈ invs_Cf, IsInvolK τ := by decide +kernel

theorem invs_Cf_complete : ∀ τ : Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot k_Cf),
    IsInvolK τ → τ ∈ invs_Cf := by decide +kernel

/-- The 1PI contractions of `Cf`. -/
def onePI_Cf : List (Contraction 1 1 k_Cf) :=
  []

theorem onePI_Cf_nodup : (onePI_Cf).Nodup := by decide +kernel

theorem sign_Cf : ∀ C ∈ onePI_Cf, fermionSign C = 1 := by decide +kernel

theorem classify_Cf : ∀ σ : Equiv.Perm (Fin 1 ⊕ Wick.FermionVertex k_Cf),
    ∀ C ∈ withSigmaK invs_Cf invs_Cf_invol σ, IsOnePI C ↔ ∃ D ∈ onePI_Cf, D = C := by
  decide +kernel

/-- A contraction of `Cf` is 1PI iff it is one of the 0 listed. -/
theorem isOnePI_iff_Cf (C : Contraction 1 1 k_Cf) : IsOnePI C ↔ C ∈ onePI_Cf :=
  (classify_Cf C.1.1 C (mem_withSigmaK _ invs_Cf_complete C)).trans (by simp)

/-- The signed sum over the 1PI contractions of `Cf`, for any instances. -/
theorem sum_isOnePI_Cf {instF : Fintype (Contraction 1 1 k_Cf)}
    {instD : DecidablePred (IsOnePI (nf := 1) (nA := 1) (κ := k_Cf))}
    (G : Contraction 1 1 k_Cf → ℂ) :
    ∑ C ∈ (Finset.univ : Finset (Contraction 1 1 k_Cf)).filter IsOnePI,
      ((fermionSign C : ℤ) : ℂ) * G C = ((onePI_Cf).map G).sum :=
  sum_isOnePI_of_list _ onePI_Cf_nodup
    (fun C => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact isOnePI_iff_Cf C)
    sign_Cf G

