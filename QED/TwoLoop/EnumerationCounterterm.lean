def invs_gff : List (Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot k_gff)) :=
  [photonPermK k_gff (psK k_gff 0 0)
        []]

theorem invs_gff_invol : ∀ τ ∈ invs_gff, IsInvolK τ := by decide +kernel

theorem invs_gff_complete : ∀ τ : Equiv.Perm (Fin 1 ⊕ Wick.PhotonSlot k_gff),
    IsInvolK τ → τ ∈ invs_gff := by decide +kernel

/-- The 1PI contractions of `gff`. -/
def onePI_gff : List (Contraction 1 1 k_gff) :=
  []

theorem onePI_gff_nodup : (onePI_gff).Nodup := by decide +kernel

theorem sign_gff : ∀ C ∈ onePI_gff, fermionSign C = 1 := by decide +kernel

theorem classify_gff : ∀ σ : Equiv.Perm (Fin 1 ⊕ Wick.FermionVertex k_gff),
    ∀ C ∈ withSigmaK invs_gff invs_gff_invol σ, IsOnePI C ↔ ∃ D ∈ onePI_gff, D = C := by
  decide +kernel

/-- A contraction of `gff` is 1PI iff it is one of the 0 listed. -/
theorem isOnePI_iff_gff (C : Contraction 1 1 k_gff) : IsOnePI C ↔ C ∈ onePI_gff :=
  (classify_gff C.1.1 C (mem_withSigmaK _ invs_gff_complete C)).trans (by simp)

/-- The signed sum over the 1PI contractions of `gff`, for any instances. -/
theorem sum_isOnePI_gff {instF : Fintype (Contraction 1 1 k_gff)}
    {instD : DecidablePred (IsOnePI (nf := 1) (nA := 1) (κ := k_gff))}
