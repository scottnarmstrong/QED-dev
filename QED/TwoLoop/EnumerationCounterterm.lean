    ⟨(fermionPermK k_pggg [fvK k_pggg 3, fvK k_pggg 2, fvK k_pggg 1],
      photonPermK k_pggg (psK k_pggg 2 0)
        [(psK k_pggg 0 1, psK k_pggg 1 0), (psK k_pggg 0 0, psK k_pggg 3 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 2, fvK k_pggg 3, fvK k_pggg 1],
      photonPermK k_pggg (psK k_pggg 3 0)
        [(psK k_pggg 0 1, psK k_pggg 2 0), (psK k_pggg 0 0, psK k_pggg 1 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 2, fvK k_pggg 3, fvK k_pggg 1],
      photonPermK k_pggg (psK k_pggg 3 0)
        [(psK k_pggg 0 1, psK k_pggg 1 0), (psK k_pggg 0 0, psK k_pggg 2 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 1, fvK k_pggg 3, fvK k_pggg 2],
      photonPermK k_pggg (psK k_pggg 3 0)
        [(psK k_pggg 0 1, psK k_pggg 2 0), (psK k_pggg 0 0, psK k_pggg 1 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 1, fvK k_pggg 3, fvK k_pggg 2],
      photonPermK k_pggg (psK k_pggg 3 0)
        [(psK k_pggg 0 1, psK k_pggg 1 0), (psK k_pggg 0 0, psK k_pggg 2 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 3, fvK k_pggg 1, fvK k_pggg 2],
      photonPermK k_pggg (psK k_pggg 1 0)
        [(psK k_pggg 0 1, psK k_pggg 3 0), (psK k_pggg 0 0, psK k_pggg 2 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 3, fvK k_pggg 1, fvK k_pggg 2],
      photonPermK k_pggg (psK k_pggg 1 0)
        [(psK k_pggg 0 1, psK k_pggg 2 0), (psK k_pggg 0 0, psK k_pggg 3 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 1, fvK k_pggg 2, fvK k_pggg 3],
      photonPermK k_pggg (psK k_pggg 2 0)
        [(psK k_pggg 0 1, psK k_pggg 3 0), (psK k_pggg 0 0, psK k_pggg 1 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 1, fvK k_pggg 2, fvK k_pggg 3],
      photonPermK k_pggg (psK k_pggg 2 0)
        [(psK k_pggg 0 1, psK k_pggg 1 0), (psK k_pggg 0 0, psK k_pggg 3 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 2, fvK k_pggg 1, fvK k_pggg 3],
      photonPermK k_pggg (psK k_pggg 1 0)
        [(psK k_pggg 0 1, psK k_pggg 3 0), (psK k_pggg 0 0, psK k_pggg 2 0)]), by decide +kernel⟩,
    ⟨(fermionPermK k_pggg [fvK k_pggg 2, fvK k_pggg 1, fvK k_pggg 3],
      photonPermK k_pggg (psK k_pggg 1 0)
        [(psK k_pggg 0 1, psK k_pggg 2 0), (psK k_pggg 0 0, psK k_pggg 3 0)]), by decide +kernel⟩]

theorem onePI_pggg_nodup : (onePI_pggg).Nodup := by decide +kernel

theorem sign_pggg : ∀ C ∈ onePI_pggg, fermionSign C = 1 := by decide +kernel

theorem classify_pggg : ∀ σ : Equiv.Perm (Fin 1 ⊕ Wick.FermionVertex k_pggg),
    ∀ C ∈ withSigmaK invs_pggg invs_pggg_invol σ, IsOnePI C ↔ ∃ D ∈ onePI_pggg, D = C := by
  decide +kernel

/-- A contraction of `pggg` is 1PI iff it is one of the 12 listed. -/
theorem isOnePI_iff_pggg (C : Contraction 1 1 k_pggg) : IsOnePI C ↔ C ∈ onePI_pggg :=
  (classify_pggg C.1.1 C (mem_withSigmaK _ invs_pggg_complete C)).trans (by simp)

/-- The signed sum over the 1PI contractions of `pggg`, for any instances. -/
theorem sum_isOnePI_pggg {instF : Fintype (Contraction 1 1 k_pggg)}
    {instD : DecidablePred (IsOnePI (nf := 1) (nA := 1) (κ := k_pggg))}
    (G : Contraction 1 1 k_pggg → ℂ) :
    ∑ C ∈ (Finset.univ : Finset (Contraction 1 1 k_pggg)).filter IsOnePI,
      ((fermionSign C : ℤ) : ℂ) * G C = ((onePI_pggg).map G).sum :=
  sum_isOnePI_of_list _ onePI_pggg_nodup
    (fun C => by
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      exact isOnePI_iff_pggg C)
    sign_pggg G

end QED.TwoLoop.Enumeration

