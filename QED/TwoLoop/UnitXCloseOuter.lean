/-- The numerator of `xc₃₀`. -/
noncomputable def xc₃₀N (M c : ℝ) : ℝ :=
  -3 * M ^ 5 - 7 * M ^ 4 * c + 8 * M ^ 4 - 6 * M ^ 3 * c ^ 2 + 21 * M ^ 3 * c - 8 * M ^ 3 -
    2 * M ^ 2 * c ^ 3 + 18 * M ^ 2 * c ^ 2 - 21 * M ^ 2 * c + 4 * M ^ 2 + 4 * M * c ^ 3 -
    14 * M * c ^ 2 + 7 * M * c - M - 2 * c ^ 3 + 2 * c ^ 2

/-- The coefficient of `b⁻³` in `Q'`. -/
noncomputable def xc₃₀ (M c : ℝ) : ℝ :=
  xc₃₀N M c / (2 * c)

/-- The numerator of `xc₂ₑ`. -/
noncomputable def xc₂ₑN (M c : ℝ) : ℝ :=
  -3 * M ^ 4 + 6 * M ^ 3 + 6 * M ^ 2 * c ^ 2 - 4 * M ^ 2 - 2 * M * c ^ 2 - 2 * M * c + 2 * M -
    4 * c ^ 2 + 2 * c - 1

/-- The coefficient of `(b + e)⁻²` in `Q'`. -/
noncomputable def xc₂ₑ (M c : ℝ) : ℝ :=
  xc₂ₑN M c / (4 * c ^ 2)

/-- The numerator of `xc₃ₑ`. -/
noncomputable def xc₃ₑN (M _c : ℝ) : ℝ :=
  M ^ 4 - 2 * M ^ 3 + M ^ 2

/-- The coefficient of `(b + e)⁻³` in `Q'`. -/
noncomputable def xc₃ₑ (M c : ℝ) : ℝ :=
  xc₃ₑN M c / (1)

/-- The numerator of `xκe`. -/
noncomputable def xκeN (M c : ℝ) : ℝ :=
  4 * M ^ 6 * c + 6 * M ^ 6 - 4 * M ^ 5 * c ^ 2 - M ^ 5 * c - 12 * M ^ 5 - 4 * M ^ 4 * c ^ 3 -
    7 * M ^ 4 * c ^ 2 + 2 * M ^ 4 * c + 6 * M ^ 4 + 2 * M ^ 3 * c ^ 4 + 4 * M ^ 3 * c ^ 3 +
    6 * M ^ 3 * c ^ 2 - M ^ 3 * c - 2 * M ^ 2 * c ^ 5 + 3 * M ^ 2 * c ^ 4 - 10 * M ^ 2 * c ^ 3 +
    6 * M ^ 2 * c ^ 2 - 4 * M * c ^ 5 + 10 * M * c ^ 4 + M * c ^ 3 - 6 * c ^ 5 + 6 * c ^ 4

/-- The coefficient of `log (b + d)` in the `z_A`-antiderivative, `d = e`. -/
noncomputable def xκe (M c : ℝ) : ℝ :=
  xκeN M c / (12 * M ^ 3 * c ^ 4)

/-- The numerator of `xκp`. -/
noncomputable def xκpN (M c : ℝ) : ℝ :=
  -2 * M ^ 6 + 5 * M ^ 5 + M ^ 4 * c - 4 * M ^ 4 - 11 * M ^ 3 * c ^ 2 + 8 * M ^ 3 * c +
    2 * M ^ 3 + 2 * M ^ 2 * c ^ 4 + M ^ 2 * c ^ 3 - 6 * M ^ 2 * c ^ 2 - M ^ 2 * c +
    4 * M * c ^ 4 - 4 * M * c ^ 3 - 7 * M * c ^ 2 + 6 * c ^ 4 - 6 * c ^ 3

/-- The coefficient of `log (b + d)` in the `z_A`-antiderivative, `d = p`. -/
noncomputable def xκp (M c : ℝ) : ℝ :=
  xκpN M c / (12 * M ^ 3 * (-M + c) * (M + c) ^ 2)

/-- The numerator of `xκq`. -/
noncomputable def xκqN (M c : ℝ) : ℝ :=
  4 * M ^ 6 * c + 6 * M ^ 6 + 5 * M ^ 5 * c - 12 * M ^ 5 - 12 * M ^ 4 * c ^ 3 -
    14 * M ^ 4 * c ^ 2 - 10 * M ^ 4 * c + 6 * M ^ 4 - 8 * M ^ 3 * c ^ 3 + 20 * M ^ 3 * c ^ 2 +
    5 * M ^ 3 * c + 8 * M ^ 2 * c ^ 5 + 10 * M ^ 2 * c ^ 4 + 6 * M ^ 2 * c ^ 3 - M ^ 2 * c ^ 2 +
    M * c ^ 5 - 4 * M * c ^ 4 + 2 * M * c ^ 3

/-- The coefficient of `log (b + d)` in the `z_A`-antiderivative, `d = q`. -/
noncomputable def xκq (M c : ℝ) : ℝ :=
  xκqN M c / (12 * c ^ 4 * (-M + c) * (M + c) ^ 2)

theorem gPsi1_hier (A M c a : ℝ) :
    gPsi1 A (M / 2) M c a (1 - M - c) = crossedP1h M c (A + M * (1 - M - c)) (a + M * c) := by
  simp only [gPsi1, psiT1h, gXan, gXbn, gXU, Matrix.cons_val, crossedP1h_0, crossedP1h_1,
    crossedP1h_2, crossedP1h_3, crossedP1h]
  ring

theorem gPsi2_hier (A M c a : ℝ) :
    gPsi2 A (M / 2) M c a (1 - M - c) = crossedP2h M c (A + M * (1 - M - c)) (a + M * c) := by
  simp only [gPsi2, psiT2h, gXan, gXbn, gXU, Matrix.cons_val, crossedP2h_0, crossedP2h_1,
    crossedP2h_2, crossedP2h]
  ring

theorem gXEn_hier (A M c a : ℝ) :
    gXEn A M c a (1 - M - c) = (M + c) ^ 2 * ((A + M * (1 - M - c)) + (a + M * c)) +
      (A + M * (1 - M - c)) ^ 2 := by
  unfold gXEn; ring

/-- **The massless integrand in the hierarchical variables.** -/
theorem crossedTerm_zero_hier {A M c a : ℝ} (hA : 0 < A) (hM : 0 < M) (hc : 0 < c) (ha : 0 < a)
    (hb : 0 < 1 - M - c) :
    crossedTerm 0 0 A M c a (1 - M - c) =
      M * (crossedP1h M c (A + M * (1 - M - c)) (a + M * c) -
          crossedP2h M c (A + M * (1 - M - c)) (a + M * c) *
            ((M + c) ^ 2 * ((A + M * (1 - M - c)) + (a + M * c)) + (A + M * (1 - M - c)) ^ 2)) /
        (2 * ((A + M * (1 - M - c)) + (a + M * c)) ^ 4 *
          ((M + c) ^ 2 * ((A + M * (1 - M - c)) + (a + M * c)) +
            (A + M * (1 - M - c)) ^ 2) ^ 2) := by
  have hU := gXU_pos hA hM hc ha hb
  have hEn : 0 < gXEn A M c a (1 - M - c) := by unfold gXEn; positivity
  unfold crossedTerm gXE
  rw [gPsi1_hier, gPsi2_hier, ← gXEn_hier, ← gXU_frame]
  field_simp
  ring

/-- **The partial fractions in `U`.** -/
theorem crossedPF {M c B U : ℝ} (hB : 0 < B) (hU : 0 < U) (hY : 0 < M + c) :
    M * (crossedP1h M c B (U - B) - crossedP2h M c B (U - B) * ((M + c) ^ 2 * U + B ^ 2)) /
        (2 * U ^ 4 * ((M + c) ^ 2 * U + B ^ 2) ^ 2) =
      outerPF (M + c) B (xα₁ M c B) (xα₂ M c B) (xα₃ M c B) (xα₄ M c B) (xβ₂ M c B) U := by
  have hE : 0 < (M + c) ^ 2 * U + B ^ 2 := by positivity
  simp only [outerPF, xα₁N_0, xα₁N_1, xα₁N_2, xα₁N, xα₁, xα₂N_0, xα₂N_1, xα₂N, xα₂, xα₃N, xα₃,
    xα₄N, xα₄, xβ₂N_0, xβ₂N_1, xβ₂N_2, xβ₂N_3, xβ₂N_4, xβ₂N_5, xβ₂N, xβ₂, crossedP1h_0,
    crossedP1h_1, crossedP1h_2, crossedP1h_3, crossedP1h, crossedP2h_0, crossedP2h_1, crossedP2h_2,
    crossedP2h]
  field_simp
  ring

/-- `α₁ = -∑_{k=2}^{5} r_k/b^k`. -/
theorem xα₁_eq {M c B : ℝ} (hB : B ≠ 0) :
    xα₁ M c B = -(xr₂ M c / B ^ 2 + xr₃ M c / B ^ 3 + xr₄ M c / B ^ 4 + xr₅ M c / B ^ 5) := by
  simp only [xα₁N_0, xα₁N_1, xα₁N_2, xα₁N, xα₁, xr₂N, xr₂, xr₃N, xr₃, xr₄N, xr₄, xr₅N_0, xr₅N_1,
    xr₅N, xr₅]
  field_simp
  ring

/-- `κ_e + κ_p + κ_q = 0`. -/
theorem xκ_sum {M c : ℝ} (hM : 0 < M) (hc : 0 < c) (hMc : M ≠ c) :
    xκe M c + xκp M c + xκq M c = 0 := by
  have h1 : -M + c ≠ 0 := by intro h; apply hMc; linarith
  have h2 : M - c ≠ 0 := sub_ne_zero.mpr hMc
  simp only [xκeN, xκe, xκpN, xκp, xκqN, xκq]
  field_simp
  ring

/-- **The rational part of the derivative of the `z_A`-antiderivative**:
`Q' + S L' + ∑ κ_d/(b + d) = α₂/(b+e) + α₃/(2(b+e)²) + α₄/(3(b+e)³) + β₂/(Y²(b+p)(b+q))`, with
`Q = -c₂₀/b - c₃₀/(2b²) - c₂ₑ/(b+e) - c₃ₑ/(2(b+e)²)`, `S = ∑ -r_k/((k-1) b^{k-1})` and
`L' = 1/(b+e) - 1/(b+p) - 1/(b+q)`. -/
theorem crossedKRat {M c B : ℝ} (hM : 0 < M) (hc : 0 < c) (hMc : M ≠ c) (hB : 0 < B) :
    (xc₂₀ M c / B ^ 2 + xc₃₀ M c / B ^ 3 + xc₂ₑ M c / (B + M * c) ^ 2 +
        xc₃ₑ M c / (B + M * c) ^ 3) +
      (-(xr₂ M c / B) - xr₃ M c / (2 * B ^ 2) - xr₄ M c / (3 * B ^ 3) - xr₅ M c / (4 * B ^ 4)) *
        (1 / (B + M * c) - 1 / (B + (M + c) * M) - 1 / (B + (M + c) * c)) +
      (xκe M c / (B + M * c) + xκp M c / (B + (M + c) * M) + xκq M c / (B + (M + c) * c)) =
    xα₂ M c B / (B + M * c) + xα₃ M c B / (2 * (B + M * c) ^ 2) +
      xα₄ M c B / (3 * (B + M * c) ^ 3) +
      xβ₂ M c B / ((M + c) ^ 2 * ((B + (M + c) * M) * (B + (M + c) * c))) := by
  have h1 : -M + c ≠ 0 := by intro h; apply hMc; linarith
  have h2 : M - c ≠ 0 := sub_ne_zero.mpr hMc
  have h3 : 0 < B + M * c := by positivity
  have h4 : 0 < B + (M + c) * M := by positivity
  have h5 : 0 < B + (M + c) * c := by positivity
  simp only [xα₂N_0, xα₂N_1, xα₂N, xα₂, xα₃N, xα₃, xα₄N, xα₄, xβ₂N_0, xβ₂N_1, xβ₂N_2, xβ₂N_3,
    xβ₂N_4, xβ₂N_5, xβ₂N, xβ₂, xr₂N, xr₂, xr₃N, xr₃, xr₄N, xr₄, xr₅N_0, xr₅N_1, xr₅N, xr₅, xc₂₀N,
    xc₂₀, xc₃₀N, xc₃₀, xc₂ₑN, xc₂ₑ, xc₃ₑN, xc₃ₑ, xκeN, xκe, xκpN, xκp, xκqN, xκq]
  field_simp
  ring

end QED.TwoLoop.UnitXClose

