/-- Part 0 of `crossedP1h`. -/
noncomputable def crossedP1h_0 (M c B W : ℝ) : ℝ :=
  -(1 / 2) * M ^ 5 * B * W ^ 2 - (1 / 2) * M ^ 5 * W ^ 3 - M ^ 4 * c * B ^ 2 * W -
    3 * M ^ 4 * c * B * W ^ 2 - 2 * M ^ 4 * c * W ^ 3 + M ^ 4 * B * W ^ 2 + M ^ 4 * W ^ 3 -
    (1 / 2) * M ^ 3 * c ^ 2 * B ^ 3 - (7 / 2) * M ^ 3 * c ^ 2 * B ^ 2 * W -
    (11 / 2) * M ^ 3 * c ^ 2 * B * W ^ 2 - (5 / 2) * M ^ 3 * c ^ 2 * W ^ 3 +
    M ^ 3 * c * B ^ 2 * W + 3 * M ^ 3 * c * B * W ^ 2 + 2 * M ^ 3 * c * W ^ 3 +
    (1 / 2) * M ^ 3 * B ^ 3 - (1 / 2) * M ^ 3 * B ^ 2 * W ^ 2 + (3 / 2) * M ^ 3 * B ^ 2 * W +
    (3 / 2) * M ^ 3 * B * W ^ 2 - (3 / 2) * M ^ 3 * W ^ 4 + (1 / 2) * M ^ 3 * W ^ 3 -
    M ^ 2 * c ^ 3 * B ^ 3 - 3 * M ^ 2 * c ^ 3 * B ^ 2 * W - 3 * M ^ 2 * c ^ 3 * B * W ^ 2 -
    M ^ 2 * c ^ 3 * W ^ 3

/-- Part 1 of `crossedP1h`. -/
noncomputable def crossedP1h_1 (M c B W : ℝ) : ℝ :=
  -M ^ 2 * c * B ^ 3 * W + M ^ 2 * c * B ^ 3 - M ^ 2 * c * B ^ 2 * W ^ 2 +
    4 * M ^ 2 * c * B ^ 2 * W - 5 * M ^ 2 * c * B * W ^ 3 + 6 * M ^ 2 * c * B * W ^ 2 -
    5 * M ^ 2 * c * W ^ 4 + 3 * M ^ 2 * c * W ^ 3 - 2 * M ^ 2 * B ^ 2 * W ^ 2 -
    3 * M ^ 2 * B * W ^ 3 - M ^ 2 * B * W ^ 2 + 3 * M ^ 2 * W ^ 4 - M ^ 2 * W ^ 3 -
    M * c ^ 3 * B ^ 3 - 3 * M * c ^ 3 * B ^ 2 * W - 3 * M * c ^ 3 * B * W ^ 2 -
    M * c ^ 3 * W ^ 3 - (1 / 2) * M * c ^ 2 * B ^ 4 - M * c ^ 2 * B ^ 3 * W +
    (1 / 2) * M * c ^ 2 * B ^ 3 - 6 * M * c ^ 2 * B ^ 2 * W ^ 2 +
    (7 / 2) * M * c ^ 2 * B ^ 2 * W - 11 * M * c ^ 2 * B * W ^ 3 +
    (11 / 2) * M * c ^ 2 * B * W ^ 2

/-- Part 2 of `crossedP1h`. -/
noncomputable def crossedP1h_2 (M c B W : ℝ) : ℝ :=
  -(11 / 2) * M * c ^ 2 * W ^ 4 + (5 / 2) * M * c ^ 2 * W ^ 3 - 5 * M * c * B ^ 3 * W +
    M * c * B ^ 3 - 11 * M * c * B ^ 2 * W ^ 2 + 2 * M * c * B ^ 2 * W + M * c * B * W ^ 3 +
    7 * M * c * W ^ 4 - M * c * W ^ 3 + (1 / 2) * M * B ^ 4 + 2 * M * B ^ 3 * W -
    (1 / 2) * M * B ^ 3 + (13 / 2) * M * B ^ 2 * W ^ 2 - (3 / 2) * M * B ^ 2 * W +
    5 * M * B * W ^ 3 - M * B * W ^ 2 - 2 * M * W ^ 4 - 2 * c ^ 3 * B ^ 3 * W -
    6 * c ^ 3 * B ^ 2 * W ^ 2 - 6 * c ^ 3 * B * W ^ 3 - 2 * c ^ 3 * W ^ 4 - 3 * c ^ 2 * B ^ 4 -
    9 * c ^ 2 * B ^ 3 * W - 5 * c ^ 2 * B ^ 2 * W ^ 2

/-- Part 3 of `crossedP1h`. -/
noncomputable def crossedP1h_3 (_M c B W : ℝ) : ℝ :=
  5 * c ^ 2 * B * W ^ 3 + 4 * c ^ 2 * W ^ 4 + c * B ^ 4 + 8 * c * B ^ 3 * W +
    13 * c * B ^ 2 * W ^ 2 + 4 * c * B * W ^ 3 - 2 * c * W ^ 4 - 2 * B ^ 2 * W ^ 2 -
    2 * B * W ^ 3

/-- `Ψ₁(z_M/2)` in the hierarchical variables `b = z_A + z₂ z_b`, `w = z_a + z₂ z₃`. -/
noncomputable def crossedP1h (M c B W : ℝ) : ℝ :=
  crossedP1h_0 M c B W +
    crossedP1h_1 M c B W +
    crossedP1h_2 M c B W +
    crossedP1h_3 M c B W

