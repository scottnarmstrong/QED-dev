/-!
# The corner `ξ`-antiderivative near `ξ = 0` and `ξ = 1`

As for `QED.TwoLoop.UnitXXiEnds`: `cxiF` in two endpoint forms with coefficients regular at the
endpoint (`cxiF_eq_zero_form`, `cxiF_eq_one_form`), with the Taylor remainders
`QED.TwoLoop.UnitXXi.lr2`, `lr3`; the coefficients were generated by
`scripts/numerics/sc_graph/corner_integration.py`, the identities checked by `field_simp` and
`ring`.
-/

@[expose] public section

open Real Set QED.Polylog

namespace QED.TwoLoop.UnitSCCornerXi

open QED.TwoLoop.UnitXClose QED.TwoLoop.UnitXXi QED.TwoLoop.UnitSCCorner

/-- The dilogarithm terms of `cxiF`. -/
noncomputable def cxiDil (Y ξ : ℝ) : ℝ :=
  cxiCL Y * Li₂ (Y * ξ) +
    cxiCq Y * (Li₂ (1 - ξ) + dilogI (-(Y * (1 - ξ) / (1 - Y))) -
      dilogI ((1 - 2 * Y) * (1 - ξ) / (1 - Y))) +
    (Li₂ ((1 - 2 * Y) * (1 - 2 * ξ)) - Li₂ (1 - 2 * ξ)) / (2 * Y ^ 2) +
    cxiCD Y * dilogI ((2 * Y - 1) * ξ / Y)

/-- The rational part of `cxiF` at `ξ → 0⁺`. -/
noncomputable def cxiU0 (Y ξ : ℝ) : ℝ :=
  ((3 * Y ^ 7 * ξ ^ 6 - 14 * Y ^ 7 * ξ ^ 5 + 18 * Y ^ 7 * ξ ^ 4 - 7 * Y ^ 7 * ξ ^ 3 + 7 * Y ^ 6 *
      ξ ^ 5 - 7 * Y ^ 6 * ξ ^ 4 + 3 * Y ^ 6 * ξ ^ 3 - Y ^ 6 * ξ ^ 2 + 52 * Y ^ 5 * ξ ^ 5 - 84 *
      Y ^ 5 * ξ ^ 4 + 3 * Y ^ 5 * ξ ^ 3 + 60 * Y ^ 5 * ξ ^ 2 - 39 * Y ^ 5 * ξ + 8 * Y ^ 5 - 116 *
      Y ^ 4 * ξ ^ 5 + 152 * Y ^ 4 * ξ ^ 4 - 39 * Y ^ 4 * ξ ^ 3 - 65 * Y ^ 4 * ξ ^ 2 + 64 * Y ^ 4 *
      ξ - 18 * Y ^ 4 + 110 * Y ^ 3 * ξ ^ 5 - 103 * Y ^ 3 * ξ ^ 4 + 36 * Y ^ 3 * ξ ^ 3 + 8 * Y ^ 3 *
      ξ ^ 2 + Y ^ 3 * ξ - 4 * Y ^ 3 - 76 * Y ^ 2 * ξ ^ 5 + 78 * Y ^ 2 * ξ ^ 4 - 20 * Y ^ 2 * ξ ^ 3 -
      36 * Y ^ 2 * ξ ^ 2 + 12 * Y ^ 2 * ξ + 31 * Y * ξ ^ 5 - 44 * Y * ξ ^ 4 + 23 * Y * ξ ^ 3 + 6 *
      Y * ξ ^ 2 - 5 * ξ ^ 5 + 9 * ξ ^ 4 - 6 * ξ ^ 3) / (24 * Y ^ 4 * (ξ - 1) ^ 3))

/-- The coefficient of `log Y` in `cxiF` at `ξ → 0⁺`. -/
noncomputable def cxiW0 (Y ξ : ℝ) : ℝ :=
  ((-3 * Y ^ 5 * ξ ^ 4 - 3 * Y ^ 5 * ξ ^ 3 + 21 * Y ^ 5 * ξ ^ 2 - 22 * Y ^ 5 * ξ + 7 * Y ^ 5 + 6 *
      Y ^ 4 * ξ ^ 4 + 26 * Y ^ 4 * ξ ^ 3 - 78 * Y ^ 4 * ξ ^ 2 + 68 * Y ^ 4 * ξ - 20 * Y ^ 4 - 3 *
      Y ^ 3 * ξ ^ 4 - 44 * Y ^ 3 * ξ ^ 3 + 81 * Y ^ 3 * ξ ^ 2 - 57 * Y ^ 3 * ξ + 15 * Y ^ 3 + 39 *
      Y ^ 2 * ξ ^ 3 - 57 * Y ^ 2 * ξ ^ 2 + 40 * Y ^ 2 * ξ - 10 * Y ^ 2 - 21 * Y * ξ ^ 3 + 36 * Y *
      ξ ^ 2 - 29 * Y * ξ + 6 * Y + 5 * ξ ^ 3 - 9 * ξ ^ 2 + 6 * ξ) / (12 * Y ^ 2 * (Y - 1) ^ 2 * (ξ -
      1) ^ 3))

/-- The coefficient of `ξ log ξ` in `cxiF` at `ξ → 0⁺`. -/
noncomputable def cxiV0 (Y ξ : ℝ) : ℝ :=
  ((-3 * Y ^ 3 * ξ ^ 3 + 14 * Y ^ 3 * ξ ^ 2 - 18 * Y ^ 3 * ξ + 7 * Y ^ 3 - 14 * Y ^ 2 * ξ ^ 2 + 18 *
      Y ^ 2 * ξ - 6 * Y ^ 2 + 5 * Y * ξ ^ 2 - Y - 5 * ξ ^ 2 + 9 * ξ - 6) / (12 * Y ^ 2 * (ξ -
      1) ^ 3))

/-- The coefficient of `lr2 (Y ξ)/ξ²` in `cxiF` at `ξ → 0⁺`. -/
noncomputable def cxiA0 (Y ξ : ℝ) : ℝ :=
  ((-3 * Y ^ 5 * ξ ^ 6 + 14 * Y ^ 5 * ξ ^ 5 - 18 * Y ^ 5 * ξ ^ 4 + 7 * Y ^ 5 * ξ ^ 3 + 6 * Y ^ 4 *
      ξ ^ 6 - 29 * Y ^ 4 * ξ ^ 5 + 15 * Y ^ 4 * ξ ^ 4 + 19 * Y ^ 4 * ξ ^ 3 - 13 * Y ^ 4 * ξ ^ 2 -
      3 * Y ^ 3 * ξ ^ 6 + 12 * Y ^ 3 * ξ ^ 5 + 51 * Y ^ 3 * ξ ^ 4 - 87 * Y ^ 3 * ξ ^ 3 + 35 *
      Y ^ 3 * ξ ^ 2 - 5 * Y ^ 2 * ξ ^ 5 - 35 * Y ^ 2 * ξ ^ 4 + 26 * Y ^ 2 * ξ ^ 3 + 24 * Y ^ 2 *
      ξ ^ 2 - 28 * Y ^ 2 * ξ + 6 * Y ^ 2 + 6 * Y * ξ ^ 5 + 2 * Y * ξ ^ 4 + 13 * Y * ξ ^ 3 - 36 * Y *
      ξ ^ 2 + 31 * Y * ξ - 8 * Y - 6 * ξ ^ 4 + 6 * ξ ^ 3 + 4 * ξ ^ 2 - 9 * ξ + 3) / (12 * Y ^ 2 *
      (Y - 1) ^ 2 * (ξ - 1) ^ 3))

/-- The coefficient of `lr2 ((2Y - 1) ξ/Y)/ξ²` in `cxiF` at `ξ → 0⁺`. -/
noncomputable def cxiB0 (Y ξ : ℝ) : ℝ :=
  ((-12 * Y ^ 5 * ξ ^ 5 + 32 * Y ^ 5 * ξ ^ 4 - 31 * Y ^ 5 * ξ ^ 3 + 13 * Y ^ 5 * ξ ^ 2 - 2 * Y ^ 5 *
      ξ + 44 * Y ^ 4 * ξ ^ 5 - 104 * Y ^ 4 * ξ ^ 4 + 99 * Y ^ 4 * ξ ^ 3 - 47 * Y ^ 4 * ξ ^ 2 + 11 *
      Y ^ 4 * ξ - Y ^ 4 - 53 * Y ^ 3 * ξ ^ 5 + 93 * Y ^ 3 * ξ ^ 4 - 69 * Y ^ 3 * ξ ^ 3 + 24 *
      Y ^ 3 * ξ ^ 2 - 3 * Y ^ 3 * ξ + 39 * Y ^ 2 * ξ ^ 5 - 57 * Y ^ 2 * ξ ^ 4 + 40 * Y ^ 2 * ξ ^ 3 -
      10 * Y ^ 2 * ξ ^ 2 - 21 * Y * ξ ^ 5 + 36 * Y * ξ ^ 4 - 29 * Y * ξ ^ 3 + 6 * Y * ξ ^ 2 + 5 *
      ξ ^ 5 - 9 * ξ ^ 4 + 6 * ξ ^ 3) / (12 * Y ^ 2 * (Y - 1) ^ 2 * (ξ - 1) ^ 3))

/-- The rational part of `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiU1 (Y ξ : ℝ) : ℝ :=
  ((-12 * Y ^ 6 * ξ ^ 6 - 118 * Y ^ 6 * ξ ^ 5 + 482 * Y ^ 6 * ξ ^ 4 - 651 * Y ^ 6 * ξ ^ 3 + 448 *
      Y ^ 6 * ξ ^ 2 - 80 * Y ^ 6 * ξ + 30 * Y ^ 5 * ξ ^ 6 + 576 * Y ^ 5 * ξ ^ 5 - 2049 * Y ^ 5 *
      ξ ^ 4 + 2770 * Y ^ 5 * ξ ^ 3 - 2085 * Y ^ 5 * ξ ^ 2 + 492 * Y ^ 5 * ξ - 40 * Y ^ 5 - 36 *
      Y ^ 4 * ξ ^ 6 - 901 * Y ^ 4 * ξ ^ 5 + 2814 * Y ^ 4 * ξ ^ 4 - 3623 * Y ^ 4 * ξ ^ 3 + 2812 *
      Y ^ 4 * ξ ^ 2 - 582 * Y ^ 4 * ξ + 38 * Y ^ 4 + 24 * Y ^ 3 * ξ ^ 6 + 818 * Y ^ 3 * ξ ^ 5 -
      2276 * Y ^ 3 * ξ ^ 4 + 2734 * Y ^ 3 * ξ ^ 3 - 1925 * Y ^ 3 * ξ ^ 2 + 164 * Y ^ 3 * ξ + 53 *
      Y ^ 3 - 6 * Y ^ 2 * ξ ^ 6 - 551 * Y ^ 2 * ξ ^ 5 + 1530 * Y ^ 2 * ξ ^ 4 - 1842 * Y ^ 2 *
      ξ ^ 3 + 1016 * Y ^ 2 * ξ ^ 2 + 84 * Y ^ 2 * ξ - 114 * Y ^ 2 + 230 * Y * ξ ^ 5 - 693 * Y *
      ξ ^ 4 + 906 * Y * ξ ^ 3 - 458 * Y * ξ ^ 2 - 42 * Y * ξ + 75 * Y - 42 * ξ ^ 5 + 138 * ξ ^ 4 -
      198 * ξ ^ 3 + 108 * ξ ^ 2 - 18) / (72 * Y * ξ ^ 2 * (Y - 1) ^ 4))

/-- The coefficient of `log Y` in `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiW1Y (Y ξ : ℝ) : ℝ :=
  ((-3 * Y ^ 3 * ξ ^ 3 - 2 * Y ^ 3 * ξ + 6 * Y ^ 2 * ξ ^ 3 + 8 * Y ^ 2 * ξ - Y ^ 2 - 3 * Y * ξ ^ 3 -
      3 * Y * ξ) / (12 * ξ ^ 2 * (Y - 1) ^ 2))

/-- The coefficient of `log (1 - Y)` in `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiW1 (Y ξ : ℝ) : ℝ :=
  ((-3 * Y ^ 3 * ξ ^ 3 - 7 * Y ^ 3 * ξ ^ 2 + 2 * Y ^ 3 * ξ + 19 * Y ^ 2 * ξ ^ 2 - 4 * Y ^ 2 * ξ +
      Y ^ 2 - 5 * Y * ξ ^ 2 - 7 * Y * ξ + 2 * Y + 5 * ξ ^ 2 - 3) / (12 * Y ^ 2 * ξ ^ 2))

/-- The coefficient of `lr3 (1 - ξ)/(1 - ξ)³` in `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiX1 (Y ξ : ℝ) : ℝ :=
  ((3 * Y ^ 3 * ξ ^ 4 - 14 * Y ^ 3 * ξ ^ 3 + 18 * Y ^ 3 * ξ ^ 2 - 7 * Y ^ 3 * ξ + 14 * Y ^ 2 *
      ξ ^ 3 - 18 * Y ^ 2 * ξ ^ 2 + 6 * Y ^ 2 * ξ - 5 * Y * ξ ^ 3 + Y * ξ + 5 * ξ ^ 3 - 9 * ξ ^ 2 +
      6 * ξ) / (12 * Y ^ 2))

/-- The coefficient of `lr3 (-Y (1 - ξ)/(1 - Y))/(1 - ξ)³` in `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiA1 (Y ξ : ℝ) : ℝ :=
  ((3 * Y ^ 5 * ξ ^ 6 - 14 * Y ^ 5 * ξ ^ 5 + 18 * Y ^ 5 * ξ ^ 4 - 7 * Y ^ 5 * ξ ^ 3 - 6 * Y ^ 4 *
      ξ ^ 6 + 29 * Y ^ 4 * ξ ^ 5 - 15 * Y ^ 4 * ξ ^ 4 - 19 * Y ^ 4 * ξ ^ 3 + 13 * Y ^ 4 * ξ ^ 2 +
      3 * Y ^ 3 * ξ ^ 6 - 12 * Y ^ 3 * ξ ^ 5 - 51 * Y ^ 3 * ξ ^ 4 + 87 * Y ^ 3 * ξ ^ 3 - 35 *
      Y ^ 3 * ξ ^ 2 + 5 * Y ^ 2 * ξ ^ 5 + 35 * Y ^ 2 * ξ ^ 4 - 26 * Y ^ 2 * ξ ^ 3 - 24 * Y ^ 2 *
      ξ ^ 2 + 28 * Y ^ 2 * ξ - 6 * Y ^ 2 - 6 * Y * ξ ^ 5 - 2 * Y * ξ ^ 4 - 13 * Y * ξ ^ 3 + 36 * Y *
      ξ ^ 2 - 31 * Y * ξ + 8 * Y + 6 * ξ ^ 4 - 6 * ξ ^ 3 - 4 * ξ ^ 2 + 9 * ξ - 3) / (12 * Y ^ 2 *
      ξ ^ 2 * (Y - 1) ^ 2))

/-- The coefficient of `lr3 ((1 - 2Y)(1 - ξ)/(1 - Y))/(1 - ξ)³` in `cxiF` at `ξ → 1⁻`. -/
noncomputable def cxiB1 (Y ξ : ℝ) : ℝ :=
  ((12 * Y ^ 5 * ξ ^ 5 - 32 * Y ^ 5 * ξ ^ 4 + 31 * Y ^ 5 * ξ ^ 3 - 13 * Y ^ 5 * ξ ^ 2 + 2 * Y ^ 5 *
      ξ - 44 * Y ^ 4 * ξ ^ 5 + 104 * Y ^ 4 * ξ ^ 4 - 99 * Y ^ 4 * ξ ^ 3 + 47 * Y ^ 4 * ξ ^ 2 - 11 *
      Y ^ 4 * ξ + Y ^ 4 + 53 * Y ^ 3 * ξ ^ 5 - 93 * Y ^ 3 * ξ ^ 4 + 69 * Y ^ 3 * ξ ^ 3 - 24 *
      Y ^ 3 * ξ ^ 2 + 3 * Y ^ 3 * ξ - 39 * Y ^ 2 * ξ ^ 5 + 57 * Y ^ 2 * ξ ^ 4 - 40 * Y ^ 2 * ξ ^ 3 +
      10 * Y ^ 2 * ξ ^ 2 + 21 * Y * ξ ^ 5 - 36 * Y * ξ ^ 4 + 29 * Y * ξ ^ 3 - 6 * Y * ξ ^ 2 - 5 *
      ξ ^ 5 + 9 * ξ ^ 4 - 6 * ξ ^ 3) / (12 * Y ^ 2 * ξ ^ 2 * (Y - 1) ^ 2))

/-! ### The identities, one logarithm at a time -/

section Identities

variable {Y ξ : ℝ} (hY : Y ∈ Ioo (0 : ℝ) 1) (hY2 : Y ≠ 1 / 2) (hξ : ξ ∈ Ioo (0 : ℝ) 1)
include hY hY2 hξ

theorem cxiR0_zero_form :
    cxiR0 Y ξ = cxiU0 Y ξ + cxiA0 Y ξ * (Y * ξ + (Y * ξ) ^ 2 / 2) / ξ ^ 2 +
      cxiB0 Y ξ * ((2 * Y - 1) / Y * ξ + ((2 * Y - 1) / Y * ξ) ^ 2 / 2) / ξ ^ 2 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiR0_eq]
  unfold cxiU0 cxiA0 cxiB0
  field_simp
  ring

theorem cxiPx_zero_form : cxiPx Y ξ = cxiV0 Y ξ * ξ := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPx_eq]
  unfold cxiV0
  field_simp

theorem cxiPA_zero_form : cxiPA Y ξ = cxiA0 Y ξ / ξ ^ 2 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPA_eq]
  unfold cxiA0
  field_simp

theorem cxiPB_zero_form : cxiPB Y ξ = cxiB0 Y ξ / ξ ^ 2 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPB_eq]
  unfold cxiB0
  field_simp

theorem cxiPBY_zero_form : cxiPB Y ξ + cxiPY Y ξ = cxiW0 Y ξ := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPB_eq, cxiPY_eq]
  unfold cxiW0
  field_simp
  ring

theorem cxiR0_one_form :
    cxiR0 Y ξ = cxiU1 Y ξ + cxiX1 Y ξ * ((1 - ξ) + (1 - ξ) ^ 2 / 2 + (1 - ξ) ^ 3 / 3) / (1 -
        ξ) ^ 3 +
      cxiA1 Y ξ * (-(Y / (1 - Y)) * (1 - ξ) + (-(Y / (1 - Y)) * (1 - ξ)) ^ 2 / 2 +
        (-(Y / (1 - Y)) * (1 - ξ)) ^ 3 / 3) / (1 - ξ) ^ 3 +
      cxiB1 Y ξ * ((1 - 2 * Y) / (1 - Y) * (1 - ξ) + ((1 - 2 * Y) / (1 - Y) * (1 - ξ)) ^ 2 / 2 +
        ((1 - 2 * Y) / (1 - Y) * (1 - ξ)) ^ 3 / 3) / (1 - ξ) ^ 3 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiR0_eq]
  unfold cxiU1 cxiX1 cxiA1 cxiB1
  field_simp
  ring

theorem cxiPx_one_form : cxiPx Y ξ = cxiX1 Y ξ / (1 - ξ) ^ 3 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPx_eq]
  unfold cxiX1
  field_simp
  ring

theorem cxiPA_one_form : cxiPA Y ξ = cxiA1 Y ξ / (1 - ξ) ^ 3 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPA_eq]
  unfold cxiA1
  field_simp
  ring

theorem cxiPB_one_form : cxiPB Y ξ = cxiB1 Y ξ / (1 - ξ) ^ 3 := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPB_eq]
  unfold cxiB1
  field_simp
  ring

theorem cxiPY_one_form : cxiPY Y ξ = cxiW1Y Y ξ := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPY_eq]
  unfold cxiW1Y
  field_simp

theorem cxiPAB_one_form : cxiPA Y ξ + cxiPB Y ξ = cxiW1 Y ξ := by
  obtain ⟨h0, h1, h1', h2, h2', h2'', h2''', hx0, hx1, hx1'⟩ := xi_ne_zero_facts hY hY2 hξ
  rw [cxiPA_eq, cxiPB_eq]
  unfold cxiW1
  field_simp
  ring

end Identities

/-! ### The endpoint forms -/

/-- **`cxiF` near `ξ = 0`.** -/
theorem cxiF_eq_zero_form {Y ξ : ℝ} (hY : Y ∈ Ioo (0 : ℝ) 1) (hY2 : Y ≠ 1 / 2)
    (hξ : ξ ∈ Ioo (0 : ℝ) 1) :
    cxiF Y ξ = cxiU0 Y ξ + cxiW0 Y ξ * log Y + cxiV0 Y ξ * (ξ * log ξ) +
      cxiA0 Y ξ * (lr2 (Y * ξ) / ξ ^ 2) + cxiB0 Y ξ * (lr2 ((2 * Y - 1) / Y * ξ) / ξ ^ 2) +
      cxiDil Y ξ := by
  have a := cxiR0_zero_form hY hY2 hξ
  have b := cxiPx_zero_form hY hY2 hξ
  have c := cxiPA_zero_form hY hY2 hξ
  have d := cxiPB_zero_form hY hY2 hξ
  have e := cxiPBY_zero_form hY hY2 hξ
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hB : 0 < ξ + Y - 2 * Y * ξ := by nlinarith
  have e1 : 1 - (2 * Y - 1) / Y * ξ = (ξ + Y - 2 * Y * ξ) / Y := by
    field_simp
    ring
  have eB : log (ξ + Y - 2 * Y * ξ) = log Y + log (1 - (2 * Y - 1) / Y * ξ) := by
    rw [e1, log_div hB.ne' hY0.ne']
    ring
  unfold cxiF cxiDil lr2
  rw [eB]
  linear_combination a + log ξ * b + log (1 - Y * ξ) * c + log (1 - (2 * Y - 1) / Y * ξ) * d +
    log Y * e

/-- **`cxiF` near `ξ = 1`.** -/
theorem cxiF_eq_one_form {Y ξ : ℝ} (hY : Y ∈ Ioo (0 : ℝ) 1) (hY2 : Y ≠ 1 / 2)
    (hξ : ξ ∈ Ioo (0 : ℝ) 1) :
    cxiF Y ξ = cxiU1 Y ξ + cxiW1Y Y ξ * log Y + cxiW1 Y ξ * log (1 - Y) +
      cxiX1 Y ξ * (lr3 (1 - ξ) / (1 - ξ) ^ 3) +
      cxiA1 Y ξ * (lr3 (-(Y / (1 - Y)) * (1 - ξ)) / (1 - ξ) ^ 3) +
      cxiB1 Y ξ * (lr3 ((1 - 2 * Y) / (1 - Y) * (1 - ξ)) / (1 - ξ) ^ 3) + cxiDil Y ξ := by
  have a := cxiR0_one_form hY hY2 hξ
  have b := cxiPx_one_form hY hY2 hξ
  have c := cxiPA_one_form hY hY2 hξ
  have d := cxiPB_one_form hY hY2 hξ
  have e := cxiPY_one_form hY hY2 hξ
  have f := cxiPAB_one_form hY hY2 hξ
  obtain ⟨hY0, hY1⟩ := hY
  obtain ⟨hξ0, hξ1⟩ := hξ
  have hY1' : 0 < 1 - Y := by linarith
  have hA : 0 < 1 - Y * ξ := by nlinarith
  have hB : 0 < ξ + Y - 2 * Y * ξ := by nlinarith
  have e1 : 1 - -(Y / (1 - Y)) * (1 - ξ) = (1 - Y * ξ) / (1 - Y) := by
    field_simp
    ring
  have e2 : 1 - (1 - 2 * Y) / (1 - Y) * (1 - ξ) = (ξ + Y - 2 * Y * ξ) / (1 - Y) := by
    field_simp
    ring
  have eA : log (1 - Y * ξ) = log (1 - Y) + log (1 - -(Y / (1 - Y)) * (1 - ξ)) := by
    rw [e1, log_div hA.ne' hY1'.ne']
    ring
  have eB : log (ξ + Y - 2 * Y * ξ) =
      log (1 - Y) + log (1 - (1 - 2 * Y) / (1 - Y) * (1 - ξ)) := by
    rw [e2, log_div hB.ne' hY1'.ne']
    ring
  unfold cxiF cxiDil lr3
  rw [eA, eB, sub_sub_cancel]
  linear_combination a + log ξ * b + log (1 - -(Y / (1 - Y)) * (1 - ξ)) * c +
    log (1 - (1 - 2 * Y) / (1 - Y) * (1 - ξ)) * d + log Y * e + log (1 - Y) * f

end QED.TwoLoop.UnitSCCornerXi

end
