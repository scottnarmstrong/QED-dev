/-!
# Set (c), Stage K, closed forms: the simplified branch-2 coefficients

Helper level (no frozen statement). Step 4 of route D for `ρ_X` (scratch `stageK/STATUS.md`,
session 24+). The coefficient vector `formXk2 = Σ_T c_T • k_T` of the branch-2 partial fractions
simplifies to `formXkh` (generated by `stageK/fxf/m6.py`, `m9.py`; it agrees with the direct
partial fractions of the integrand in `u`, `q3.py`): **`formXk2_eq`**, for `X ≠ 0, 1, 2` and
`s ≠ 0, 1, 2`. The denominators of `formXkh` contain no factor `s - 1`.
-/

@[expose] public section

open Real Set Filter Topology MeasureTheory

namespace QED.ChainProof.SetCK

/-- Component 0 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh0 (X s : ℝ) : ℝ := (-(s - 1)*(5*X^2*s^5 - 29*X^2*s^4 + 49*X^2*s^3 -
    11*X^2*s^2 - 12*X^2*s - 8*X^2 + 6*X*s^6 - 37*X*s^5 + 76*X*s^4 - 48*X*s^3 - 14*X*s^2 + 8*X*s +
    8*X - 6*s^6 + 37*s^5 - 76*s^4 + 48*s^3 + 14*s^2 - 8*s - 8)) / (12*s^3*(X - 1)*(s - 2)^3)

/-- Component 1 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh1 (_X s : ℝ) : ℝ := ((s - 1)^2*(s^2 - 2*s - 1)) / (3*s^3*(s - 2)^2)

/-- Component 2 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh2 (X s : ℝ) : ℝ := ((X - 1)*(4*X^3*s^3 - 11*X^3*s^2 + 9*X^3 + 6*X^2*s^4 -
    20*X^2*s^3 + 23*X^2*s^2 - 16*X^2 - 12*X*s^4 + 32*X*s^3 - 24*X*s^2 + 8*X + 6*s^4 - 12*s^3 +
    6*s^2)) / (12*X*s^2*(X - 2))

/-- Component 3 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh3 (X s : ℝ) : ℝ := ((X - 1)^2*(X + 1)*(s - 1)*(s + 1)*(X*s - X - s +
    2)) / (12*s*(X - 2))

/-- Component 4 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh4 (X s : ℝ) : ℝ := (4*X^3*s^3 - 6*X^3*s^2 + X^3 - 8*X^2*s^3 + 7*X^2*s^2 +
    6*X*s^4 - 4*X*s^3 - 6*X*s^2 + 8*X - 6*s^4 + 12*s^3 - 6*s^2) / (12*X*s^2*(X - 2)*(X - 1))

/-- Component 5 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh5 (X s : ℝ) : ℝ := (-(2*X - 1)*(s - 1)*(s + 1)*(X + s - 2)) / (12*s*(X -
    2)*(X - 1))

/-- Component 6 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh6 (X s : ℝ) : ℝ := (-2*X^4*s^6 + 15*X^4*s^5 - 26*X^4*s^4 - 45*X^4*s^3 +
    152*X^4*s^2 - 112*X^4*s + 16*X^4 - 8*X^3*s^7 + 72*X^3*s^6 - 243*X^3*s^5 + 334*X^3*s^4 -
    10*X^3*s^3 - 432*X^3*s^2 + 360*X^3*s - 64*X^3 - 6*X^2*s^8 + 72*X^2*s^7 - 354*X^2*s^6 +
    895*X^2*s^5 - 1150*X^2*s^4 + 490*X^2*s^3 + 400*X^2*s^2 - 424*X^2*s + 64*X^2 + 12*X*s^8 -
    128*X*s^7 + 564*X*s^6 - 1304*X*s^5 + 1632*X*s^4 - 960*X*s^3 + 64*X*s^2 + 128*X*s - 6*s^8 +
    64*s^7 - 282*s^6 + 652*s^5 - 816*s^4 + 480*s^3 - 32*s^2 - 64*s) / (12*s^3*(X - 1)*(s - 2)^3)

/-- Component 7 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh7 (X s : ℝ) : ℝ := (X^2*(s - 1)*(X + s - 2)*(X*s - X - s + 2)*(2*X^2*s^4 -
    7*X^2*s^3 - 7*X^2*s^2 + 20*X^2*s - 4*X^2 + 4*X*s^5 - 23*X*s^4 + 40*X*s^3 - 10*X*s^2 - 24*X*s +
    8*X - 4*s^5 + 23*s^4 - 40*s^3 + 10*s^2 + 24*s - 8)) / (12*s^3*(X - 1)*(s - 2)^3)

/-- Component 8 of the simplified branch-2 coefficient vector. -/
noncomputable def formXkh8 (X s : ℝ) : ℝ := (-X^4*(s - 1)^2*(X + s - 2)^2*(s^2 - 2*s + 2)*(X*s - X
    - s + 2)^2) / (6*s^3*(X - 1)*(s - 2)^3)

/-- The non-vanishing hypotheses of the simplification. -/
def formXKhHyp (X s : ℝ) : Prop :=
  X ≠ 0 ∧ X - 1 ≠ 0 ∧ X - 2 ≠ 0 ∧ s ≠ 0 ∧ s - 1 ≠ 0 ∧ s - 2 ≠ 0

/-- **The simplified branch-2 coefficient vector.** -/
noncomputable def formXkh (X s : ℝ) : Fin 9 → ℝ :=
  ![formXkh0 X s, formXkh1 X s, formXkh2 X s, formXkh3 X s, formXkh4 X s, formXkh5 X s,
    formXkh6 X s, formXkh7 X s, formXkh8 X s]

theorem formXk2_apply0 {X s : ℝ} (h : formXKhHyp X s) :
    formXk2 X s 0 = formXkh0 X s := by
  obtain ⟨hX0, hX1, hX2, hs0, hs1, hs2⟩ := h
  simp only [formXk2, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  unfold formXc0m10 formXk0m10 formXc0p01 formXk0p01 formXc0p12 formXk0p12 formXc0p23 formXk0p23
    formXc1m20 formXk1m20 formXc1m11 formXk1m11 formXc1p02 formXk1p02 formXc1p13 formXk1p13
    formXc2m21 formXk2m21 formXc2m12 formXk2m12 formXc2p03 formXk2p03 formXc3m22 formXk3m22
    formXc3m13 formXk3m13 formXc4m23 formXk4m23
  simp only [Matrix.cons_val_zero]
  unfold formXkh0
  field_simp
  ring

