theorem formXk2_eq {X s : ℝ} (h : formXKhHyp X s) :
    formXk2 X s = formXkh X s := by
  funext i
  fin_cases i
  · exact formXk2_apply0 h
  · exact formXk2_apply1 h
  · exact formXk2_apply2 h
  · exact formXk2_apply3 h
  · exact formXk2_apply4 h
  · exact formXk2_apply5 h
  · exact formXk2_apply6 h
  · exact formXk2_apply7 h
  · exact formXk2_apply8 h

