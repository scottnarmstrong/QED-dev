/-- Denominator constant of the main rational part of `G₁`. -/
noncomputable def formXG1hRD (X : ℝ) : ℝ := 24 * (X - 1) * formXK X ^ 3

/-- The main rational part of `G₁`. -/
noncomputable def formXG1hR (X u : ℝ) : ℝ :=
  formXPol (formXG1hRN X) u / (formXG1hRD X * coordM X u ^ 2)

/-- The coefficient of `1/(1 - u)` in the rational part of `G₁`. -/
noncomputable def formXG1e1 (X : ℝ) : ℝ :=
  (-X ^ (5:ℕ) + 5 * X ^ (4:ℕ) - 16 * X ^ (3:ℕ) + 28 * X ^ (2:ℕ) - 24 * X + 8) /
    (24 * formXK X ^ 3)

/-- The coefficient of `1/P` in the rational part of `G₁`. -/
noncomputable def formXG1e2 (X : ℝ) : ℝ :=
  (X ^ (4:ℕ)) /
    (4 * (X - 1))

/-- The (rational) coefficient of `log M` in `G₁`. -/
noncomputable def formXG1m (X : ℝ) : ℝ :=
  (-4 * X ^ (12:ℕ) + 33 * X ^ (11:ℕ) - 132 * X ^ (10:ℕ) + 308 * X ^ (9:ℕ) - 397 * X ^ (8:ℕ) +
  54 * X ^ (7:ℕ) + 900 * X ^ (6:ℕ) - 2076 * X ^ (5:ℕ) + 2682 * X ^ (4:ℕ) - 2300 * X ^ (3:ℕ) +
  1318 * X ^ (2:ℕ) - 468 * X + 78) /
    (12 * (X - 1) ^ 2 * formXK X ^ 4)

/-- The rational part of `G₁`. -/
noncomputable def formXG1h (X u : ℝ) : ℝ :=
  formXG1hR X u + formXG1e1 X / (1 - u) + formXG1e2 X / (X ^ 2 + (1 - X) * u)

