variable {X u : ℝ}

theorem hasDerivAt_formXG1a_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hu : u ∈ Ioo 0 X) :
    HasDerivAt (fun z => formXG1a X z * log (1 - z))
      ((formXlc1 X u + formXkap X * (1 - X) / coordM X u) * log (1 - u) -
        formXG1a X u / (1 - u)) u := by
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hu0, hu1⟩ := hu
  have hM := (coordM_pos ⟨hX0, hX1⟩ hu0.le).ne'
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have h1u : 1 - u ≠ 0 := by linarith
  have hu1' : u - 1 ≠ 0 := by linarith
  have hXu : X - u ≠ 0 := by linarith
  have hB : X + u - X * u ≠ 0 := by nlinarith
  have hP : X ^ 2 + (1 - X) * u ≠ 0 := by nlinarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG1aD X) 2 0 (hasDerivAt_coordM X u) (hasDerivAt_id' u)
  have h := formX_hasDerivAt_polDiv (formXG1aN X) hD (by unfold formXG1aD; simp [*])
  have e : formXG1a X = fun z =>
      formXPol (formXG1aN X) z / (formXG1aD X * coordM X z ^ 2 * z ^ 0) := by
    funext z; unfold formXG1a; ring
  rw [← e] at h
  obtain ⟨F', hF', hid⟩ : ∃ F', HasDerivAt (formXG1a X) F' u ∧
      F' = formXlc1 X u + formXkap X * (1 - X) / coordM X u := by
    refine ⟨_, h, ?_⟩
    rw [formXlc1_eq ⟨hX0, hX1⟩ hu0.le]
    rw [formXG1a_pol, formXG1a_dpol]
    unfold formXG1aD formXkap
    field_simp
    unfold coordM formXK
    ring
  have hL := ((hasDerivAt_id' u).const_sub 1).log h1u
  refine (hF'.mul hL).congr_deriv ?_
  rw [hid]
  ring

theorem hasDerivAt_formXG1b_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hu : u ∈ Ioo 0 X) :
    HasDerivAt (fun z => formXG1b X z * ((X - z) * log (X - z)))
      ((-(formXlc1 X u + formXkap X * (1 - X) / coordM X u)) * log (X - u) - formXG1b X u) u := by
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hu0, hu1⟩ := hu
  have hM := (coordM_pos ⟨hX0, hX1⟩ hu0.le).ne'
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have h1u : 1 - u ≠ 0 := by linarith
  have hu1' : u - 1 ≠ 0 := by linarith
  have hXu : X - u ≠ 0 := by linarith
  have hB : X + u - X * u ≠ 0 := by nlinarith
  have hP : X ^ 2 + (1 - X) * u ≠ 0 := by nlinarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG1bD X) 2 0 (hasDerivAt_coordM X u) (hasDerivAt_id' u)
  have h := formX_hasDerivAt_polDiv (formXG1bN X) hD (by unfold formXG1bD; simp [*])
  have e : formXG1b X = fun z =>
      formXPol (formXG1bN X) z / (formXG1bD X * coordM X z ^ 2 * z ^ 0) := by
    funext z; unfold formXG1b; ring
  rw [← e] at h
  obtain ⟨F', hF', hid⟩ : ∃ F', HasDerivAt (formXG1b X) F' u ∧
      (X - u) * F' - formXG1b X u = -(formXlc1 X u + formXkap X * (1 - X) / coordM X u) := by
    refine ⟨_, h, ?_⟩
    rw [formXlc1_eq ⟨hX0, hX1⟩ hu0.le]
    unfold formXG1b
    rw [formXG1b_pol, formXG1b_dpol]
    unfold formXG1bD formXkap
    field_simp
    unfold coordM
    ring
  have hL : HasDerivAt (fun z => (X - z) * log (X - z)) (-log (X - u) - 1) u := by
    have h1 := (hasDerivAt_id' u).const_sub X
    refine (h1.mul (h1.log hXu)).congr_deriv ?_
    field_simp
    ring
  refine (hF'.mul hL).congr_deriv ?_
  linear_combination log (X - u) * hid

theorem hasDerivAt_formXG1c_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hu : u ∈ Ioo 0 X) :
    HasDerivAt (fun z => formXG1c X z * log (X + z - X * z))
      ((-(formXlc1 X u + formXkap X * (1 - X) / coordM X u)) * log (X + u - X * u) +
        (1 - X) * formXG1c X u / (X + u - X * u)) u := by
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hu0, hu1⟩ := hu
  have hM := (coordM_pos ⟨hX0, hX1⟩ hu0.le).ne'
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have h1u : 1 - u ≠ 0 := by linarith
  have hu1' : u - 1 ≠ 0 := by linarith
  have hXu : X - u ≠ 0 := by linarith
  have hB : X + u - X * u ≠ 0 := by nlinarith
  have hP : X ^ 2 + (1 - X) * u ≠ 0 := by nlinarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG1cD X) 2 0 (hasDerivAt_coordM X u) (hasDerivAt_id' u)
  have h := formX_hasDerivAt_polDiv (formXG1cN X) hD (by unfold formXG1cD; simp [*])
  have e : formXG1c X = fun z =>
      formXPol (formXG1cN X) z / (formXG1cD X * coordM X z ^ 2 * z ^ 0) := by
    funext z; unfold formXG1c; ring
  rw [← e] at h
  obtain ⟨F', hF', hid⟩ : ∃ F', HasDerivAt (formXG1c X) F' u ∧
      F' = -(formXlc1 X u + formXkap X * (1 - X) / coordM X u) := by
    refine ⟨_, h, ?_⟩
    rw [formXlc1_eq ⟨hX0, hX1⟩ hu0.le]
