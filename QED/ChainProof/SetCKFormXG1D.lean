  have hB' : HasDerivAt (fun z => X + z - X * z) (1 - X) u := by
    have h1 := ((hasDerivAt_id' u).const_add X).sub ((hasDerivAt_id' u).const_mul X)
    exact h1.congr_deriv (by ring)
  refine (hF'.mul (hB'.log hB)).congr_deriv ?_
  rw [hid]
  ring

theorem hasDerivAt_formXG1d_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hu : u ∈ Ioo 0 X) :
    HasDerivAt (fun z => formXG1d X z * log (X ^ 2 + (1 - X) * z))
      ((formXlc1 X u + formXkap X * (1 - X) / coordM X u) * log (X ^ 2 + (1 - X) * u) +
        (1 - X) * formXG1d X u / (X ^ 2 + (1 - X) * u)) u := by
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hu0, hu1⟩ := hu
  have hM := (coordM_pos ⟨hX0, hX1⟩ hu0.le).ne'
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have h1u : 1 - u ≠ 0 := by linarith
  have hu1' : u - 1 ≠ 0 := by linarith
  have hXu : X - u ≠ 0 := by linarith
  have hB : X + u - X * u ≠ 0 := by nlinarith
  have hP : X ^ 2 + (1 - X) * u ≠ 0 := by nlinarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG1dD X) 2 0 (hasDerivAt_coordM X u) (hasDerivAt_id' u)
  have h := formX_hasDerivAt_polDiv (formXG1dN X) hD (by unfold formXG1dD; simp [*])
  have e : formXG1d X = fun z =>
      formXPol (formXG1dN X) z / (formXG1dD X * coordM X z ^ 2 * z ^ 0) := by
    funext z; unfold formXG1d; ring
  rw [← e] at h
  obtain ⟨F', hF', hid⟩ : ∃ F', HasDerivAt (formXG1d X) F' u ∧
      F' = formXlc1 X u + formXkap X * (1 - X) / coordM X u := by
    refine ⟨_, h, ?_⟩
    rw [formXlc1_eq ⟨hX0, hX1⟩ hu0.le]
    rw [formXG1d_pol, formXG1d_dpol]
    unfold formXG1dD formXkap
    field_simp
    unfold coordM
    ring
  have hP' : HasDerivAt (fun z => X ^ 2 + (1 - X) * z) (1 - X) u := by
    have h1 := ((hasDerivAt_id' u).const_mul (1 - X)).const_add (X ^ 2)
    exact h1.congr_deriv (by ring)
  refine (hF'.mul (hP'.log hP)).congr_deriv ?_
  rw [hid]
  ring

end

end QED.ChainProof.SetCK

