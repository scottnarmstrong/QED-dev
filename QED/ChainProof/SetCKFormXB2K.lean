module

public import QED.ChainProof.SetCKFormXB2PF
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# Set (c), Stage K, closed forms: the branch-2 `u`-integral of `I(X)`

Helper level (no frozen statement). Step 4 of route D for `ρ_X` (scratch `stageK/STATUS.md`,
session 24+). Expanding `N_a, N_b, N_c` in monomials `y₃^a d^b` and substituting
`y₃ = ℓ t/(sD)`, `d = BC/(sD)`, the branch-2 integrand is a combination of the fourteen basis
functions `formXPhi` with coefficients `formXc…` depending on `(X, s)` only
(**`formXKin2_eq_phi`**, generated by `stageK/fxf/m7.py`). With the partial fractions of
`SetCKFormXB2PF` and linearity it is the single partial-fraction sum with coefficient vector
`formXk2 X s` (**`formXKin2_eq_pf`**), hence, for `1 - X < s < 1`,

**`integral_formXKin2`**: `∫_{(1-s, X)} formXKin2 X u s du = A(X) - A(1 - s)`,
`A = formXPFA (formXk2 X s) X s`.
-/

@[expose] public section

open Real Set Filter Topology MeasureTheory

namespace QED.ChainProof.SetCK

/-- The coefficient of `formXPhi` for `(0, -1, 0)`. -/
noncomputable def formXc0m10 (X s : ℝ) : ℝ := (1 - X) / 12 * (-(s - 1)*(6*s^4 - 11*s^3 + 5*s^2 +
    2)/s^2)

/-- The coefficient of `formXPhi` for `(0, 0, 1)`. -/
noncomputable def formXc0p01 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)*(2*s^2 - 2*s - 1)*(3*s^2 -
    14*s + 7)/s^3)

/-- The coefficient of `formXPhi` for `(0, 1, 2)`. -/
noncomputable def formXc0p12 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)*(12*s^3 - 31*s^2 + 22)/s^4)

/-- The coefficient of `formXPhi` for `(0, 2, 3)`. -/
noncomputable def formXc0p23 (X s : ℝ) : ℝ := (1 - X) / 12 * (6*(s - 1)*(s^2 - 2)/s^5)

/-- The coefficient of `formXPhi` for `(1, -2, 0)`. -/
noncomputable def formXc1m20 (X s : ℝ) : ℝ := (1 - X) / 12 * (-2*(s - 1)^3*(s + 1)/s^2)

/-- The coefficient of `formXPhi` for `(1, -1, 1)`. -/
noncomputable def formXc1m11 (X s : ℝ) : ℝ := (1 - X) / 12 * (-(s - 1)^2*(12*s^4 - 31*s^3 + 23*s^2
    - 6)/s^3)

/-- The coefficient of `formXPhi` for `(1, 0, 2)`. -/
noncomputable def formXc1p02 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)*(8*s^5 - 46*s^4 + 87*s^3 -
    45*s^2 - 42*s + 42)/s^4)

/-- The coefficient of `formXPhi` for `(1, 1, 3)`. -/
noncomputable def formXc1p13 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)*(6*s^4 - 11*s^3 - s^2 + 35*s
    - 35)/s^5)

/-- The coefficient of `formXPhi` for `(2, -2, 1)`. -/
noncomputable def formXc2m21 (X s : ℝ) : ℝ := (1 - X) / 12 * (-(s - 1)^4*(s + 1)/s^3)

/-- The coefficient of `formXPhi` for `(2, -1, 2)`. -/
noncomputable def formXc2m12 (X s : ℝ) : ℝ := (1 - X) / 12 * (-(s - 1)^3*(6*s^4 - 23*s^3 + 26*s^2 -
    22)/s^4)

/-- The coefficient of `formXPhi` for `(2, 0, 3)`. -/
noncomputable def formXc2p03 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)^2*(2*s^5 - 7*s^4 + 23*s^3 -
    14*s^2 - 35*s + 35)/s^5)

/-- The coefficient of `formXPhi` for `(3, -2, 2)`. -/
noncomputable def formXc3m22 (X s : ℝ) : ℝ := (1 - X) / 12 * (2*(s - 1)^5*(s + 1)/s^4)

/-- The coefficient of `formXPhi` for `(3, -1, 3)`. -/
noncomputable def formXc3m13 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)^4*(7*s^3 - 12*s^2 + 13)/s^5)

/-- The coefficient of `formXPhi` for `(4, -2, 3)`. -/
noncomputable def formXc4m23 (X s : ℝ) : ℝ := (1 - X) / 12 * ((s - 1)^6*(s + 1)/s^5)

/-- **The branch-2 integrand in the basis `formXPhi`.** -/
theorem formXKin2_eq_phi {X u s : ℝ} (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1)
    (hu : u ∈ Ioo (1 - s) X) :
    formXKin2 X u s =
      formXc0m10 X s * formXPhi 0 0 1 0 X s u +
      formXc0p01 X s *
          formXPhi 0 0 0 1 X s u +
      formXc0p12 X s *
          formXPhi 0 1 0 2 X s u +
      formXc0p23 X s *
          formXPhi 0 2 0 3 X s u +
      formXc1m20 X s *
          formXPhi 1 0 2 0 X s u +
      formXc1m11 X s *
          formXPhi 1 0 1 1 X s u +
      formXc1p02 X s *
          formXPhi 1 0 0 2 X s u +
      formXc1p13 X s *
          formXPhi 1 1 0 3 X s u +
      formXc2m21 X s *
          formXPhi 2 0 2 1 X s u +
      formXc2m12 X s *
          formXPhi 2 0 1 2 X s u +
      formXc2p03 X s *
          formXPhi 2 0 0 3 X s u +
      formXc3m22 X s *
          formXPhi 3 0 2 2 X s u +
      formXc3m13 X s *
          formXPhi 3 0 1 3 X s u +
      formXc4m23 X s * formXPhi 4 0 2 3 X s u := by
  have h1X : 0 < 1 -
      X := by linarith [hX.2]
  have hu0 : 0 < u := by linarith [hs.2, hu.1]
  have hD := coordD_pos hX hu0 hs.2
  have hs0 : 0 < s := by linarith [hs.1, hX.2]
  have hB : 0 < formXLb X u s := by unfold formXLb; nlinarith [hu.1, hX.1]
  have hC : 0 < formXLc X u s := by
    unfold formXLc
    have : 0 < 1
      -
      s := by linarith [hs.2]
    nlinarith [mul_pos hX.1 this, mul_pos h1X hu0]
  have hY : coordY2 X u s = coordZ2 X u s
      + formXLb X u s * formXLc X u s / (s *
      coordD X u s) := by
    rw [← formX_Y2_sub_Z2 hs0.ne' hD.ne']; ring
  have hz : coordZ2 X u s = formXLl X u
      * (1 - s) / (s *
      coordD X u s) := by
    unfold coordZ2 formXLl; ring
  rw [formXKin2_eq hX hs hu, hY, hz]
  unfold formXNa formXNb formXNc formXPhi
  unfold formXc0m10
  unfold formXc0p01
  unfold formXc0p12
  unfold formXc0p23
  unfold formXc1m20
  unfold formXc1m11
  unfold formXc1p02
  unfold formXc1p13
  unfold formXc2m21
  unfold formXc2m12
  unfold formXc2p03
  unfold formXc3m22
  unfold formXc3m13
  unfold formXc4m23
  generalize formXLl X u = l
  generalize formXLb X u s = b at hB ⊢
  generalize formXLc X u s = c at hC ⊢
  generalize coordD X u s = D at hD ⊢
  field_simp
  ring

/-- **The total coefficient vector** of the branch-2 partial fractions. -/
noncomputable def formXk2 (X s : ℝ) : Fin 9 → ℝ :=
  formXc0m10 X s • formXk0m10 X s
    + formXc0p01 X s • formXk0p01 X s
    + formXc0p12 X s • formXk0p12 X s
    + formXc0p23 X s • formXk0p23 X s
    + formXc1m20 X s • formXk1m20 X s
    + formXc1m11 X s • formXk1m11 X s
    + formXc1p02 X s • formXk1p02 X s
    + formXc1p13 X s • formXk1p13 X s
    + formXc2m21 X s • formXk2m21 X s
    + formXc2m12 X s • formXk2m12 X s
    + formXc2p03 X s • formXk2p03 X s
    + formXc3m22 X s • formXk3m22 X s
    + formXc3m13 X s • formXk3m13 X s
    + formXc4m23 X s • formXk4m23 X s

theorem formXPFHyp_of {X u s : ℝ} (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1)
    (hu : u ∈ Ioo (1 - s) X) : formXPFHyp X s u := by
  have h1X : 0 < 1 - X := by linarith [hX.2]
  have hu0 : 0 < u := by linarith [hs.2, hu.1]
  have hD := coordD_pos hX hu0 hs.2
  have hB : 0 < formXLb X u s := by unfold formXLb; nlinarith [hu.1, hX.1]
  have hC : 0 < formXLc X u s := by
    unfold formXLc
    have : 0 < 1 - s := by linarith [hs.2]
    nlinarith [mul_pos hX.1 this, mul_pos h1X hu0]
  exact ⟨hB.ne', hC.ne', hD.ne', hX.1.ne', by linarith [hX.2], by linarith [hX.2],
    by linarith [hs.2], by linarith [hs.2]⟩

/-- **The branch-2 integrand as one partial-fraction sum.** -/
theorem formXKin2_eq_pf {X u s : ℝ} (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1)
    (hu : u ∈ Ioo (1 - s) X) : formXKin2 X u s = formXPF (formXk2 X s) X s u := by
  have h := formXPFHyp_of hX hs hu
  rw [formXKin2_eq_phi hX hs hu,
    formXPhi_0m10 h,
    formXPhi_0p01 h,
    formXPhi_0p12 h,
    formXPhi_0p23 h,
    formXPhi_1m20 h,
    formXPhi_1m11 h,
    formXPhi_1p02 h,
    formXPhi_1p13 h,
    formXPhi_2m21 h,
    formXPhi_2m12 h,
    formXPhi_2p03 h,
    formXPhi_3m22 h,
    formXPhi_3m13 h,
    formXPhi_4m23 h]
  simp only [formXk2, formXPF_add, formXPF_smul]

/-- **The branch-2 `u`-integral.** -/
theorem integral_formXKin2 {X s : ℝ} (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1) :
    ∫ u in Ioo (1 - s) X, formXKin2 X u s =
      formXPFA (formXk2 X s) X s X - formXPFA (formXk2 X s) X s (1 - s) := by
  rw [setIntegral_congr_fun measurableSet_Ioo fun u hu => formXKin2_eq_pf hX hs hu]
  exact integral_formXPF _ hX hs

end QED.ChainProof.SetCK

end
