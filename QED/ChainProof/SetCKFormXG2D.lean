/-!
# Set (c), Stage K, closed forms: the rational coefficients of the branch-2 antiderivative

Helper level (no frozen statement). Step 4 of route D for `ρ_X` (scratch `stageK/STATUS.md`,
session 26+; generated by `stageK/fxg/g2lean.py` from the canonical antiderivative `g2a.py`,
identities checked in `g2chk.py`). The `s`-antiderivative `G₂` of `formXJ2L` has rational
coefficients `F_s`, `F̃`, `F_u`, `F_k` (of `log s - log(1 - X)`, `(1 - s)(log(1 - s) - log X)`,
`log(2 - X - s)`, `log K₂`) and rational part `formXG2h`; with `κ = formXkap`, for
`X ∈ (0, 1)`, `s ∈ (1 - X, 1)`:

* **`hasDerivAt_formXG2s`**: `F_s′ = a₂`;
* **`hasDerivAt_formXG2t_piece`**: `(F̃ (1 - s)(log(1 - s) - log X))′ =
  (-(a₂ + a₄ + a₆) - κ/s)(log(1 - s) - log X) - F̃`;
* **`hasDerivAt_formXG2u_piece`**, **`hasDerivAt_formXG2k_piece`**: the same for
  `F_u log(2 - X - s)` and `F_k log K₂`.

The derivative of the rational part `formXG2h` is `hasDerivAt_formXG2h` (`SetCKFormXG2H`).
-/

@[expose] public section

open Real Set

namespace QED.ChainProof.SetCK

/-- `K = X² - 2X + 2`. -/
def formXK (X : ℝ) : ℝ := X ^ 2 - 2 * X + 2

theorem formXK_pos (X : ℝ) : 0 < formXK X := by
  unfold formXK
  nlinarith [sq_nonneg (X - 1)]

/-- The common dilogarithm coefficient `κ = (X⁴ - 4X³ + 9X² - 10X + 5)/(6(X - 1)²)`. -/
noncomputable def formXkap (X : ℝ) : ℝ :=
  (X ^ 4 - 4 * X ^ 3 + 9 * X ^ 2 - 10 * X + 5) / (6 * (X - 1) ^ 2)

