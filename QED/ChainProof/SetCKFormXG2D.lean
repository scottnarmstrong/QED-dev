variable {X s : ℝ}

theorem hasDerivAt_formXG2s (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1) :
    HasDerivAt (formXG2s X) (formXkh2 X s) s := by
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hs0, hs1⟩ := hs
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have hX2 : X - 2 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have hs : s ≠ 0 := by linarith
  have hs2 : s - 2 ≠ 0 := by linarith
  have h2s : 2 - s ≠ 0 := by linarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG2sD X) 1 0 (hasDerivAt_id' s)
    ((hasDerivAt_id' s).sub_const 2)
  have h := formX_hasDerivAt_polDiv (formXG2sN X) hD (by unfold formXG2sD; simp [*])
  have e : formXG2s X = fun z =>
      formXPol (formXG2sN X) z / (formXG2sD X * z ^ 1 * (z - 2) ^ 0) := by
    funext z; unfold formXG2s; ring
  rw [← e] at h
  refine h.congr_deriv ?_
  rw [formXG2s_pol, formXG2s_dpol]
  unfold formXG2sD formXkh2
  field_simp
  unfold formXK
  ring

theorem hasDerivAt_formXG2t_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1) :
    HasDerivAt (fun z => formXG2t X z * ((1 - z) * log (1 - z) - (1 - z) * log X))
      ((-(formXkh2 X s + formXa4 X s + formXa6 X s) - formXkap X / s) * (log (1 - s) - log X) -
        formXG2t X s) s := by
  have h1s : 1 - s ≠ 0 := by linarith [hs.2]
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hs0, hs1⟩ := hs
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have hX2 : X - 2 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have hs : s ≠ 0 := by linarith
  have hs2 : s - 2 ≠ 0 := by linarith
  have h2s : 2 - s ≠ 0 := by linarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG2tD X) 2 3 (hasDerivAt_id' s)
    ((hasDerivAt_id' s).sub_const 2)
  have h := formX_hasDerivAt_polDiv (formXG2tN X) hD (by unfold formXG2tD; simp [*])
  have e : formXG2t X = fun z =>
      formXPol (formXG2tN X) z / (formXG2tD X * z ^ 2 * (z - 2) ^ 3) := by
    funext z; unfold formXG2t; ring
  rw [← e] at h
  obtain ⟨T', hT', hid⟩ : ∃ T', HasDerivAt (formXG2t X) T' s ∧
      (1 - s) * T' - formXG2t X s = -(formXkh2 X s + formXa4 X s + formXa6 X s) -
        formXkap X / s := by
    refine ⟨_, h, ?_⟩
    unfold formXG2t
    rw [formXG2t_pol, formXG2t_dpol]
    unfold formXG2tD formXkh2 formXa4 formXa6 formXkh4 formXkh6 formXkap
    field_simp
    ring
  have hL : HasDerivAt (fun z => (1 - z) * log (1 - z) - (1 - z) * log X)
      (-log (1 - s) - 1 + log X) s := by
    have h1 := (hasDerivAt_id' s).const_sub 1
    have h2 := (h1.mul (h1.log h1s)).sub (h1.mul_const (log X))
    refine h2.congr_deriv ?_
    field_simp
    ring
  refine (hT'.mul hL).congr_deriv ?_
  linear_combination (log (1 - s) - log X) * hid

theorem hasDerivAt_formXG2u_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1) :
    HasDerivAt (fun z => formXG2u X z * log (2 - X - z))
      ((formXa4 X s + formXa6 X s + formXkap X / s) * log (2 - X - s) -
        formXG2u X s / (2 - X - s)) s := by
  have h2Xs : 2 - X - s ≠ 0 := by linarith [hs.2, hX.2]
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hs0, hs1⟩ := hs
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have hX2 : X - 2 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have hs : s ≠ 0 := by linarith
  have hs2 : s - 2 ≠ 0 := by linarith
  have h2s : 2 - s ≠ 0 := by linarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG2uD X) 2 3 (hasDerivAt_id' s)
    ((hasDerivAt_id' s).sub_const 2)
  have h := formX_hasDerivAt_polDiv (formXG2uN X) hD (by unfold formXG2uD; simp [*])
  have e : formXG2u X = fun z =>
      formXPol (formXG2uN X) z / (formXG2uD X * z ^ 2 * (z - 2) ^ 3) := by
    funext z; unfold formXG2u; ring
  rw [← e] at h
  obtain ⟨U', hU', hid⟩ : ∃ U', HasDerivAt (formXG2u X) U' s ∧
      U' = formXa4 X s + formXa6 X s + formXkap X / s := by
    refine ⟨_, h, ?_⟩
    rw [formXG2u_pol, formXG2u_dpol]
    unfold formXG2uD formXa4 formXa6 formXkh4 formXkh6 formXkap
    field_simp
    ring
  have hL := ((hasDerivAt_id' s).const_sub (2 - X)).log h2Xs
  refine (hU'.mul hL).congr_deriv ?_
  rw [hid]
  ring

theorem hasDerivAt_formXG2k_piece (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s ∈ Ioo (1 - X) 1) :
    HasDerivAt (fun z => formXG2k X z * log (formXK2 X z))
      ((-formXa6 X s - formXkap X / s) * log (formXK2 X s) -
        (1 - X) * formXG2k X s / formXK2 X s) s := by
  have hK2 := (formXK2_pos hX (by linarith [hs.2])).ne'
  obtain ⟨hX0, hX1⟩ := hX
  obtain ⟨hs0, hs1⟩ := hs
  have hX : X ≠ 0 := hX0.ne'
  have hX1' : X - 1 ≠ 0 := by linarith
  have hX2 : X - 2 ≠ 0 := by linarith
  have h1X : 1 - X ≠ 0 := by linarith
  have hs : s ≠ 0 := by linarith
  have hs2 : s - 2 ≠ 0 := by linarith
  have h2s : 2 - s ≠ 0 := by linarith
  have hK := (formXK_pos X).ne'
  have hD := formX_hasDerivAt_den (formXG2kD X) 2 3 (hasDerivAt_id' s)
    ((hasDerivAt_id' s).sub_const 2)
  have h := formX_hasDerivAt_polDiv (formXG2kN X) hD (by unfold formXG2kD; simp [*])
  have e : formXG2k X = fun z =>
      formXPol (formXG2kN X) z / (formXG2kD X * z ^ 2 * (z - 2) ^ 3) := by
    funext z; unfold formXG2k; ring
  rw [← e] at h
  obtain ⟨U', hU', hid⟩ : ∃ U', HasDerivAt (formXG2k X) U' s ∧
      U' = -formXa6 X s - formXkap X / s := by
    refine ⟨_, h, ?_⟩
    rw [formXG2k_pol, formXG2k_dpol]
    unfold formXG2kD formXa6 formXkh6 formXkap
    field_simp
    unfold formXK
    ring
  have hL := (hasDerivAt_formXK2 X s).log hK2
  refine (hU'.mul hL).congr_deriv ?_
  rw [hid]
  ring

end

