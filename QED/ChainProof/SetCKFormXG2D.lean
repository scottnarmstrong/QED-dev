theorem hasDerivAt_formXK2 (X s : ℝ) : HasDerivAt (formXK2 X) (-(1 - X)) s := by
  have h := (((hasDerivAt_id' s).const_sub 2).const_mul (1 - X)).const_add (X ^ 2)
  unfold formXK2
  exact h.congr_deriv (by ring)

theorem formXK2_pos {X s : ℝ} (hX : X ∈ Ioo (0 : ℝ) 1) (hs : s < 2) : 0 < formXK2 X s := by
  unfold formXK2
  have : 0 < 1 - X := by linarith [hX.2]
  have : 0 < 2 - s := by linarith
  nlinarith [hX.1]

