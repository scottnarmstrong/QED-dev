/-!
# The linear relations among the alternating weight-five values `H(w; 1)`

For the 108 words `w` of weight five over `{0, 1, -1}` with first letter not `1` and no
trailing zero, a set of 98 linear relations with known right-hand sides which, together with the
ten values `H(w; 1)` known in closed form (the eight words over `{0, 1}`, `H(0, 0, 0, 0, -1; 1)`
and `H(-1, 1, 1, 1, 1; 1) = Li₅(1/2)`), determines every value (used in
`QED.Polylog.HPLValuesAlt5A` and `QED.Polylog.HPLValuesAlt5B`):

* `rel5_sh_u_v`, `rel5_st_u_v`: the shuffle and the stuffle of a product `H(u; 1) H(v; 1)` of
  lower-weight words (weights `1 + 4` and `2 + 3`), with the product evaluated (letters written
  `0`, `1`, `m` for `0`, `1`, `-1`);
* `rel5_mob_w`: the Möbius duality `QED.Polylog.HPL.hpl_one_eq_mobEval_mobImage` of the word `w`
  (the substitution `t ↦ (1 - t)/(1 + t)`).

The selected relations are linearly independent; the statements were generated by a script
(exact linear algebra over `ℚ`), the proofs are checked by Lean.
-/

@[expose] public section

open Real

namespace QED.Polylog.HPL

open Letter QED.Polylog.MZV

/-- `H(0000-1; 1) = -Li₅(-1) = 15 ζ(5)/16`. -/
theorem hpl_zero_zero_zero_zero_negOne_at_one :
    hpl [zero, zero, zero, zero, negOne] 1 = 15 / 16 * zeta5 := by
  rw [show [zero, zero, zero, zero, negOne] = List.replicate 4 zero ++ [negOne] from rfl,
    hpl_replicate_zero_negOne_at_one (by norm_num)]
  have h := Li_add_Li_neg (k := 5) (by norm_num) (x := 1) (by norm_num)
  rw [one_pow, Li_five_one] at h
  linarith

theorem rel5_sh_m_mmmm :
    5 * hpl [negOne, negOne, negOne, negOne, negOne] 1 =
      1 / 24 * log 2 ^ 5 := by
  have h := hpl_one_mul_hpl_one (u := [negOne]) (v := [negOne, negOne, negOne, negOne]) (by decide)
    (by decide)
  simp [shuffle_cons_cons] at h
  simp only [hpl_negOne_at_one, hpl_negOne_negOne_negOne_negOne_at_one] at h
  linear_combination -h

