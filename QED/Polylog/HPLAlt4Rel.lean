  linear_combination -h

theorem rel4_st_2 :
    -hpl [zero, zero, negOne, negOne] 1 + hpl [zero, one, zero, negOne] 1
    + hpl [zero, one, one, negOne] 1 - hpl [zero, one, negOne, negOne] 1
    + hpl [negOne, zero, negOne, negOne] 1 =
      log 2 * zeta3 := by
  have h := hpl_one_mul_hpl_one_stuffle (a := negOne) (b := zero) (u := [])
    (v := [one, one]) (by decide) (by decide) (by decide) (by decide)
