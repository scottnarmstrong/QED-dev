/-!
# The linear relations among the alternating weight-four values `H(w; 1)`

For the 36 words `w` of weight four over `{0, 1, -1}` with first letter not `1` and no
trailing zero, the linear relations with known right-hand sides used to reduce `H(w; 1)` to
the basis `π⁴, log 2 · ζ(3), Li₄(1/2), log⁴ 2, π² log² 2` (in
`QED.Polylog.HPLValuesAlt4`):

* `rel4_sh_k`, `rel4_st_k`: the shuffle and the stuffle of a product `H(u; 1) H(v; 1)` of
  lower-weight words (weights `1 + 3` and `2 + 2`), with the product evaluated;
* `rel4_dist_s`: the distribution relations for the exponent lists `(4)`, `(3, 1)`, `(2, 2)`,
  `(2, 1, 1)`.

Each relation is an instance of the general theorems `QED.Polylog.HPL.hpl_one_mul_hpl_one`,
`QED.Polylog.MZV.hpl_one_mul_hpl_one_stuffle`, `QED.Polylog.MZV.sum_signedLists_hpl_one`, with
the word lists evaluated by `simp`. The statements were generated by a script; the proofs are
checked by Lean.
-/

@[expose] public section

open Real

namespace QED.Polylog.HPL

open Letter QED.Polylog.MZV

/-- `H(000-1; 1) = -Li₄(-1) = 7π⁴/720`. -/
theorem hpl_zero_zero_zero_negOne_at_one : hpl [zero, zero, zero, negOne] 1 = 7 / 720 * π ^ 4 := by
  rw [show [zero, zero, zero, negOne] = List.replicate 3 zero ++ [negOne] from rfl,
    hpl_replicate_zero_negOne_at_one (by norm_num), Li_four_neg_one]
  ring

theorem rel4_sh_0 :
    hpl [zero, zero, one, negOne] 1 + hpl [zero, zero, negOne, one] 1
    + hpl [zero, negOne, zero, one] 1 + hpl [negOne, zero, zero, one] 1 =
      log 2 * zeta3 := by
  have h := hpl_one_mul_hpl_one (u := [negOne]) (v := [zero, zero, one]) (by decide)
    (by decide)
  simp [shuffle_cons_cons] at h
  simp only [hpl_negOne_at_one, hpl_zero_zero_one_at_one] at h
  linear_combination -h

theorem rel4_st_0 :
    hpl [zero, zero, zero, negOne] 1 + hpl [zero, zero, one, negOne] 1
    - hpl [negOne, zero, zero, negOne] 1 =
      log 2 * zeta3 := by
  have h := hpl_one_mul_hpl_one_stuffle (a := negOne) (b := zero) (u := [])
    (v := [zero, one]) (by decide) (by decide) (by decide) (by decide)
  simp [encode, stuffle_cons_cons, decode, letterOfSign, mzvOp, wordSign] at h
  simp only [hpl_negOne_at_one, hpl_zero_zero_one_at_one] at h
  linear_combination -h

theorem rel4_sh_1 :
    2 * hpl [zero, zero, negOne, negOne] 1 + hpl [zero, negOne, zero, negOne] 1
    + hpl [negOne, zero, zero, negOne] 1 =
      3 / 4 * log 2 * zeta3 := by
  have h := hpl_one_mul_hpl_one (u := [negOne]) (v := [zero, zero, negOne]) (by decide)
    (by decide)
  simp [shuffle_cons_cons] at h
  simp only [hpl_negOne_at_one, hpl_zero_zero_negOne_at_one] at h
  linear_combination -h

theorem rel4_st_1 :
    hpl [zero, zero, zero, one] 1 - hpl [zero, zero, negOne, one] 1
    - hpl [negOne, zero, zero, one] 1 =
      3 / 4 * log 2 * zeta3 := by
  have h := hpl_one_mul_hpl_one_stuffle (a := negOne) (b := zero) (u := [])
    (v := [zero, negOne]) (by decide) (by decide) (by decide) (by decide)
  simp [encode, stuffle_cons_cons, decode, letterOfSign, mzvOp, wordSign] at h
  simp only [hpl_negOne_at_one, hpl_zero_zero_negOne_at_one] at h
  linear_combination -h

theorem rel4_sh_2 :
