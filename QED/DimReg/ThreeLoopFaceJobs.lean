/-- The cut paths of the box with index `b`. -/
def cutsOf (b : ℕ) : List (List Bool) := (faceJobs.filter fun x => x.1 == b).map Prod.snd

/-- **The skeletons above the cuts pass**, on all `128` boxes. -/
theorem faceSkel : (List.range 128).all (fun b =>
    pchkCut h7 (cutsOf b) (treeB b) [] (rootQ b) (rootV b)) = true := by
  decide +kernel

