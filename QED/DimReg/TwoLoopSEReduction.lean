/-! ### The templates for the continued integrals, for `re λ` large -/

theorem far_template00 (n : Fin 5 → ℤ) (d₀ : ℂ) : ∀ᶠ l in atRe,
    ((twoLoopSE.tmplAt 0 0).map fun t => termCoeff t (lineD d₀ l) (lineNu n l) *
      Iline (n + toVec 5 t.shift) d₀ l).sum = 0 := by
  filter_upwards [eventually_annihilator pT00 qT00 [] eT00 hsyz00 he00 n d₀]
    with l hJ
  simp only [pT00, qT00, Fin.sum_univ_five, List.map_cons, List.map_nil,
    List.sum_cons, List.sum_nil, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons,
    Matrix.tail_cons] at hJ
  simp only [show lowZ ![0, 0, 0, 0, 1] 0 = toVec 5 [-1, 0, 0, 0, 1] by decide,
    show lowZ ![0, 0, 0, 0, 1] 3 = toVec 5 [0, 0, 0, -1, 1] by decide,
    show lowZ ![0, 0, 0, 0, 1] 4 = toVec 5 [0, 0, 0, 0, 0] by decide,
    show lowZ ![0, 0, 1, 0, 0] 0 = toVec 5 [-1, 0, 1, 0, 0] by decide,
    show lowZ ![0, 0, 1, 0, 0] 2 = toVec 5 [0, 0, 0, 0, 0] by decide,
    show lowZ ![1, 0, 0, 0, 0] 0 = toVec 5 [0, 0, 0, 0, 0] by decide,
    show natZ ![0, 0, 0, 0, 0] = toVec 5 [0, 0, 0, 0, 0] by decide] at hJ
  simp only [add_toVec_zero] at hJ
  simp only [Family.tmplAt, twoLoopSE, List.getD_cons_zero,
    List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Iline, add_toVec_zero,
    add_toVec_nil]
  have h0 := normF_raise_lower (a := 4) (b := 0) (by decide) (m := n)
    (m' := n + toVec 5 [-1, 0, 0, 0, 1])
    (by intro j; fin_cases j <;> simp [toVec, sub_eq_add_neg]) d₀ l
  have h1 := normF_raise_lower (a := 2) (b := 0) (by decide) (m := n)
    (m' := n + toVec 5 [-1, 0, 1, 0, 0])
    (by intro j; fin_cases j <;> simp [toVec, sub_eq_add_neg]) d₀ l
  have h3 := normF_raise_lower (a := 4) (b := 3) (by decide) (m := n)
    (m' := n + toVec 5 [0, 0, 0, -1, 1])
    (by intro j; fin_cases j <;> simp [toVec, sub_eq_add_neg]) d₀ l
  simp only [termCoeff]
  norm_num
  linear_combination normF n d₀ l * hJ +
    (-2 : ℂ) * Jline (n + toVec 5 [-1, 0, 0, 0, 1]) d₀ l * h0 +
    (-2 : ℂ) * Jline (n + toVec 5 [-1, 0, 1, 0, 0]) d₀ l * h1 +
    (2 : ℂ) * Jline (n + toVec 5 [0, 0, 0, -1, 1]) d₀ l * h3

