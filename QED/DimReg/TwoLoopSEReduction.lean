/-! ### The checker's hypotheses at `λ = 0` -/

/-- The precomputed relations of `twoLoopSE` are the generated ones. -/
theorem tmplOk_twoLoopSE : twoLoopSE.tmplOk = true := by decide +kernel

theorem analyticAt_termCoeff (t : Term) (n : Fin 5 → ℤ) (d₀ z : ℂ) :
    AnalyticAt ℂ (fun l => termCoeff t (lineD d₀ l) (lineNu n l)) z := by
  unfold termCoeff lineD lineNu
  split <;> fun_prop

theorem termCoeff_zero (t : Term) (n : Fin 5 → ℤ) (d₀ : ℂ) :
    termCoeff t (lineD d₀ 0) (lineNu n 0) = t.coeff d₀ n := by
  simp only [termCoeff, Term.coeff, vecGet, lineD, lineNu, mul_zero, add_zero]
  split <;> push_cast <;> ring

/-- **A template relation at `λ = 0`.** If the relation `template i j` holds for the normalized
continued integrals for `re λ` large, it holds for the values `val` at `d₀ ∉ ℚ`. -/
theorem ibpHoldsAt_of_far {i j : ℕ} {n : Fin 5 → ℤ} {d₀ : ℂ} (hd : Irr d₀)
    (h : ∀ᶠ l in atRe, ((twoLoopSE.tmplAt i j).map fun t => termCoeff t (lineD d₀ l) (lineNu n l) *
      Iline (n + toVec 5 t.shift) d₀ l).sum = 0) :
    ((twoLoopSE.tmplAt i j).map fun t => t.coeff d₀ n * val (n + toVec 5 t.shift) d₀).sum = 0 := by
  have hm : MeromorphicOn (fun l => ((twoLoopSE.tmplAt i j).map fun t =>
      termCoeff t (lineD d₀ l) (lineNu n l) * Iline (n + toVec 5 t.shift) d₀ l).sum) halfPlane :=
    meromorphicOn_list_sum _ fun t _ z hz =>
      (analyticAt_termCoeff t n d₀ z).meromorphicAt.mul (meromorphicOn_Iline _ _ z hz)
  have h0 := eventuallyEq_nhdsNE_of_atRe hm (fun z _ => analyticAt_const.meromorphicAt) h
    zero_mem_halfPlane
  have T := tendsto_list_sum (twoLoopSE.tmplAt i j) (f := fun t l =>
    termCoeff t (lineD d₀ l) (lineNu n l) * Iline (n + toVec 5 t.shift) d₀ l) fun t _ =>
      ((analyticAt_termCoeff t n d₀ 0).continuousAt.tendsto.mono_left nhdsWithin_le_nhds).mul
        (tendsto_Iline _ hd)
  have := tendsto_nhds_unique (T.congr' h0) tendsto_const_nhds
  simpa only [termCoeff_zero] using this

/-- **`IBPHolds` for the continued integrals**: for `d ∉ ℚ` the integer-label values `val`
satisfy every IBP relation of `twoLoopSE` (all `i < 2`, `j < 3`, `ν ∈ ℤ⁵`). -/
theorem ibpHolds_val {d : ℂ} (hd : Irr d) : twoLoopSE.IBPHolds val d := by
  intro i hi j hj ν
  rw [← Family.tmplAt_eq_template tmplOk_twoLoopSE hi hj]
  have hi' : i < 2 := hi
  have hj' : j < 3 := hj
  interval_cases i <;> interval_cases j
  · exact ibpHoldsAt_of_far hd (far_template00 ν d)
  · exact ibpHoldsAt_of_far hd (far_template01 ν d)
  · exact ibpHoldsAt_of_far hd (far_template02 ν d)
  · exact ibpHoldsAt_of_far hd (far_template10 ν d)
  · exact ibpHoldsAt_of_far hd (far_template11 ν d)
  · exact ibpHoldsAt_of_far hd (far_template12 ν d)

/-! ### The reduction -/

/-- **The landed certificate applied to the actual integrals.** Off a finite set of `d` and for
`d ∉ ℚ`, the two-loop on-shell self-energy integral `I(1, 1, 1, 1, 1)` (the value at `λ = 0` of the
normalized continued Lee–Pomeransky integral) is the certified combination of the five masters
`I(1,1,0,0,1)`, `I(0,0,1,1,1)`, `I(0,0,1,1,0)`, `I(0,0,1,0,1)`, `I(0,0,0,1,1)`, from
`QED.Algebra.IBPCert.Pilot.twoLoop_reduction`. -/
theorem val_reduction : ∃ s : Finset ℂ, ∀ d, Irr d → d ∉ s →
    Poly.eval d twoLoopCert.den ≠ 0 ∧
      val (toVec twoLoopSE.nProp twoLoopCert.target) d =
        (twoLoopCert.masters.map fun m => Poly.eval d m.2 / Poly.eval d twoLoopCert.den *
          val (toVec twoLoopSE.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := twoLoop_reduction (K := ℂ)
  exact ⟨s, fun d hd hds => ⟨(hs d hds).1, (hs d hds).2 val (ibpHolds_val hd) (zeroSectors_val hd)⟩⟩

/-- **The values are the integrals** where these converge: at a positive label, `d ∉ ℚ`, and all
leaf exponents of the line with positive real part at `λ = 0`,
`val n d = (-1)^{|n|} Γ(d/2) / (Γ(3d/2 - |n|) ∏ₐ Γ(nₐ)) · ∫ x^{n-1} G^{-d/2} dx`. -/
theorem val_eq_integral {n : Fin 5 → ℤ} (hn : ∀ j, 1 ≤ n j) {d : ℂ} (hd : Irr d)
    (hre : sectorData.ReGt (lineNu n) (lineD d) 0 0) :
    val n d = normF n d 0 * lpIntegral (fun x => sectorData.G.eval x) (fun j => (n j : ℂ)) d := by
  have h1 : val n d = Iline n d 0 :=
    tendsto_nhds_unique (tendsto_Iline n hd)
      ((continuousAt_Iline_pos hn hd).tendsto.mono_left nhdsWithin_le_nhds)
  have h2 := sectorData.lpIntegral_eq_lpCont (Kof n d) (differentiable_lineD d) hre
  have hν : lineNu n 0 = fun j => (n j : ℂ) := by funext j; simp [lineNu]
  simp only [lineD, add_zero, mul_zero] at h2
  rw [h1, Iline, Jline, ← h2, hν]

end QED.DimReg.TwoLoopSESector
