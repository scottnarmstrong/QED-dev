public import QED.DimReg.TwoLoopSEZero
public import QED.Algebra.IBPCertPilot

/-!
# The two-loop self-energy: the certified IBP reduction for the actual integrals

End to end for the checker's pilot family `QED.Algebra.IBPCert.Pilot.twoLoopSE`, following
`QED.DimReg.OneLoopReduction`.

**The momentum IBPs as annihilator relations (item 3).** After the Lee–Pomeransky normalization
each of the six relations `template i j` (`i < 2`, `j < 3`) is exactly the relation of a first-order
annihilator of `G^{-d/2}`: a vector field `p` and a polynomial `q` with `Σ_b p_b ∂_b G = q G`
(data `pT`, `qT`, generated by `ann.py` and checked here by `ring`). So
`QED.DimReg.lpIntegral_annihilator` gives the relation for the continued integrals for `re λ`
large, and the Γ-factor identities `normF_raise_lower`, `normF_raise` turn it into the template
relation for `Iline` (`far_template00`, …). The identity theorem carries it to `λ = 0`
(`ibpHoldsAt_of_far`), so the integer-label values `QED.DimReg.TwoLoopSESector.val` satisfy
**all** IBP relations (`ibpHolds_val`) for `d ∉ ℚ`.

**The reduction (item 6).** With the zero sectors (`zeroSectors_val`), the kernel-checked
certificate `QED.Algebra.IBPCert.Pilot.twoLoop_reduction` applies to the actual continued
integrals (`val_reduction`).
-/

@[expose] public section

open Complex Filter Topology Set QED.DimReg QED.Algebra.IBPCert QED.Algebra.IBPCert.Pilot

namespace QED.DimReg.TwoLoopSESector

/-- The coefficient `c₀ + c_d d + c_ν ν_idx` of a checker term at complex `(d, ν)`. -/
def termCoeff (t : Term) (d : ℂ) (ν : Fin 5 → ℂ) : ℂ :=
  t.c0 + t.cd * d + t.cnu * (if h : t.idx < 5 then ν ⟨t.idx, h⟩ else 0)

theorem add_toVec_zero (n : Fin 5 → ℤ) : n + toVec 5 [0, 0, 0, 0, 0] = n := by
  funext j; fin_cases j <;> simp [toVec]

theorem add_toVec_nil (n : Fin 5 → ℤ) : n + toVec 5 [] = n := by
  funext j; simp [toVec]

