/-- **The twelve syzygies** `Σ_b p_b ∂_b G = q G`, checked by the kernel. -/
theorem annCheck_all : ∀ i < 3, ∀ j < 4, annCheck 9 lpPolyLit (pT i j) (qT i j) = true := by
  decide +kernel

/-- The syzygy of template `(i, j)` in the form of `QED.DimReg.lpIntegral_annihilator`. -/
theorem hsyz {i j : ℕ} (hi : i < 3) (hj : j < 4) (x : Fin 9 → ℝ) :
    ∑ b, polyEval (annField (pT i j) b) x * gD b x =
      polyEval (toML (qT i j)) x * lpPoly.eval x + polyEval [] x := by
  have h := annCheck_syz (annCheck_all i hi j hj) x
  rw [← lpPoly_eq_lit] at h
  exact h

/-- The products `p_b ∂_b G` of template `(i, j)`, as monomial lists. -/
theorem he (i j : ℕ) (b : Fin 9) (x : Fin 9 → ℝ) :
    polyEval (annField (pT i j) b) x * gD b x = polyEval (annProd lpPoly (pT i j) b) x :=
  annProd_eval lpPoly (pT i j) b x

