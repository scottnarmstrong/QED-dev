/-!
# Set (d), master `I₁₃`: more basis functions near `ξ = 0`

The Lyndon words of weight at most five used by the limit of `F₄ - A₄` that are not already in
`QED.ThreeLoopD.SetDMastersI13R3S`, each written as `c₁ x + c₂ x² + x³ ρ_w(x)` with the first two
coefficients of its power series and the normalized remainder `ρ_w`
(`QED.ThreeLoopD.i13Rho`, `|ρ_w| ≤ 2` on `(0, 1/2)` by `QED.ThreeLoopD.abs_i13Rho_le`); the
statements were generated by a script.
-/

@[expose] public section

open Set Real QED.Polylog QED.Polylog.HPL QED.Polylog.HPL.Letter

namespace QED.ThreeLoopD

theorem i13hpl_rho_m1 {x : ℝ} (hx : x ≠ 0) :
    hpl [negOne, one] x = x ^ 2 / 2 + i13Rho [negOne, one] x * x ^ 3 := by
  have h1 : coef [negOne, one] 1 = 0 := by norm_num [coef, twistSum, Letter.toReal]
  have h2 : coef [negOne, one] 2 = 1 / 2 := by norm_num [coef, twistSum, Letter.toReal]
  unfold i13Rho
  rw [h1, h2]
  field_simp
  ring

