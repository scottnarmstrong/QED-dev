/-!
# Set (d), master `I₁₃`: the limit of `F₄ - A₄` at infinity

As `t → ∞`, `ξ(t) → 0⁺`. In terms of `ξ` (`log t = 2 log (1 - ξ) - log ξ`), each part of
`ξ² (F₄ - A₄)` (the parts `ξ ^ j Nⱼ` of `ξ² Ψ₄`, `ξ² W` and `ξ² A₄`) is written, after inserting
the Lyndon forms of the words and `H(w; ξ) = c₁ ξ + c₂ ξ² + ξ³ ρ_w(ξ)` for the basis functions, as
a polynomial of degree two in `ξ` plus `ξ³` times a polynomial in `log ξ` whose coefficients are
polynomials in `ξ` and the `ρ_w(ξ)` (`QED.ThreeLoopD.i13LN0_eq`, …). The low-order parts add up
to `ξ² (4π⁴/45 - 5π²/12 + 4ζ(3) - 1771/16)`, so (`QED.ThreeLoopD.i13D4_eq`)

  `F₄ - A₄ = 4π⁴/45 - 5π²/12 + 4ζ(3) - 1771/16 + ξ (Q₀ + Q₁ log ξ + … + Q₄ log⁴ ξ)`.

The `ρ_w` are bounded (`QED.ThreeLoopD.abs_i13Rho_le`), so the `Qⱼ` are bounded near `0`, and
`ξ logʲ ξ → 0`. The polynomials were generated by a script.

## Main results

* `QED.ThreeLoopD.i13D4_eq`.
* `QED.ThreeLoopD.tendsto_i13F4_sub_prim4`.
-/

@[expose] public section

open MeasureTheory Set Filter Topology Real QED.Polylog QED.Polylog.HPL QED.Polylog.HPL.Letter

namespace QED.ThreeLoopD

/-- `A₄(t(ξ))`, with `log t = 2 log (1 - ξ) - log ξ`. -/
noncomputable def i13Prim4x (x : ℝ) : ℝ :=
    (27 / 16) * (((1 - x) ^ 2 / x) ^ 2 * (2 * Real.log (1 - x) - Real.log x) ^ 4) +
    (-99 / 8) * (((1 - x) ^ 2 / x) ^ 2 * (2 * Real.log (1 - x) - Real.log x) ^ 3) + (729 / 16 -
    3 / 4 * π ^ 2) * (((1 - x) ^ 2 / x) ^ 2 * (2 * Real.log (1 - x) - Real.log x) ^ 2) +
    (-1497 / 16 + 6 * zeta3 + 11 / 4 * π ^ 2) * (((1 - x) ^ 2 / x) ^ 2 * (2 * Real.log (1 -
    x) - Real.log x)) + (2777 / 32 - 11 * zeta3 - 27 / 8 * π ^ 2 - π ^ 4 / 90) * (((1 -
    x) ^ 2 / x) ^ 2) + (65 / 6) * (((1 - x) ^ 2 / x) * (2 * Real.log (1 - x) -
    Real.log x) ^ 4) + (-190 / 3) * (((1 - x) ^ 2 / x) * (2 * Real.log (1 - x) -
    Real.log x) ^ 3) + (206 - 14 / 3 * π ^ 2) * (((1 - x) ^ 2 / x) * (2 * Real.log (1 -
    x) - Real.log x) ^ 2) + (-388 + 32 * zeta3 + 40 / 3 * π ^ 2) * (((1 -
    x) ^ 2 / x) * (2 * Real.log (1 - x) - Real.log x)) + (328 - 40 * zeta3 - 14 * π ^ 2 +
    π ^ 4 / 90) * (((1 - x) ^ 2 / x)) + (-1 / 2) * ((2 * Real.log (1 - x) - Real.log x) ^ 5) +
    (47 / 3) * ((2 * Real.log (1 - x) - Real.log x) ^ 4) + (-28 +
    4 / 9 * π ^ 2) * ((2 * Real.log (1 - x) - Real.log x) ^ 3) + (37 / 2 - 8 * zeta3 -
    7 * π ^ 2) * ((2 * Real.log (1 - x) - Real.log x) ^ 2) + (187 / 4 + 52 * zeta3 + π ^ 4 / 10 +
    37 / 6 * π ^ 2) * ((2 * Real.log (1 - x) - Real.log x))

theorem i13hw_00000 (x : ℝ) :
    hpl [zero, zero, zero, zero, zero] x = Real.log x ^ 5 / 120 := by
  rw [hpl_of_allZero (by decide)]
  simp [Nat.factorial]

/-- `F₄ - A₄` in terms of `ξ`. -/
noncomputable def i13D4 (x : ℝ) : ℝ := i13Psi4 x - i13Prim4x x

theorem i13F4_sub_prim4 {t : ℝ} (ht : 0 < t) : i13F4 t - i13Prim4 t = i13D4 (i13Xi t) := by
  have hT := (i13Xi_t ht.le).symm
  have hlog := (i13_log_eq_xi ht).symm
  unfold i13D4 i13F4
  congr 1
  unfold i13Prim4x i13Prim4
  rw [hT, hlog]

