    (Real.log x / 2) * i13hw_m00 hx + (1 / 2) * h1 + (-hpl [negOne] x / 2) * i13hw_000 x +
    (-1 / 2) * h2 + (1 / 2) * hpl [zero, zero, negOne] x * hpl_zero x

