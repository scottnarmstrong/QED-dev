theorem i13hw_m000 {x : ℝ} (hx : x ∈ Ioo (0 : ℝ) 1) :
    hpl [negOne, zero, zero, zero] x = -hpl [zero, zero, zero, negOne] x +
    Real.log x * hpl [zero, zero, negOne] x - hpl [zero, negOne] x * Real.log x ^ 2 / 2 +
    hpl [negOne] x * Real.log x ^ 3 / 6 := by
  have h0 := hpl_mul_hpl [zero] [negOne, zero, zero] hx
  have h1 := hpl_mul_hpl [negOne] [zero, zero, zero] hx
  have h2 := hpl_mul_hpl [zero] [zero, zero, negOne] hx
