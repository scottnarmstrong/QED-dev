/-!
# Set (d), master `I₁₂`: the polynomial identity behind its expansion

`QED.ThreeLoopD.SetDMastersI12Gamma` writes `ε³ I₁₂ C⁻¹ · D(ε)` as
`K₁ N₁ + K₂ N₂ + (K₃ 4^ε + K₄ 4^(-ε)) N₃ + D_c ε Rest K₀`, with `Kⱼ` ratios of `Γ(1 + aε)`,
`Kⱼ = exp(ε² (Xⱼ + O(ε⁴)))`. Truncating each exponential, the identity of this file
(`QED.ThreeLoopD.i12_key`) says that the truncations reproduce `ε³ · setDLaurentI12` through
`ε⁵`, given the expansion `Rest = r₁ε + r₂ε² + r₃ε³ + r₄ε⁴ + O(ε⁵)`
(`QED.ThreeLoopD.i12PolyRL`). The constants are variables here: `p = π`, `a = ζ₃`, `b = ζ₅`,
`l = ln 2`, `e = ε`. The identity was computed with sympy (`setDI12/gen_gamma.py`) and is checked
by `ring`.
-/

@[expose] public section

namespace QED.ThreeLoopD

/-- The truncation `1 + e² X + e⁴ X² / 2` of `exp(e² X)`. -/
noncomputable def i12PolyKH (X e : ℂ) : ℂ := 1 + e ^ 2 * X + e ^ 4 * X ^ 2 / 2

/-- The truncation of `exp(c e)` through `(c e) ^ 5`. -/
noncomputable def i12PolyEH (c e : ℂ) : ℂ :=
  1 + c * e + (c * e) ^ 2 / 2 + (c * e) ^ 3 / 6 + (c * e) ^ 4 / 24 + (c * e) ^ 5 / 120

/-- The exponent of `K₀ = Γ(1 + 3ε) / Γ(1 + ε)³` over `ε²`, through `ε³`. -/
noncomputable def i12PolyX0 (p a b e : ℂ) : ℂ :=
  p ^ 2 / 2 - 8 * a * e + 13 / 60 * p ^ 4 * e ^ 2 - 48 * b * e ^ 3

/-- The exponent of `K₁ = Γ(1 + 3ε) Γ(1 + 2ε)² Γ(1 - ε) / (Γ(1 + ε)² Γ(1 + 4ε))` over `ε²`. -/
noncomputable def i12PolyX1 (p a b e : ℂ) : ℂ := 8 * a * e - 2 / 5 * p ^ 4 * e ^ 2 + 144 * b * e ^ 3

/-- The exponent of `K₂ = Γ(1 + 3ε) Γ(1 - ε)² Γ(1 + 2ε) / Γ(1 + ε)³` over `ε²`. -/
noncomputable def i12PolyX2 (p a b e : ℂ) : ℂ :=
  p ^ 2 - 10 * a * e + 4 / 15 * p ^ 4 * e ^ 2 - 54 * b * e ^ 3

/-- The exponent of `K₃ = Γ(1 + 3ε) Γ(1 - 2ε) / (Γ(1 + ε)² Γ(1 - ε))` over `ε²`. -/
noncomputable def i12PolyX3 (p a b e : ℂ) : ℂ :=
  5 / 6 * p ^ 2 - 6 * a * e + 47 / 180 * p ^ 4 * e ^ 2 - 42 * b * e ^ 3

/-- The exponent of `K₄ = Γ(1 + 3ε) Γ(1 - 2ε) / Γ(1 + ε)` over `ε²`. -/
noncomputable def i12PolyX4 (p a b e : ℂ) : ℂ :=
  p ^ 2 - 6 * a * e + 4 / 15 * p ^ 4 * e ^ 2 - 42 * b * e ^ 3

/-- `D_c = 2(2e - 1)²(1 - e)(2 - e)`. -/
noncomputable def i12Dc (e : ℂ) : ℂ := 2 * (2 * e - 1) ^ 2 * (1 - e) * (2 - e)

/-- `N₁ = 2((4e - 1)(4e - 2)(2 - e) - e(2 - 3e)(2e - 1)²)`. -/
noncomputable def i12N1 (e : ℂ) : ℂ :=
  2 * ((4 * e - 1) * (4 * e - 2) * (2 - e) - e * (2 - 3 * e) * (2 * e - 1) ^ 2)

/-- `N₂ = e(2e - 1)((2 - e) - (2 - 3e)(2e - 1))`. -/
noncomputable def i12N2 (e : ℂ) : ℂ := e * (2 * e - 1) * ((2 - e) - (2 - 3 * e) * (2 * e - 1))

/-- `N₃ = 2(2 - 3e)(2e - 1)²(2 - e)`. -/
noncomputable def i12N3 (e : ℂ) : ℂ := 2 * (2 - 3 * e) * (2 * e - 1) ^ 2 * (2 - e)

/-- `D = 3(3e - 1)(3e - 2) D_c`. -/
noncomputable def i12D (e : ℂ) : ℂ := 3 * (3 * e - 1) * (3 * e - 2) * i12Dc e

/-- The expansion of the remainder combination through `e⁴`. -/
noncomputable def i12PolyRL (p a b l e : ℂ) : ℂ :=
  (-11 / 3 * p ^ 2 - 8 * l ^ 2 - 71 / 6) * e + (2 / 3 * p ^ 2 * l + 17 / 6 * p ^ 2 + 8 * a + 4
    * l ^ 2 + 179 / 36) * e ^ 2 + (-7 / 60 * p ^ 4 - 10 / 3 * p ^ 2 * l ^ 2 - 1 / 3 * p ^ 2 * l
    - 401 / 12 * p ^ 2 + 2 * a - 8 / 3 * l ^ 4 + 4 * l ^ 2 + 47233 / 216) * e ^ 3 + (3 / 10 * p
    ^ 4 * l - 19 / 40 * p ^ 4 - 34 / 3 * p ^ 2 * a + 4 / 9 * p ^ 2 * l ^ 3 + 5 / 3 * p ^ 2 * l ^
    2 + 1535 / 3 * p ^ 2 * l - 7447 / 24 * p ^ 2 - 16 * a * l ^ 2 - 3709 / 3 * a - 120 * b + 4 /
    3 * l ^ 4 + 4 * l ^ 2 + 1810835 / 1296) * e ^ 4


