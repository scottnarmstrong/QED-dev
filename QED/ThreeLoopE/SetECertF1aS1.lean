/-- The `f1aS1` reduction at every dimension `d` where the common denominator `q(d)` is nonzero: for
every family of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`,
the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f1aS1_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f1aS1Den ≠ 0) (I : (Fin f1a.nProp → ℤ) → K → K)
    (hI : f1a.IBPHolds I d) (hz : f1a.ZeroSectors I d) :
    (f1aS1Target.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
      (f1aS1Masters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f1aS1Den * I (toVec f1a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f1aS1Den) (T := f1aS1Target) (Ms := f1aS1Ms)
    (tl := f1aS1TargetL) (ml := f1aS1MsL) f1aS1MT_ok f1aS1Fac_ok f1aS1ZS_eq f1aS1Blocks_ok
    f1aS1Claim_range f1aS1TargetL_lt f1aS1MsL_lt f1aS1Bound f1aS1_parts I d hI hz hd
  exact h

/-- **The `f1aS1` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f1aS1_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f1aS1Den ≠ 0 ∧
      ∀ I : (Fin f1a.nProp → ℤ) → K → K, f1a.IBPHolds I d → f1a.ZeroSectors I d →
        (f1aS1Target.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
          (f1aS1Masters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f1aS1Den * I (toVec f1a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f1aS1Den_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f1aS1_reduction_of_den d (hs d hd) I hI hz⟩⟩

