/-!
# Set (e) of `A₁⁽⁶⁾`: coefficient times master, part A

For each master `I_j` of set (e) (here `I₁`, `I₂`, `I₃`, `I₄`, `I₅`, `I₆`, `I₇`, `I₈`;
the others are in
`QED.ThreeLoopE.SetEMastersProductsB`), with target `Lⱼ` and truncation order `pⱼ + 1`, write the
coefficient as `cⱼ = ε⁻¹ ^ pⱼ Tⱼ + ε ^ (mⱼ + 1) Qⱼ` (`QED.ThreeLoopE.setECoeffIj_eq`) and
`Lⱼ = ε⁻¹ ^ mⱼ Λⱼ` (`QED.ThreeLoopE.setELamIj`). Then
`cⱼ (Lⱼ + ε ^ (pⱼ + 1) r) = Sⱼ + ε (Aⱼ + Bⱼ r)`, where the Laurent polynomial `Sⱼ`
(`QED.ThreeLoopE.setESIj`) is the part of order `≤ 0` of `ε⁻¹ ^ pⱼ Tⱼ Lⱼ` and `Aⱼ`, `Bⱼ` are
analytic at `0` (`QED.ThreeLoopE.setECoeffIj_mul_eq`). Hence, under the input
`HasTruncLaurent f Lⱼ (pⱼ + 1)`, `cⱼ f = Sⱼ + ε g` near `0` with `g` analytic at `0`
(`QED.ThreeLoopE.setECoeffIj_mul`). The polynomials are generated by a script.
-/

@[expose] public section

open Real QED.Polylog Filter Topology QED.ThreeLoopD

namespace QED.ThreeLoopE

/-- `ε ^ 0` times the target of `I₁`, a polynomial. -/
noncomputable def setELamI1 (_ε : ℂ) : ℂ :=
  (-1 / 2 * (π : ℂ) ^ (2 : ℕ) * (zeta3 : ℂ) + 5 * (zeta5 : ℂ))

/-- The part of order `≤ 0` of the coefficient of `I₁` times its target. -/
noncomputable def setESI1 (_ε : ℂ) : ℂ :=
  (1 / 6 * (π : ℂ) ^ (2 : ℕ) * (zeta3 : ℂ) - 5 / 3 * (zeta5 : ℂ))

/-- The part of order `> 0`, divided by `ε`. -/
noncomputable def setEPI1 (_ε : ℂ) : ℂ :=
  0

/-- The regular part of the product, without the remainder of the master. -/
noncomputable def setEAI1 (ε : ℂ) : ℂ :=
  setEPI1 ε + setEQI1 ε * setELamI1 ε

/-- The factor of the remainder of the master. -/
noncomputable def setEBI1 (ε : ℂ) : ℂ :=
  setETI1 ε + ε ^ (1 : ℕ) * setEQI1 ε

/-- The coefficient of `I₁` times its truncated expansion plus `ε ^ 1 r`. -/
theorem setECoeffI1_mul_eq {ε : ℂ} (hε : ε ≠ 0) (hU : setEUI1 ε ≠ 0) (r : ℂ) :
    setECoeffI1 ε * (setELaurentI1 ε + ε ^ (1 : ℕ) * r) =
      setESI1 ε + ε * (setEAI1 ε + setEBI1 ε * r) := by
  rw [setECoeffI1_eq hε hU]
  simp only [setEAI1, setEBI1, setELaurentI1, setESI1, setEPI1, setELamI1, setETI1]
  field_simp
  ring

theorem analyticAt_setEAI1 : AnalyticAt ℂ setEAI1 0 := by
  have hQ := analyticAt_setEQI1
  unfold setEAI1 setEPI1 setELamI1; fun_prop

theorem analyticAt_setEBI1 : AnalyticAt ℂ setEBI1 0 := by
  have hQ := analyticAt_setEQI1
  unfold setEBI1 setETI1; fun_prop

/-- **The coefficient of `I₁` times the master**: `c f = S + ε g` near `0`, with `g`
analytic at `0`. -/
theorem setECoeffI1_mul {f : ℂ → ℂ} (hf : HasTruncLaurent f setELaurentI1 1) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧
      ∀ᶠ ε in 𝓝[≠] (0 : ℂ), setECoeffI1 ε * f ε = setESI1 ε + ε * g ε :=
  hf.coeff_mul analyticAt_setEAI1 analyticAt_setEBI1
    (analyticAt_setEUI1 0).continuousAt (by rw [setEUI1_zero]; exact one_ne_zero)
    fun _ hε hU r => setECoeffI1_mul_eq hε hU r

