module

public import QED.ThreeLoopE.SetECertF3eFamily
public import QED.ThreeLoopE.SetECertF3b
public import QED.ThreeLoopE.SetECertSymTerms

/-!
# The `f3e` reduction of set (e), from its mirror `f3b`

The mirror (reversal of the electron line) of self-energy topology `f3e` is topology `f3b`: a change
of loop momenta maps the denominators of `QED.ThreeLoopE.SetECert.f3e` to those of
`QED.ThreeLoopE.SetECert.f3b`, `D₁ ↦ D₂`, `D₂ ↦ D₃`, `D₃ ↦ D₁`, `D₄ ↦ D₆`, `D₅ ↦ D₇`, `D₆ ↦ D₅`, `D₇
↦ D₄`, `D₈ ↦ D₉`, `D₉ ↦ D₈`, and the projected combination `Y - (d - 1)² T₁` of the `f3e` diagrams
to that of the `f3b` diagrams term by term: relabelling the index vectors of `f3eTarget` by
`permLabel f3eSigma` gives exactly `f3bTarget` (`f3eTarget_map`), and likewise for the Kira masters
(`f3eMasters_map`). The reduction of `f3e` is therefore the `f3b` certificate, for values `I` of the
`f3e` integrals that equal the values `J` of the relabelled `f3b` integrals.

## Main statements

* `QED.ThreeLoopE.SetECert.f3e_reduction_of_den`: at every `d` with `q(d) ≠ 0` (`q = f3bDen`), for
  every family of values `J` satisfying the hypotheses of `f3b_reduction_of_den` and every `I` with
  `I(ν) = J(permLabel f3eSigma ν)`, the `f3e` target combination equals the certified combination of
  the `f3e` Kira masters.
* `QED.ThreeLoopE.SetECert.f3e_reduction`: the same off a finite set of `d`.

Generated by `genmirror.py` (offline cache `setecert/fams`); do not edit. Integers are written as
`.ofNat n` and `.negSucc n` (`= -n - 1`).
-/

@[expose] public section

namespace QED.ThreeLoopE.SetECert

open QED.Algebra.IBPCert QED.Algebra.IBPCert.Sector

/-- The relabelling of `f3b` index vectors to `f3e` index vectors (generated). -/
def f3eSigmaInv : List ℕ := [1, 2, 0, 5, 6, 4, 3, 8, 7]

/-- The target combination of `f3e`: the projected combination `Y - (d - 1)² T₁` of the `f3e`
diagrams (integrals in scaleless sectors dropped), written as the relabelling of `f3bTarget`. That
this is term by term the survey's FORM projection of the `f3e` diagrams was checked offline
(`mirror.py`: all labels and coefficients agree). -/
noncomputable def f3eTarget : List (List Int × List Int) :=
  f3bTarget.map fun t => (permLabel f3eSigmaInv t.1, t.2)

/-- The Kira masters of `f3e` with their numerators: the relabelled `f3bMasters`. -/
noncomputable def f3eMasters : List (List Int × List Int) :=
  f3bMasters.map fun t => (permLabel f3eSigmaInv t.1, t.2)

/-- The relabelling of `f3e` index vectors to `f3b` index vectors (generated). -/
def f3eSigma : List ℕ := [2, 0, 1, 6, 5, 3, 4, 8, 7]

theorem f3eTarget_map :
    f3eTarget.map (fun t => (permLabel f3eSigma t.1, t.2)) = f3bTarget := by
  decide +kernel

theorem f3eMasters_map :
    f3eMasters.map (fun t => (permLabel f3eSigma t.1, t.2)) = f3bMasters := by
  decide +kernel

/-- The `f3e` reduction at every `d` with `q(d) ≠ 0`, from the `f3b` certificate: for values `J` of
the `f3b` integrals satisfying the IBP relations, the scaleless sectors and the symmetry entries of
`f3b` at `d`, and values `I` of the `f3e` integrals with `I(ν) = J(permLabel f3eSigma ν)`, the `f3e`
target combination equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the `f3e` Kira masters. -/
theorem f3e_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f3bDen ≠ 0) (I : (Fin f3e.nProp → ℤ) → K → K)
    (J : (Fin f3b.nProp → ℤ) → K → K) (hJ : f3b.IBPHolds J d)
    (hz : f3b.ZeroSectors J d)
    (hs : ∀ e ∈ f3bSyms, f3b.SymHoldsAt J d e.1 e.2.1)
    (hx : ∀ ν : List ℤ,
      I (toVec f3e.nProp ν) d = J (toVec f3b.nProp (permLabel f3eSigma ν)) d) :
    (f3eTarget.map fun t => Poly.eval d t.2 * I (toVec f3e.nProp t.1) d).sum =
      (f3eMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f3bDen * I (toVec f3e.nProp m.1) d).sum := by
  have h1 := sum_relabel f3e.nProp f3b.nProp f3eSigma I J d (Poly.eval d) f3eTarget
    fun t _ => hx t.1
  have h2 := sum_relabel f3e.nProp f3b.nProp f3eSigma I J d
    (fun p => Poly.eval d p / Poly.eval d f3bDen) f3eMasters fun t _ => hx t.1
  rw [f3eTarget_map] at h1
  rw [f3eMasters_map] at h2
  exact h1.trans ((f3b_reduction_of_den d hd J hJ hz hs).trans h2.symm)

/-- **The `f3e` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and the `f3e` target
combination equals the certified combination of its Kira masters, for values `I` of the `f3e`
integrals equal to relabelled values `J` of `f3b` integrals satisfying the hypotheses of the `f3b`
certificate. -/
theorem f3e_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f3bDen ≠ 0 ∧
      ∀ (I : (Fin f3e.nProp → ℤ) → K → K) (J : (Fin f3b.nProp → ℤ) → K → K),
        f3b.IBPHolds J d → f3b.ZeroSectors J d →
        (∀ e ∈ f3bSyms, f3b.SymHoldsAt J d e.1 e.2.1) →
        (∀ ν : List ℤ,
          I (toVec f3e.nProp ν) d = J (toVec f3b.nProp (permLabel f3eSigma ν)) d) →
        (f3eTarget.map fun t => Poly.eval d t.2 * I (toVec f3e.nProp t.1) d).sum =
          (f3eMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f3bDen * I (toVec f3e.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f3bDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I J hJ hz hsy hx =>
    f3e_reduction_of_den d (hs d hd) I J hJ hz hsy hx⟩⟩

end QED.ThreeLoopE.SetECert
