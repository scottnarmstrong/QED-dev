/-!
# Set (e), master `I₁₀`: the expansion of the face integral `G₀`

By `QED.ThreeLoopE.i10G0_eq_closed`, `ε (1 - ε) G₀ = N` on `‖ε‖ < 1/20`, `re ε > 0`, with

  `N = Γ(1 + ε) (Γ(1 - ε)² Γ(3 - 5ε) / (Γ(2 - 2ε) Γ(3 - 4ε)) - Γ(1 - ε) / (1 - ε))`
  (`QED.ThreeLoopE.i10G0N`).

Both sides are analytic on `‖ε‖ < 1/40` (`QED.ThreeLoopE.analyticOnNhd_i10G0`), so they agree
there (`QED.ThreeLoopE.i10G0_mul_eq_N`). With `D = (1 - 2ε)(2 - 4ε)(1 - 4ε)(1 - ε)`,
`N D = E_a (E_b q₁ - q₂)`, `E_a = Γ(1 + ε) Γ(1 - ε)`, `E_b = Γ(1 - ε) Γ(1 - 5ε) / (Γ(1 - 2ε)
Γ(1 - 4ε))` (balanced, so `exp(ε² (…))`), `q₁ = (2 - 5ε)(1 - 5ε)(1 - ε)`,
`q₂ = (1 - 2ε)(2 - 4ε)(1 - 4ε)`. Truncating the exponentials (as in
`QED.ThreeLoopE.SetEMastersI10Wire`) and the polynomial identity `QED.ThreeLoopE.i10G0_key`
(generated by `scripts/numerics/three_loop_masters/i10g0gen.py`, checked by `ring`) give

  `G₀ = -1/2 + (π²/2 - 5) ε + (2π²/3 + 18ζ₃ - 28) ε² + (143π⁴/120 - 11π²/6 + 27ζ₃ - 127) ε³
    + O(ε⁴)` (`QED.ThreeLoopE.hasTruncLaurent_i10G0`),

in agreement with the direct Taylor coefficients of
`scripts/numerics/three_loop_masters/i10taylor.py`.

## Main results

* `QED.ThreeLoopE.i10G0_mul_eq_N`, `QED.ThreeLoopE.hasTruncLaurent_i10G0`.
-/

@[expose] public section

open Complex Filter Topology Metric Real QED.Polylog QED.ThreeLoopD

namespace QED.ThreeLoopE

/-- `N = Γ(1 + ε) (Γ(1 - ε)² Γ(3 - 5ε) / (Γ(2 - 2ε) Γ(3 - 4ε)) - Γ(1 - ε) / (1 - ε))`. -/
noncomputable def i10G0N (ε : ℂ) : ℂ :=
  Gamma (1 + ε) * (Gamma (1 - ε) ^ 2 * Gamma (3 - 5 * ε) / (Gamma (2 - 2 * ε) *
    Gamma (3 - 4 * ε)) - Gamma (1 - ε) / (1 - ε))

theorem i10G0_re {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (a b : ℝ) (hb : |b| ≤ 5) (ha : 1 ≤ a) :
    0 < ((a : ℂ) + b * ε).re := by
  have hr := abs_le.mp ((abs_re_le_norm ε).trans hε.le)
  have hb' := abs_le.mp hb
  simp only [add_re, ofReal_re, mul_re, ofReal_im, zero_mul, sub_zero]
  nlinarith

theorem i10G0_ne {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (a b : ℝ) (hb : |b| ≤ 5) (ha : 1 ≤ a) :
    (a : ℂ) + b * ε ≠ 0 := fun h => by
  have := i10G0_re hε a b hb ha
  rw [h, zero_re] at this
  exact lt_irrefl _ this

theorem i10G0_dGamma {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (a b : ℝ) (hb : |b| ≤ 5) (ha : 1 ≤ a) :
    DifferentiableAt ℂ (fun e : ℂ => Gamma ((a : ℂ) + b * e)) ε := by
  have hre := i10G0_re hε a b hb ha
  have hG : DifferentiableAt ℂ Complex.Gamma ((a : ℂ) + b * ε) :=
    differentiableAt_Gamma _ fun m h => by
      rw [h] at hre
      simp at hre
      linarith [(m.cast_nonneg : (0 : ℝ) ≤ m)]
  exact hG.comp ε (by fun_prop)

theorem i10G0_GammaNe {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (a b : ℝ) (hb : |b| ≤ 5) (ha : 1 ≤ a) :
    Gamma ((a : ℂ) + b * ε) ≠ 0 :=
  Gamma_ne_zero_of_re_pos (i10G0_re hε a b hb ha)

theorem differentiableAt_i10G0N {ε : ℂ} (hε : ‖ε‖ < 1 / 40) : DifferentiableAt ℂ i10G0N ε := by
  have c : ∀ a b : ℝ, ∀ x : ℂ, x = (a : ℂ) + b * ε →
      (fun e : ℂ => Gamma x) = fun e => Gamma x := fun _ _ _ _ => rfl
  have d1 := i10G0_dGamma hε 1 1 (by norm_num) le_rfl
  have d2 := i10G0_dGamma hε 1 (-1) (by norm_num) le_rfl
  have d3 := i10G0_dGamma hε 3 (-5) (by norm_num) (by norm_num)
  have d4 := i10G0_dGamma hε 2 (-2) (by norm_num) (by norm_num)
  have d5 := i10G0_dGamma hε 3 (-4) (by norm_num) (by norm_num)
  have n4 := i10G0_GammaNe hε 2 (-2) (by norm_num) (by norm_num)
  have n5 := i10G0_GammaNe hε 3 (-4) (by norm_num) (by norm_num)
  have n1 := i10G0_ne hε 1 (-1) (by norm_num) le_rfl
  push_cast at d1 d2 d3 d4 d5 n4 n5 n1
  simp only [one_mul, neg_mul, ← sub_eq_add_neg] at d1 d2 d3 d4 d5 n4 n5 n1
  unfold i10G0N
  exact d1.mul (((d2.pow 2).mul d3).div (d4.mul d5) (mul_ne_zero n4 n5) |>.sub
    (d2.div ((differentiableAt_const _).sub differentiableAt_id) n1))

theorem analyticOnNhd_i10G0N : AnalyticOnNhd ℂ i10G0N (ball 0 (1 / 40)) := fun ε hε =>
  DifferentiableOn.analyticAt (fun ε' hε' => (differentiableAt_i10G0N
    (by simpa using hε')).differentiableWithinAt) (isOpen_ball.mem_nhds hε)

theorem i10G0Cl_mul_eq {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (h0 : ε ≠ 0) :
    ε * (1 - ε) * i10G0Cl ε = i10G0N ε := by
  have n4 := i10G0_GammaNe hε 2 (-2) (by norm_num) (by norm_num)
  have n5 := i10G0_GammaNe hε 3 (-4) (by norm_num) (by norm_num)
  have n1 := i10G0_ne hε 1 (-1) (by norm_num) le_rfl
  push_cast at n4 n5 n1
  simp only [one_mul, neg_mul, ← sub_eq_add_neg] at n4 n5 n1
  have g1 : Gamma (1 - ε + (1 - ε)) = Gamma (2 - 2 * ε) := by congr 1; ring
  have g2 : Gamma (ε + (3 - 5 * ε)) = Gamma (3 - 4 * ε) := by congr 1; ring
  have g3 : Gamma (ε + (1 - ε)) = 1 := by rw [add_sub_cancel, Complex.Gamma_one]
  have g4 : Gamma ε = Gamma (1 + ε) / ε := by
    rw [eq_div_iff h0, add_comm, Gamma_add_one _ h0]; ring
  simp only [i10G0Cl, i10G0N, i9Beta]
  rw [g1, g2, g3, g4]
  field_simp

/-- **The continuation identity**: `ε (1 - ε) G₀ = N` on `‖ε‖ < 1/40`. -/
theorem i10G0_mul_eq_N : Set.EqOn (fun ε => ε * (1 - ε) * i10G0 ε) i10G0N (ball 0 (1 / 40)) := by
  have hF : AnalyticOnNhd ℂ (fun ε => ε * (1 - ε) * i10G0 ε) (ball 0 (1 / 40)) :=
    fun ε hε => by
      have := analyticOnNhd_i10G0 ε hε
      fun_prop
  refine hF.eqOn_of_preconnected_of_eventuallyEq analyticOnNhd_i10G0N
    (convex_ball _ _).isPreconnected (z₀ := ((1 / 80 : ℝ) : ℂ)) (by simp; norm_num) ?_
  have hO : IsOpen {e : ℂ | ‖e‖ < 1 / 40 ∧ 0 < e.re} :=
    (isOpen_lt continuous_norm continuous_const).inter (isOpen_lt continuous_const continuous_re)
  filter_upwards [hO.mem_nhds (by simp; norm_num)] with e he
  obtain ⟨h1, h2⟩ := he
  have h0 : e ≠ 0 := fun h => by rw [h, zero_re] at h2; exact lt_irrefl _ h2
  show e * (1 - e) * i10G0 e = i10G0N e
  rw [i10G0_eq_closed (by linarith) h2, i10G0Cl_mul_eq h1 h0]

/-! ### The truncation -/

/-- `Yₐ = Lₜ(ε) - Lₜ(-ε)`. -/
noncomputable def i10G0Ya (ε : ℂ) : ℂ := i10Lt (1 * ε) - i10Lt ((-1) * ε)

/-- `Y_b = -Lₜ(-ε) - 5⁵ Lₜ(-5ε) + 2⁵ Lₜ(-2ε) + 4⁵ Lₜ(-4ε)`. -/
noncomputable def i10G0Yb (ε : ℂ) : ℂ :=
  -i10Lt ((-1) * ε) - 3125 * i10Lt ((-5) * ε) + 32 * i10Lt ((-2) * ε) +
    1024 * i10Lt ((-4) * ε)

theorem i10G0_norm_lt {ε : ℂ} (hε : ‖ε‖ < 1 / 40) (a : ℂ) (ha : ‖a‖ ≤ 5) : ‖a * ε‖ < 1 := by
  rw [norm_mul]; nlinarith [norm_nonneg a, norm_nonneg ε]

theorem i10G0Ea_eq {ε : ℂ} (hε : ‖ε‖ < 1 / 40) :
    Gamma (1 + 1 * ε) * Gamma (1 + (-1) * ε) = cexp (ε ^ 2 * ((π : ℂ) ^ 2 / 6 + 0 * ε +
      (π : ℂ) ^ 4 / 180 * ε ^ 2 + ε ^ 3 * i10G0Ya ε)) := by
  rw [i10_Gamma_eq_exp (i10G0_norm_lt hε 1 (by norm_num)),
    i10_Gamma_eq_exp (i10G0_norm_lt hε (-1) (by norm_num)), ← Complex.exp_add, i10G0Ya]
  congr 1
  ring

theorem i10G0Eb_eq {ε : ℂ} (hε : ‖ε‖ < 1 / 40) :
    Gamma (1 + (-1) * ε) * Gamma (1 + (-5) * ε) / (Gamma (1 + (-2) * ε) * Gamma (1 + (-4) * ε)) =
      cexp (ε ^ 2 * ((π : ℂ) ^ 2 / 2 + 18 * (zeta3 : ℂ) * ε + 59 / 60 * (π : ℂ) ^ 4 * ε ^ 2 +
        ε ^ 3 * i10G0Yb ε)) := by
  rw [i10_Gamma_eq_exp (i10G0_norm_lt hε (-1) (by norm_num)),
    i10_Gamma_eq_exp (i10G0_norm_lt hε (-5) (by norm_num)),
    i10_Gamma_eq_exp (i10G0_norm_lt hε (-2) (by norm_num)),
    i10_Gamma_eq_exp (i10G0_norm_lt hε (-4) (by norm_num)), ← Complex.exp_add,
    ← Complex.exp_add, ← Complex.exp_sub, i10G0Yb]
  congr 1
  ring

/-- `(E_a - E_{p,a}) / ε⁵`. -/
noncomputable def i10G0da (ε : ℂ) : ℂ :=
  i10dE ε ((π : ℂ) ^ 2 / 6) 0 ((π : ℂ) ^ 4 / 180) (i10G0Ya ε)
    (QED.DimReg.expRem3 (ε ^ 2 * ((π : ℂ) ^ 2 / 6 + 0 * ε + (π : ℂ) ^ 4 / 180 * ε ^ 2 +
      ε ^ 3 * i10G0Ya ε)))

/-- `(E_b - E_{p,b}) / ε⁵`. -/
noncomputable def i10G0db (ε : ℂ) : ℂ :=
  i10dE ε ((π : ℂ) ^ 2 / 2) (18 * (zeta3 : ℂ)) (59 / 60 * (π : ℂ) ^ 4) (i10G0Yb ε)
    (QED.DimReg.expRem3 (ε ^ 2 * ((π : ℂ) ^ 2 / 2 + 18 * (zeta3 : ℂ) * ε +
      59 / 60 * (π : ℂ) ^ 4 * ε ^ 2 + ε ^ 3 * i10G0Yb ε)))

theorem analyticAt_i10G0da : AnalyticAt ℂ i10G0da 0 := by
  have h1 := analyticAt_i10Lt_mul 1
  have hm := analyticAt_i10Lt_mul (-1)
  exact analyticAt_i10dE (by unfold i10G0Ya; fun_prop)

theorem analyticAt_i10G0db : AnalyticAt ℂ i10G0db 0 := by
  have h1 := analyticAt_i10Lt_mul (-1)
  have h2 := analyticAt_i10Lt_mul (-2)
  have h4 := analyticAt_i10Lt_mul (-4)
  have h5 := analyticAt_i10Lt_mul (-5)
  exact analyticAt_i10dE (by unfold i10G0Yb; fun_prop)

/-- The truncation of `E_a`. -/
noncomputable def i10G0Pa (ε : ℂ) : ℂ := i10Ep ε ((π : ℂ) ^ 2 / 6) 0 ((π : ℂ) ^ 4 / 180)

/-- The truncation of `E_b`. -/
noncomputable def i10G0Pb (ε : ℂ) : ℂ :=
  i10Ep ε ((π : ℂ) ^ 2 / 2) (18 * (zeta3 : ℂ)) (59 / 60 * (π : ℂ) ^ 4)

/-- `q₁ = (2 - 5ε)(1 - 5ε)(1 - ε)`. -/
noncomputable def i10G0q1 (ε : ℂ) : ℂ := (2 - 5 * ε) * (1 - 5 * ε) * (1 - ε)

/-- `q₂ = (1 - 2ε)(2 - 4ε)(1 - 4ε)`. -/
noncomputable def i10G0q2 (ε : ℂ) : ℂ := (1 - 2 * ε) * (2 - 4 * ε) * (1 - 4 * ε)

theorem i10G0N_mul_eq {ε : ℂ} (hε : ‖ε‖ < 1 / 40) :
    i10G0N ε * (i10G0q2 ε * (1 - ε)) =
      (i10G0Pa ε + ε ^ 5 * i10G0da ε) *
        ((i10G0Pb ε + ε ^ 5 * i10G0db ε) * i10G0q1 ε - i10G0q2 ε) := by
  have ha : Gamma (1 + 1 * ε) * Gamma (1 + (-1) * ε) = i10G0Pa ε + ε ^ 5 * i10G0da ε := by
    rw [i10G0Ea_eq hε]; exact i10_exp_trunc ..
  have hb : Gamma (1 + (-1) * ε) * Gamma (1 + (-5) * ε) /
      (Gamma (1 + (-2) * ε) * Gamma (1 + (-4) * ε)) = i10G0Pb ε + ε ^ 5 * i10G0db ε := by
    rw [i10G0Eb_eq hε]; exact i10_exp_trunc ..
  rw [← ha, ← hb]
  have hl := fun (b : ℝ) (hb : |b| ≤ 5) => i10G0_ne hε 1 b hb le_rfl
  have k1 := hl (-1) (by norm_num)
  have k2 := hl (-2) (by norm_num)
  have k4 := hl (-4) (by norm_num)
  have k5 := hl (-5) (by norm_num)
  have m2 := i10G0_GammaNe hε 1 (-2) (by norm_num) le_rfl
  have m4 := i10G0_GammaNe hε 1 (-4) (by norm_num) le_rfl
  push_cast at k1 k2 k4 k5 m2 m4
  have j2 : (2 : ℂ) - 4 * ε ≠ 0 := by
    rw [show (2 : ℂ) - 4 * ε = 2 * (1 + (-2) * ε) by ring]; exact mul_ne_zero two_ne_zero k2
  have g1 : Gamma (1 + ε) = Gamma (1 + 1 * ε) := by rw [one_mul]
  have g2 : Gamma (1 - ε) = Gamma (1 + (-1) * ε) := by congr 1; ring
  have g3 : Gamma (2 - 2 * ε) = (1 + (-2) * ε) * Gamma (1 + (-2) * ε) := by
    rw [show (2 : ℂ) - 2 * ε = (1 + (-2) * ε) + 1 by ring, Gamma_add_one _ k2]
  have g4 : Gamma (3 - 4 * ε) = (2 - 4 * ε) * (1 + (-4) * ε) * Gamma (1 + (-4) * ε) := by
    rw [show (3 : ℂ) - 4 * ε = ((1 + (-4) * ε) + 1) + 1 by ring, Gamma_add_one _ (by
      rw [show (1 : ℂ) + (-4) * ε + 1 = 2 - 4 * ε by ring]; exact j2), Gamma_add_one _ k4]
    ring
  have g5 : Gamma (3 - 5 * ε) = (2 - 5 * ε) * (1 + (-5) * ε) * Gamma (1 + (-5) * ε) := by
    have j5 : (1 : ℂ) + (-5) * ε + 1 ≠ 0 := by
      have := hl (-5 / 2) (by norm_num [abs_div])
      push_cast at this
      rw [show (1 : ℂ) + (-5) * ε + 1 = 2 * (1 + (-5 / 2) * ε) by ring]
      exact mul_ne_zero two_ne_zero this
    rw [show (3 : ℂ) - 5 * ε = ((1 + (-5) * ε) + 1) + 1 by ring, Gamma_add_one _ j5,
      Gamma_add_one _ k5]
    ring
  have k1' : (1 : ℂ) - ε ≠ 0 := by rw [show (1 : ℂ) - ε = 1 + (-1) * ε by ring]; exact k1
  have key : ∀ A B C D F a b c s e : ℂ, C ≠ 0 → D ≠ 0 → a ≠ 0 → b ≠ 0 → c ≠ 0 → 1 - e ≠ 0 →
      A * (B ^ 2 * (s * F) / ((a * C) * (b * c * D)) - B / (1 - e)) * (a * b * c * (1 - e)) =
        A * B * ((B * F / (C * D)) * (s * (1 - e)) - a * b * c) := by
    intros; field_simp
  have e1 : i10G0q2 ε * (1 - ε) = (1 + (-2) * ε) * (2 - 4 * ε) * (1 + (-4) * ε) * (1 - ε) := by
    unfold i10G0q2; ring
  have e2 : i10G0q1 ε = ((2 - 5 * ε) * (1 + (-5) * ε)) * (1 - ε) := by unfold i10G0q1; ring
  have e3 : i10G0q2 ε = (1 + (-2) * ε) * (2 - 4 * ε) * (1 + (-4) * ε) := by unfold i10G0q2; ring
  simp only [i10G0N]
  rw [g1, g2, g3, g4, g5, e1, e2, e3]
  exact key _ _ _ _ _ _ _ _ _ _ m2 m4 k2 j2 k4 k1'

/-! ### The polynomial identity and the expansion -/

/-- **The target expansion of `G₀`** through `ε³`. -/
noncomputable def i10G0Laurent (ε : ℂ) : ℂ :=
  -1 / 2 + ((π : ℂ) ^ 2 / 2 - 5) * ε + (2 / 3 * (π : ℂ) ^ 2 + 18 * (zeta3 : ℂ) - 28) * ε ^ 2 +
    (143 / 120 * (π : ℂ) ^ 4 - 11 / 6 * (π : ℂ) ^ 2 + 27 * (zeta3 : ℂ) - 127) * ε ^ 3

/-- The polynomial `(P_a (P_b q₁ - q₂) - ε (1 - ε) L D) / ε⁵`
(generated by `scripts/numerics/three_loop_masters/i10g0gen.py`). -/
noncomputable def i10G0W (ε : ℂ) : ℂ :=
  (32 / 9 * (π : ℂ) ^ 4 + 6 * (π : ℂ) ^ 2 * (zeta3 : ℂ) - 100 / 3 * (π : ℂ) ^ 2
    - 72 * (zeta3 : ℂ) - 1056)
  + (7 / 18 * (π : ℂ) ^ 6 - 2431 / 60 * (π : ℂ) ^ 4 - 51 * (π : ℂ) ^ 2 * (zeta3 : ℂ)
    + 169 * (π : ℂ) ^ 2 - 144 * (zeta3 : ℂ) + 6318) * ε
  + (-119 / 36 * (π : ℂ) ^ 6 + 7 / 10 * (π : ℂ) ^ 4 * (zeta3 : ℂ) + 11059 / 90 * (π : ℂ) ^ 4
    + 120 * (π : ℂ) ^ 2 * (zeta3 : ℂ) - 288 * (π : ℂ) ^ 2 + 1584 * (zeta3 : ℂ) - 13504) * ε ^ 2
  + (931 / 21600 * (π : ℂ) ^ 8 + 70 / 9 * (π : ℂ) ^ 6 - 119 / 20 * (π : ℂ) ^ 4 * (zeta3 : ℂ)
    - 1859 / 15 * (π : ℂ) ^ 4 - 75 * (π : ℂ) ^ 2 * (zeta3 : ℂ) + 212 * (π : ℂ) ^ 2
    - 2232 * (zeta3 : ℂ) + 12312) * ε ^ 3
  + (-15827 / 43200 * (π : ℂ) ^ 8 - 175 / 36 * (π : ℂ) ^ 6 + 14 * (π : ℂ) ^ 4 * (zeta3 : ℂ)
    + 572 / 15 * (π : ℂ) ^ 4 - 176 / 3 * (π : ℂ) ^ 2 + 864 * (zeta3 : ℂ) - 4064) * ε ^ 4
  + (931 / 1080 * (π : ℂ) ^ 8 - 35 / 4 * (π : ℂ) ^ 4 * (zeta3 : ℂ)) * ε ^ 5
  + (-931 / 1728 * (π : ℂ) ^ 8) * ε ^ 6

/-- **The polynomial identity behind the expansion of `G₀`.** -/
theorem i10G0_key (ε : ℂ) :
    i10G0Pa ε * (i10G0Pb ε * i10G0q1 ε - i10G0q2 ε) -
      ε * (1 - ε) * i10G0Laurent ε * (i10G0q2 ε * (1 - ε)) = ε ^ 5 * i10G0W ε := by
  simp only [i10G0Pa, i10G0Pb, i10Ep, i10G0q1, i10G0q2, i10G0Laurent, i10G0W]
  ring

/-- **The expansion of `G₀`**: `G₀ = L + ε⁴ R` with `R` analytic at `0`. -/
theorem hasTruncLaurent_i10G0 : HasTruncLaurent i10G0 i10G0Laurent 4 := by
  refine ⟨fun ε => (i10G0W ε + i10G0da ε * (i10G0Pb ε * i10G0q1 ε - i10G0q2 ε) +
    i10G0Pa ε * i10G0db ε * i10G0q1 ε + ε ^ 5 * i10G0da ε * i10G0db ε * i10G0q1 ε) /
    ((1 - ε) * (i10G0q2 ε * (1 - ε))), ?_, ?_⟩
  · have hda := analyticAt_i10G0da
    have hdb := analyticAt_i10G0db
    have hW : AnalyticAt ℂ i10G0W 0 := by unfold i10G0W; fun_prop
    have hPa : AnalyticAt ℂ i10G0Pa 0 := by unfold i10G0Pa i10Ep; fun_prop
    have hPb : AnalyticAt ℂ i10G0Pb 0 := by unfold i10G0Pb i10Ep; fun_prop
    have hq1 : AnalyticAt ℂ i10G0q1 0 := by unfold i10G0q1; fun_prop
    have hq2 : AnalyticAt ℂ i10G0q2 0 := by unfold i10G0q2; fun_prop
    refine AnalyticAt.div (by fun_prop) (by fun_prop) ?_
    norm_num [i10G0q2]
  have hB : ∀ᶠ ε in 𝓝[≠] (0 : ℂ), ‖ε‖ < 1 / 40 :=
    nhdsWithin_le_nhds (Filter.mem_of_superset
      (Metric.ball_mem_nhds (0 : ℂ) (by norm_num : (0 : ℝ) < 1 / 40)) fun x hx => by simpa using hx)
  filter_upwards [hB, self_mem_nhdsWithin] with ε hε h0
  have h0 : ε ≠ 0 := h0
  have hN : ε * (1 - ε) * i10G0 ε = i10G0N ε := i10G0_mul_eq_N (by simpa using hε)
  have hND := i10G0N_mul_eq hε
  have key := i10G0_key ε
  have hl := fun (b : ℝ) (hb : |b| ≤ 5) => i10G0_ne hε 1 b hb le_rfl
  have k1 : (1 : ℂ) - ε ≠ 0 := by
    have := hl (-1) (by norm_num); push_cast at this
    rw [show (1 : ℂ) - ε = 1 + (-1) * ε by ring]; exact this
  have hq2 : i10G0q2 ε ≠ 0 := by
    have k2 := hl (-2) (by norm_num)
    have k4 := hl (-4) (by norm_num)
    push_cast at k2 k4
    simp only [i10G0q2]
    refine mul_ne_zero (mul_ne_zero ?_ ?_) ?_
    · rw [show (1 : ℂ) - 2 * ε = 1 + (-2) * ε by ring]; exact k2
    · rw [show (2 : ℂ) - 4 * ε = 2 * (1 + (-2) * ε) by ring]; exact mul_ne_zero two_ne_zero k2
    · rw [show (1 : ℂ) - 4 * ε = 1 + (-4) * ε by ring]; exact k4
  rw [← hN] at hND
  generalize i10G0da ε = da at *
  generalize i10G0db ε = db at *
  generalize i10G0Pa ε = Pa at *
  generalize i10G0Pb ε = Pb at *
  generalize i10G0q1 ε = q1 at *
  generalize i10G0q2 ε = q2 at *
  generalize i10G0W ε = W at *
  generalize i10G0Laurent ε = L at *
  generalize i10G0 ε = G at *
  have hE : ε * ((1 - ε) * (q2 * (1 - ε)) * G - ((1 - ε) * (q2 * (1 - ε)) * L +
      ε ^ 4 * (W + da * (Pb * q1 - q2) + Pa * db * q1 + ε ^ 5 * da * db * q1))) = 0 := by
    linear_combination hND + key
  have hE' := (mul_eq_zero.mp hE).resolve_left h0
  field_simp
  linear_combination hE'

end QED.ThreeLoopE
