/-- The `f2bV1p` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at
`d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2bV1p_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2bV1pDen ≠ 0) (I : (Fin f2b.nProp → ℤ) → K → K)
    (hI : f2b.IBPHolds I d) (hz : f2b.ZeroSectors I d) :
    (f2bV1pTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
      (f2bV1pMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2bV1pDen * I (toVec f2b.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2bV1pDen) (T := f2bV1pTarget) (Ms := f2bV1pMs)
    (tl := f2bV1pTargetL) (ml := f2bV1pMsL) f2bV1pMT_ok f2bV1pFac_ok f2bV1pZS_eq f2bV1pBlocks_ok
    f2bV1pClaim_range f2bV1pTargetL_lt f2bV1pMsL_lt f2bV1pBound f2bV1p_parts I d hI hz hd
  exact h

/-- **The `f2bV1p` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f2bV1p_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2bV1pDen ≠ 0 ∧
      ∀ I : (Fin f2b.nProp → ℤ) → K → K, f2b.IBPHolds I d → f2b.ZeroSectors I d →
        (f2bV1pTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
          (f2bV1pMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2bV1pDen * I (toVec f2b.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2bV1pDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f2bV1p_reduction_of_den d (hs d hd) I hI hz⟩⟩

end QED.ThreeLoopE.SetECert
