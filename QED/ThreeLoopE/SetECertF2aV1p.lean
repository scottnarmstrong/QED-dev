theorem f2aV1pB0_ok : f2aV1pB0.all (GBlock.ok f2aV1pCtx 2 3 5 1 f2aV1pQE f2aV1pYb f2aV1pNF
    f2aV1pZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2aV1pBlocks : List GBlock :=
    f2aV1pB0

theorem f2aV1pPart0 :
    partOk f2aV1pCtx f2aV1pDen (rGetL (chunks f2aV1pTargetL f2aV1pTarget) 0)
      (rGetL (chunks f2aV1pMsL f2aV1pMs) 0) f2aV1pBlocks 0 = true := by
  decide +kernel

theorem f2aV1pMT_ok : mtOk f2a f2aV1pCtx 98 10 = true := by decide +kernel

theorem f2aV1pFac_ok : facOk f2aV1pCtx f2aV1pFac f2aV1pQE f2aV1pNF = true := by decide +kernel

theorem f2aV1pZS_eq :
    f2aV1pZS = f2a.zeroSectors.map fun S => S.map fun a => (a, f2aV1pCtx.B ^ a) := by
  decide +kernel

theorem f2aV1pBlocks_ok :
    f2aV1pBlocks.all (GBlock.ok f2aV1pCtx 2 3 5 1 f2aV1pQE f2aV1pYb f2aV1pNF f2aV1pZS) = true := by
  simp only [f2aV1pBlocks, f2aV1pB0_ok]

theorem f2aV1pClaim_range :
    (f2aV1pTarget ++ f2aV1pMs).all (fun t => inRange 9 3 5 t.1) = true := by
  decide +kernel

theorem f2aV1pBound :
    (f2aV1pBlocks.map fun b => b.seeds.length).sum * (10 * (f2aV1pYb * 98)) +
      Poly.norm1 f2aV1pDen * (f2aV1pTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2aV1pMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2aV1pCtx.x0 := by
  decide +kernel

theorem f2aV1pTargetL_lt : f2aV1pTargetL.length < 1 := by decide +kernel

theorem f2aV1pMsL_lt : f2aV1pMsL.length < 1 := by decide +kernel

theorem f2aV1pDen_ne_zero : Poly.isZero f2aV1pDen = false := by decide +kernel

/-- The master list of the checker is the Kira masters plus the symmetry terms. -/
theorem f2aV1pMs_comb :
    LinComb.ofTerms (f2aV1pMs ++ LinComb.smul [-1] (f2aV1pMasters ++ symTerms f2aV1pSyms)) =
      [] := by
  decide +kernel

theorem f2aV1p_parts : ∀ p < 1,
    partOk f2aV1pCtx f2aV1pDen (rGetL (chunks f2aV1pTargetL f2aV1pTarget) p)
      (rGetL (chunks f2aV1pMsL f2aV1pMs) p) f2aV1pBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2aV1pPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2aV1p` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations, the scaleless sectors and the
relabelling symmetries of `f2aV1pSyms` of `f2a` at `d`, the target combination `Σ tₗ(d) I(l)` equals
`Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2aV1p_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2aV1pDen ≠ 0) (I : (Fin f2a.nProp → ℤ) → K → K)
    (hI : f2a.IBPHolds I d) (hz : f2a.ZeroSectors I d)
    (hs : ∀ e ∈ f2aV1pSyms, f2a.SymHoldsAt I d e.1 e.2.1) :
    (f2aV1pTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
      (f2aV1pMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2aV1pDen * I (toVec f2a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2aV1pDen) (T := f2aV1pTarget) (Ms := f2aV1pMs)
    (tl := f2aV1pTargetL) (ml := f2aV1pMsL) f2aV1pMT_ok f2aV1pFac_ok f2aV1pZS_eq f2aV1pBlocks_ok
    f2aV1pClaim_range f2aV1pTargetL_lt f2aV1pMsL_lt f2aV1pBound f2aV1p_parts I d hI hz hd
  rw [h]
  exact masters_of_comb f2a I d f2aV1pDen f2aV1pMs f2aV1pMasters f2aV1pSyms f2aV1pMs_comb hs

/-- **The `f2aV1p` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling symmetries of
`f2aV1pSyms` of `f2a` at `d`, the target combination equals the certified combination of the Kira
masters. -/
theorem f2aV1p_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2aV1pDen ≠ 0 ∧
      ∀ I : (Fin f2a.nProp → ℤ) → K → K, f2a.IBPHolds I d → f2a.ZeroSectors I d →
      (∀ e ∈ f2aV1pSyms, f2a.SymHoldsAt I d e.1 e.2.1) →
        (f2aV1pTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
          (f2aV1pMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2aV1pDen * I (toVec f2a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2aV1pDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz hsym =>
    f2aV1p_reduction_of_den d (hs d hd) I hI hz hsym⟩⟩

