    (hd : Poly.eval d f2bS0Den ≠ 0) (I : (Fin f2b.nProp → ℤ) → K → K)
    (hI : f2b.IBPHolds I d) (hz : f2b.ZeroSectors I d) :
    (f2bS0Target.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
      (f2bS0Masters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2bS0Den * I (toVec f2b.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2bS0Den) (T := f2bS0Target) (Ms := f2bS0Ms)
    (tl := f2bS0TargetL) (ml := f2bS0MsL) f2bS0MT_ok f2bS0Fac_ok f2bS0ZS_eq f2bS0Blocks_ok
    f2bS0Claim_range f2bS0TargetL_lt f2bS0MsL_lt f2bS0Bound f2bS0_parts I d hI hz hd
  exact h

/-- **The `f2bS0` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f2bS0_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2bS0Den ≠ 0 ∧
      ∀ I : (Fin f2b.nProp → ℤ) → K → K, f2b.IBPHolds I d → f2b.ZeroSectors I d →
        (f2bS0Target.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
          (f2bS0Masters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2bS0Den * I (toVec f2b.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2bS0Den_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f2bS0_reduction_of_den d (hs d hd) I hI hz⟩⟩

end QED.ThreeLoopE.SetECert
