    + 2223432373 / 11664) * ε ^ (3 : ℕ)

/-- The regular part of the product, without the remainder of the master. -/
noncomputable def setEAI9 (ε : ℂ) : ℂ :=
  setEPI9 ε + setEQI9 ε * setELamI9 ε

/-- The factor of the remainder of the master. -/
noncomputable def setEBI9 (ε : ℂ) : ℂ :=
  setETI9 ε + ε ^ (5 : ℕ) * setEQI9 ε

/-- The coefficient of `I₉` times its truncated expansion plus `ε ^ 2 r`. -/
theorem setECoeffI9_mul_eq {ε : ℂ} (hε : ε ≠ 0) (hU : setEUI9 ε ≠ 0) (r : ℂ) :
    setECoeffI9 ε * (setDLaurentI9 ε + ε ^ (2 : ℕ) * r) =
      setESI9 ε + ε * (setEAI9 ε + setEBI9 ε * r) := by
  rw [setECoeffI9_eq hε hU]
  simp only [setEAI9, setEBI9, setDLaurentI9, setESI9, setEPI9, setELamI9, setETI9]
  field_simp
  ring

theorem analyticAt_setEAI9 : AnalyticAt ℂ setEAI9 0 := by
  have hQ := analyticAt_setEQI9
  unfold setEAI9 setEPI9 setELamI9; fun_prop

theorem analyticAt_setEBI9 : AnalyticAt ℂ setEBI9 0 := by
  have hQ := analyticAt_setEQI9
  unfold setEBI9 setETI9; fun_prop

/-- **The coefficient of `I₉` times the master**: `c f = S + ε g` near `0`, with `g`
analytic at `0`. -/
theorem setECoeffI9_mul {f : ℂ → ℂ} (hf : HasTruncLaurent f setDLaurentI9 2) :
    ∃ g : ℂ → ℂ, AnalyticAt ℂ g 0 ∧
      ∀ᶠ ε in 𝓝[≠] (0 : ℂ), setECoeffI9 ε * f ε = setESI9 ε + ε * g ε :=
  hf.coeff_mul analyticAt_setEAI9 analyticAt_setEBI9
    (analyticAt_setEUI9 0).continuousAt (by rw [setEUI9_zero]; exact one_ne_zero)
    fun _ hε hU r => setECoeffI9_mul_eq hε hU r

