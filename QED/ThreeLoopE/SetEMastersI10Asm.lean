module

public import QED.ThreeLoopE.SetEMastersI10G0
public import QED.ThreeLoopE.SetEMastersI10KabVal
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-!
# Set (e), master `I₁₀`: the remainder from the expansions of `K_a` and `K₂`

`Rest = (2 K_a + ε K_ab) / (1 - ε) + 2 E_B G₀ + ε K₂` (`QED.ThreeLoopE.i10Rest`) with
`E_B = ε B(ε, 1 + ε) = Γ(1 + ε)² / Γ(1 + 2ε) = exp(-ε² (π²/6 - 2ζ₃ ε + 7π⁴/180 ε² + …))`
(the inverse of `QED.ThreeLoopE.i10E2`; `QED.ThreeLoopE.i10EB_trunc`). The expansions of `G₀`
(`QED.ThreeLoopE.hasTruncLaurent_i10G0`) and `K_ab` (`QED.ThreeLoopE.hasTruncLaurent_i10Kab`) are
proved; with

  `K_a = (3 + π²/6 - 2ζ₃) ε² + (6 - 7π²/3 - ζ₃ + 5π⁴/36) ε³ + O(ε⁴)`
  (`QED.ThreeLoopE.i10KaLaurent`),
  `K₂ = (-5 - π² + 12ζ₃) ε + (121π⁴/60 - 10π² - 38ζ₃ - 49) ε² + O(ε³)`
  (`QED.ThreeLoopE.i10K2Laurent`)

the polynomial identity `QED.ThreeLoopE.i10Asm_key` (generated by
`scripts/numerics/three_loop_masters/i10asmgen.py`, checked by `ring`) gives the expansion of
`Rest` and hence of the master (`QED.ThreeLoopE.hasTruncLaurent_setEMasterI10_of_Ka_K2`). The
coefficients of `K_a`, `K₂` agree with the direct Taylor coefficients of
`scripts/numerics/three_loop_masters/i10taylor.py` (to `5 · 10⁻¹³` for the order-`ε²` coefficient
of `K₂`, which is forced by the LR96 table).

## Main results

* `QED.ThreeLoopE.i10EB_trunc`, `QED.ThreeLoopE.i10Asm_key`.
* `QED.ThreeLoopE.hasTruncLaurent_i10Rest_of_Ka_K2`,
  `QED.ThreeLoopE.hasTruncLaurent_setEMasterI10_of_Ka_K2`.
-/

@[expose] public section

open Complex Filter Topology Real QED.Polylog QED.ThreeLoopD

namespace QED.ThreeLoopE

/-- **The target expansion of `K_a`** through `ε³`. -/
noncomputable def i10KaLaurent (ε : ℂ) : ℂ :=
  (3 + (π : ℂ) ^ 2 / 6 - 2 * (zeta3 : ℂ)) * ε ^ 2 +
    (6 - 7 / 3 * (π : ℂ) ^ 2 - (zeta3 : ℂ) + 5 / 36 * (π : ℂ) ^ 4) * ε ^ 3

/-- **The target expansion of `K₂`** through `ε²`. -/
noncomputable def i10K2Laurent (ε : ℂ) : ℂ :=
  (-5 - (π : ℂ) ^ 2 + 12 * (zeta3 : ℂ)) * ε +
    (121 / 60 * (π : ℂ) ^ 4 - 10 * (π : ℂ) ^ 2 - 38 * (zeta3 : ℂ) - 49) * ε ^ 2

/-- The truncation of `E_B = Γ(1 + ε)² / Γ(1 + 2ε)` through `ε⁴`. -/
noncomputable def i10EBp (ε : ℂ) : ℂ :=
  i10Ep ε (-((π : ℂ) ^ 2 / 6)) (2 * (zeta3 : ℂ)) (-(7 / 180 * (π : ℂ) ^ 4))

/-- `(E_B - E_{B,p}) / ε⁵`. -/
noncomputable def i10dB (ε : ℂ) : ℂ :=
  i10dE ε (-((π : ℂ) ^ 2 / 6)) (2 * (zeta3 : ℂ)) (-(7 / 180 * (π : ℂ) ^ 4)) (-i10Y2 ε)
    (QED.DimReg.expRem3 (ε ^ 2 * (-((π : ℂ) ^ 2 / 6) + 2 * (zeta3 : ℂ) * ε +
      -(7 / 180 * (π : ℂ) ^ 4) * ε ^ 2 + ε ^ 3 * -i10Y2 ε)))

theorem i10EB_trunc {ε : ℂ} (h0 : ε ≠ 0) (hε : ‖ε‖ < 1 / 8) :
    ε * i9Beta ε (1 + ε) = i10EBp ε + ε ^ 5 * i10dB ε := by
  have hG := fun a ha => Gamma_one_add_ne_zero (setDGamma_norm_mul_lt_one hε a ha)
  have hA := hG 1 (by norm_num)
  have hC := hG 2 (by norm_num)
  have e1 : ε * i9Beta ε (1 + ε) = (i10E2 ε)⁻¹ := by
    have g1 : Gamma ε = Gamma (1 + 1 * ε) / ε := Gamma_eq_div_one h0 (by ring) rfl
    have g2 : Gamma (ε + (1 + ε)) = Gamma (1 + 2 * ε) := by congr 1; ring
    have g3 : Gamma (1 + ε) = Gamma (1 + 1 * ε) := by congr 1; ring
    rw [i9Beta, i10E2, g1, g2, g3]
    field_simp
  have e2 : (i10E2 ε)⁻¹ = cexp (ε ^ 2 * (-((π : ℂ) ^ 2 / 6) + 2 * (zeta3 : ℂ) * ε +
      -(7 / 180 * (π : ℂ) ^ 4) * ε ^ 2 + ε ^ 3 * -i10Y2 ε)) := by
    rw [i10E2_eq hε, ← Complex.exp_neg]
    congr 1
    ring
  rw [e1, e2]
  exact i10_exp_trunc ..

theorem analyticAt_i10dB : AnalyticAt ℂ i10dB 0 := by
  have h1 := analyticAt_i10Lt_mul 1
  have h2 := analyticAt_i10Lt_mul 2
  exact analyticAt_i10dE (by unfold i10Y2; fun_prop)

/-- The polynomial `(2 K_{a,L} + ε K_{ab,L} + (1 - ε)(2 E_{B,p} G_{0,L} + ε K_{2,L})
- (1 - ε) Rest_L) / ε⁴` (generated by `scripts/numerics/three_loop_masters/i10asmgen.py`). -/
noncomputable def i10AsmW (ε : ℂ) : ℂ :=
  (1 / 40 * (π : ℂ) ^ 4 - 4 * (π : ℂ) ^ 2 * (zeta3 : ℂ) + 17 / 3 * (π : ℂ) ^ 2 - 28 * (zeta3 : ℂ)
    + 18)
  + (-19 / 45 * (π : ℂ) ^ 6 + 127 / 120 * (π : ℂ) ^ 4 - 7 / 3 * (π : ℂ) ^ 2 * (zeta3 : ℂ)
    + 33 * (π : ℂ) ^ 2 + 72 * (zeta3 : ℂ) ^ 2 - 92 * (zeta3 : ℂ)) * ε
  + (7 / 18 * (π : ℂ) ^ 6 + 58 / 15 * (π : ℂ) ^ 4 * (zeta3 : ℂ) + 97 / 180 * (π : ℂ) ^ 4
    - (π : ℂ) ^ 2 * (zeta3 : ℂ) - 127 / 3 * (π : ℂ) ^ 2 + 36 * (zeta3 : ℂ) ^ 2
    - 396 * (zeta3 : ℂ)) * ε ^ 2
  + (-143 / 2400 * (π : ℂ) ^ 8 + 1 / 8 * (π : ℂ) ^ 6 - 313 / 60 * (π : ℂ) ^ 4 * (zeta3 : ℂ)
    + 99 / 20 * (π : ℂ) ^ 4 + 22 / 3 * (π : ℂ) ^ 2 * (zeta3 : ℂ) - 108 * (zeta3 : ℂ) ^ 2
    + 508 * (zeta3 : ℂ)) * ε ^ 3
  + (143 / 2400 * (π : ℂ) ^ 8 - 11 / 120 * (π : ℂ) ^ 6 + 27 / 20 * (π : ℂ) ^ 4 * (zeta3 : ℂ)
    - 127 / 20 * (π : ℂ) ^ 4) * ε ^ 4

/-- **The polynomial identity behind the expansion of `Rest`.** -/
theorem i10Asm_key (ε : ℂ) :
    2 * i10KaLaurent ε + ε * i10KabLaurent ε +
      (1 - ε) * (2 * i10EBp ε * i10G0Laurent ε + ε * i10K2Laurent ε) -
      (1 - ε) * i10RestLaurent ε = ε ^ 4 * i10AsmW ε := by
  simp only [i10KaLaurent, i10KabLaurent, i10EBp, i10Ep, i10G0Laurent, i10K2Laurent,
    i10RestLaurent, i10AsmW]
  ring

/-- **The remainder from `K_a` and `K₂`**: the expansions of `G₀` and `K_ab` are proved, so
those of `K_a` (to `O(ε⁴)`) and `K₂` (to `O(ε³)`) give that of `Rest` (to `O(ε⁴)`). -/
theorem hasTruncLaurent_i10Rest_of_Ka_K2 (hKa : HasTruncLaurent i10Ka i10KaLaurent 4)
    (hK2 : HasTruncLaurent i10K2 i10K2Laurent 3) :
    HasTruncLaurent i10Rest i10RestLaurent 4 := by
  obtain ⟨Ra, hRa, hA⟩ := hKa
  obtain ⟨R2, hR2, h2⟩ := hK2
  obtain ⟨Rab, hRab, hAb⟩ := hasTruncLaurent_i10Kab
  obtain ⟨R0, hR0, h0⟩ := hasTruncLaurent_i10G0
  refine ⟨fun ε => (i10AsmW ε + 2 * Ra ε + Rab ε) / (1 - ε) +
    2 * (i10EBp ε * R0 ε + ε * i10dB ε * i10G0Laurent ε + ε ^ 5 * i10dB ε * R0 ε) + R2 ε,
    ?_, ?_⟩
  · have hdB := analyticAt_i10dB
    have hW : AnalyticAt ℂ i10AsmW 0 := by unfold i10AsmW; fun_prop
    have hP : AnalyticAt ℂ i10EBp 0 := by unfold i10EBp i10Ep; fun_prop
    have hL : AnalyticAt ℂ i10G0Laurent 0 := by unfold i10G0Laurent; fun_prop
    have hq : AnalyticAt ℂ (fun ε : ℂ => (i10AsmW ε + 2 * Ra ε + Rab ε) / (1 - ε)) 0 :=
      AnalyticAt.div (by fun_prop) (by fun_prop) (by norm_num)
    fun_prop
  filter_upwards [setDGamma_eventually_small, hA, h2, hAb, h0, self_mem_nhdsWithin] with
    ε hε hA hB hC hD hne
  have hne : ε ≠ 0 := hne
  have h1 : (1 : ℂ) - ε ≠ 0 := setDGamma_lin_ne_zero hε 1 (-1) (by norm_num) (by norm_num)
    (by ring)
  have key := i10Asm_key ε
  rw [i10Rest, hA, hB, hC, hD, i10EB_trunc hne hε]
  generalize i10dB ε = dB at *
  generalize i10EBp ε = P at *
  generalize i10G0Laurent ε = G at *
  generalize i10KaLaurent ε = KA at *
  generalize i10KabLaurent ε = KB at *
  generalize i10K2Laurent ε = K2 at *
  generalize i10RestLaurent ε = RL at *
  generalize i10AsmW ε = W at *
  field_simp
  linear_combination key

/-- **The set (e) input for `I₁₀`, reduced to `K_a` and `K₂`.** -/
theorem hasTruncLaurent_setEMasterI10_of_Ka_K2 (hKa : HasTruncLaurent i10Ka i10KaLaurent 4)
    (hK2 : HasTruncLaurent i10K2 i10K2Laurent 3) :
    HasTruncLaurent setEMasterI10 setELaurentI10 2 :=
  hasTruncLaurent_setEMasterI10_of_rest (hasTruncLaurent_i10Rest_of_Ka_K2 hKa hK2)

end QED.ThreeLoopE
