theorem f2aS0B0_ok : f2aS0B0.all (GBlock.ok f2aS0Ctx 2 3 5 1 f2aS0QE f2aS0Yb f2aS0NF
    f2aS0ZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2aS0Blocks : List GBlock :=
    f2aS0B0

theorem f2aS0Part0 :
    partOk f2aS0Ctx f2aS0Den (rGetL (chunks f2aS0TargetL f2aS0Target) 0)
      (rGetL (chunks f2aS0MsL f2aS0Ms) 0) f2aS0Blocks 0 = true := by
  decide +kernel

theorem f2aS0MT_ok : mtOk f2a f2aS0Ctx 90 10 = true := by decide +kernel

theorem f2aS0Fac_ok : facOk f2aS0Ctx f2aS0Fac f2aS0QE f2aS0NF = true := by decide +kernel

theorem f2aS0ZS_eq :
    f2aS0ZS = f2a.zeroSectors.map fun S => S.map fun a => (a, f2aS0Ctx.B ^ a) := by
  decide +kernel

theorem f2aS0Blocks_ok :
    f2aS0Blocks.all (GBlock.ok f2aS0Ctx 2 3 5 1 f2aS0QE f2aS0Yb f2aS0NF f2aS0ZS) = true := by
  simp only [f2aS0Blocks, f2aS0B0_ok]

theorem f2aS0Claim_range :
    (f2aS0Target ++ f2aS0Ms).all (fun t => inRange 8 3 5 t.1) = true := by
  decide +kernel

theorem f2aS0Bound :
    (f2aS0Blocks.map fun b => b.seeds.length).sum * (10 * (f2aS0Yb * 90)) +
      Poly.norm1 f2aS0Den * (f2aS0Target.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2aS0Ms.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2aS0Ctx.x0 := by
  decide +kernel

theorem f2aS0TargetL_lt : f2aS0TargetL.length < 1 := by decide +kernel

theorem f2aS0MsL_lt : f2aS0MsL.length < 1 := by decide +kernel

theorem f2aS0Den_ne_zero : Poly.isZero f2aS0Den = false := by decide +kernel

/-- The master list of the checker is the Kira masters plus the symmetry terms. -/
theorem f2aS0Ms_comb :
    LinComb.ofTerms (f2aS0Ms ++ LinComb.smul [-1] (f2aS0Masters ++ symTerms f2aS0Syms)) =
      [] := by
  decide +kernel

theorem f2aS0_parts : ∀ p < 1,
    partOk f2aS0Ctx f2aS0Den (rGetL (chunks f2aS0TargetL f2aS0Target) p)
      (rGetL (chunks f2aS0MsL f2aS0Ms) p) f2aS0Blocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2aS0Part0
  | _ + 1, h => absurd h (by omega)

/-- The `f2aS0` reduction at every dimension `d` where the common denominator `q(d)` is nonzero: for
every family of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling
symmetries of `f2aS0Syms` of `f2a` at `d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) /
q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2aS0_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2aS0Den ≠ 0) (I : (Fin f2a.nProp → ℤ) → K → K)
    (hI : f2a.IBPHolds I d) (hz : f2a.ZeroSectors I d)
    (hs : ∀ e ∈ f2aS0Syms, f2a.SymHoldsAt I d e.1 e.2.1) :
    (f2aS0Target.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
      (f2aS0Masters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2aS0Den * I (toVec f2a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2aS0Den) (T := f2aS0Target) (Ms := f2aS0Ms)
    (tl := f2aS0TargetL) (ml := f2aS0MsL) f2aS0MT_ok f2aS0Fac_ok f2aS0ZS_eq f2aS0Blocks_ok
    f2aS0Claim_range f2aS0TargetL_lt f2aS0MsL_lt f2aS0Bound f2aS0_parts I d hI hz hd
  rw [h]
  exact masters_of_comb f2a I d f2aS0Den f2aS0Ms f2aS0Masters f2aS0Syms f2aS0Ms_comb hs

/-- **The `f2aS0` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling symmetries of
`f2aS0Syms` of `f2a` at `d`, the target combination equals the certified combination of the Kira
masters. -/
theorem f2aS0_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2aS0Den ≠ 0 ∧
      ∀ I : (Fin f2a.nProp → ℤ) → K → K, f2a.IBPHolds I d → f2a.ZeroSectors I d →
      (∀ e ∈ f2aS0Syms, f2a.SymHoldsAt I d e.1 e.2.1) →
        (f2aS0Target.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
          (f2aS0Masters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2aS0Den * I (toVec f2a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2aS0Den_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz hsym =>
    f2aS0_reduction_of_den d (hs d hd) I hI hz hsym⟩⟩

