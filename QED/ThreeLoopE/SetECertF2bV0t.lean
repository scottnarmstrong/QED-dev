theorem f2bV0tB0_ok : f2bV0tB0.all (GBlock.ok f2bV0tCtx 2 3 5 1 f2bV0tQE f2bV0tYb f2bV0tNF
    f2bV0tZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2bV0tBlocks : List GBlock :=
    f2bV0tB0

theorem f2bV0tPart0 :
    partOk f2bV0tCtx f2bV0tDen (rGetL (chunks f2bV0tTargetL f2bV0tTarget) 0)
      (rGetL (chunks f2bV0tMsL f2bV0tMs) 0) f2bV0tBlocks 0 = true := by
  decide +kernel

theorem f2bV0tMT_ok : mtOk f2b f2bV0tCtx 74 13 = true := by decide +kernel

theorem f2bV0tFac_ok : facOk f2bV0tCtx f2bV0tFac f2bV0tQE f2bV0tNF = true := by decide +kernel

theorem f2bV0tZS_eq :
    f2bV0tZS = f2b.zeroSectors.map fun S => S.map fun a => (a, f2bV0tCtx.B ^ a) := by
  decide +kernel

theorem f2bV0tBlocks_ok :
    f2bV0tBlocks.all (GBlock.ok f2bV0tCtx 2 3 5 1 f2bV0tQE f2bV0tYb f2bV0tNF f2bV0tZS) = true := by
  simp only [f2bV0tBlocks, f2bV0tB0_ok]

theorem f2bV0tClaim_range :
    (f2bV0tTarget ++ f2bV0tMs).all (fun t => inRange 7 2 5 t.1) = true := by
  decide +kernel

theorem f2bV0tBound :
    (f2bV0tBlocks.map fun b => b.seeds.length).sum * (13 * (f2bV0tYb * 74)) +
      Poly.norm1 f2bV0tDen * (f2bV0tTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2bV0tMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2bV0tCtx.x0 := by
  decide +kernel

theorem f2bV0tTargetL_lt : f2bV0tTargetL.length < 1 := by decide +kernel

theorem f2bV0tMsL_lt : f2bV0tMsL.length < 1 := by decide +kernel

theorem f2bV0tDen_ne_zero : Poly.isZero f2bV0tDen = false := by decide +kernel

theorem f2bV0t_parts : ∀ p < 1,
    partOk f2bV0tCtx f2bV0tDen (rGetL (chunks f2bV0tTargetL f2bV0tTarget) p)
      (rGetL (chunks f2bV0tMsL f2bV0tMs) p) f2bV0tBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2bV0tPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2bV0t` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at
`d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2bV0t_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2bV0tDen ≠ 0) (I : (Fin f2b.nProp → ℤ) → K → K)
    (hI : f2b.IBPHolds I d) (hz : f2b.ZeroSectors I d) :
    (f2bV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
      (f2bV0tMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2bV0tDen * I (toVec f2b.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2bV0tDen) (T := f2bV0tTarget) (Ms := f2bV0tMs)
    (tl := f2bV0tTargetL) (ml := f2bV0tMsL) f2bV0tMT_ok f2bV0tFac_ok f2bV0tZS_eq f2bV0tBlocks_ok
    f2bV0tClaim_range f2bV0tTargetL_lt f2bV0tMsL_lt f2bV0tBound f2bV0t_parts I d hI hz hd
  exact h

/-- **The `f2bV0t` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f2bV0t_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2bV0tDen ≠ 0 ∧
      ∀ I : (Fin f2b.nProp → ℤ) → K → K, f2b.IBPHolds I d → f2b.ZeroSectors I d →
        (f2bV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
          (f2bV0tMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2bV0tDen * I (toVec f2b.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2bV0tDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f2bV0t_reduction_of_den d (hs d hd) I hI hz⟩⟩

