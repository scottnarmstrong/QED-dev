theorem f2aV0tB0_ok : f2aV0tB0.all (GBlock.ok f2aV0tCtx 2 3 5 1 f2aV0tQE f2aV0tYb f2aV0tNF
    f2aV0tZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2aV0tBlocks : List GBlock :=
    f2aV0tB0

theorem f2aV0tPart0 :
    partOk f2aV0tCtx f2aV0tDen (rGetL (chunks f2aV0tTargetL f2aV0tTarget) 0)
      (rGetL (chunks f2aV0tMsL f2aV0tMs) 0) f2aV0tBlocks 0 = true := by
  decide +kernel

theorem f2aV0tMT_ok : mtOk f2a f2aV0tCtx 98 10 = true := by decide +kernel

theorem f2aV0tFac_ok : facOk f2aV0tCtx f2aV0tFac f2aV0tQE f2aV0tNF = true := by decide +kernel

theorem f2aV0tZS_eq :
    f2aV0tZS = f2a.zeroSectors.map fun S => S.map fun a => (a, f2aV0tCtx.B ^ a) := by
  decide +kernel

theorem f2aV0tBlocks_ok :
    f2aV0tBlocks.all (GBlock.ok f2aV0tCtx 2 3 5 1 f2aV0tQE f2aV0tYb f2aV0tNF f2aV0tZS) = true := by
  simp only [f2aV0tBlocks, f2aV0tB0_ok]

theorem f2aV0tClaim_range :
    (f2aV0tTarget ++ f2aV0tMs).all (fun t => inRange 9 3 5 t.1) = true := by
  decide +kernel

theorem f2aV0tBound :
    (f2aV0tBlocks.map fun b => b.seeds.length).sum * (10 * (f2aV0tYb * 98)) +
      Poly.norm1 f2aV0tDen * (f2aV0tTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2aV0tMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2aV0tCtx.x0 := by
  decide +kernel

theorem f2aV0tTargetL_lt : f2aV0tTargetL.length < 1 := by decide +kernel

theorem f2aV0tMsL_lt : f2aV0tMsL.length < 1 := by decide +kernel

theorem f2aV0tDen_ne_zero : Poly.isZero f2aV0tDen = false := by decide +kernel

/-- The master list of the checker is the Kira masters plus the symmetry terms. -/
theorem f2aV0tMs_comb :
    LinComb.ofTerms (f2aV0tMs ++ LinComb.smul [-1] (f2aV0tMasters ++ symTerms f2aV0tSyms)) =
      [] := by
  decide +kernel

theorem f2aV0t_parts : ∀ p < 1,
    partOk f2aV0tCtx f2aV0tDen (rGetL (chunks f2aV0tTargetL f2aV0tTarget) p)
      (rGetL (chunks f2aV0tMsL f2aV0tMs) p) f2aV0tBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2aV0tPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2aV0t` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations, the scaleless sectors and the
relabelling symmetries of `f2aV0tSyms` of `f2a` at `d`, the target combination `Σ tₗ(d) I(l)` equals
`Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2aV0t_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2aV0tDen ≠ 0) (I : (Fin f2a.nProp → ℤ) → K → K)
    (hI : f2a.IBPHolds I d) (hz : f2a.ZeroSectors I d)
    (hs : ∀ e ∈ f2aV0tSyms, f2a.SymHoldsAt I d e.1 e.2.1) :
    (f2aV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
      (f2aV0tMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2aV0tDen * I (toVec f2a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2aV0tDen) (T := f2aV0tTarget) (Ms := f2aV0tMs)
    (tl := f2aV0tTargetL) (ml := f2aV0tMsL) f2aV0tMT_ok f2aV0tFac_ok f2aV0tZS_eq f2aV0tBlocks_ok
    f2aV0tClaim_range f2aV0tTargetL_lt f2aV0tMsL_lt f2aV0tBound f2aV0t_parts I d hI hz hd
  rw [h]
  exact masters_of_comb f2a I d f2aV0tDen f2aV0tMs f2aV0tMasters f2aV0tSyms f2aV0tMs_comb hs

/-- **The `f2aV0t` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling symmetries of
`f2aV0tSyms` of `f2a` at `d`, the target combination equals the certified combination of the Kira
masters. -/
theorem f2aV0t_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2aV0tDen ≠ 0 ∧
      ∀ I : (Fin f2a.nProp → ℤ) → K → K, f2a.IBPHolds I d → f2a.ZeroSectors I d →
      (∀ e ∈ f2aV0tSyms, f2a.SymHoldsAt I d e.1 e.2.1) →
        (f2aV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
          (f2aV0tMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2aV0tDen * I (toVec f2a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2aV0tDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz hsym =>
    f2aV0t_reduction_of_den d (hs d hd) I hI hz hsym⟩⟩

