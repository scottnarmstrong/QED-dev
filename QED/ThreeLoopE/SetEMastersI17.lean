/-!
# Set (e) of `A₁⁽⁶⁾`: the master `I₁₇` is proved

The master `I₁₇ C⁻¹` (`QED.ThreeLoopE.setEMasterI17`) is a rational function of `ε` times a
ratio of `Γ(1 + a ε)` (`QED.ThreeLoopE.setEMasterI17_eq`):

  `I₁₇ C⁻¹ = (4 - 6ε)(3 - 6ε)(2 - 6ε)(1 - 6ε) / (6 ε² D(ε)) ·`
  `    Γ(1 - ε)³ Γ(1 + 2ε) Γ(1 + 3ε) Γ(1 - 6ε) / (Γ(1 + ε)³ Γ(1 - 3ε) Γ(1 - 4ε))`,

`D(ε) = (2ε - 1)(3ε - 1)(3ε - 2)(2 - 3ε)(1 - 3ε)(3 - 4ε)(2 - 4ε)(1 - 4ε)`
(`QED.ThreeLoopE.setEGammaD17`). By `QED.DimReg.Gamma_one_add_eq_exp` the `Γ`-ratio is
`exp(ε² X(ε))` with `X = 2π² + 32ζ₃ ε + 44π⁴/15 ε² + 1248ζ₅ ε³ + ε⁴ V(ε)`, `V` analytic at `0`
(`γ` cancels since the `a`'s balance). Truncating `exp` (`QED.DimReg.exp_eq_expRem3`) gives the set
(e) input `HasTruncLaurent setEMasterI17 setELaurentI17 2`
(`QED.ThreeLoopE.hasTruncLaurent_setEMasterI17`) with the explicit analytic remainder
`QED.ThreeLoopE.setEGammaR17`, checked by `ring`. The polynomial part
`QED.ThreeLoopE.setEGammaP17` is generated by `scripts/numerics/three_loop_masters/i17gen.py`;
its value at `0` reproduces the `ε²` coefficient of the LR96 table.

## Main results

* `QED.ThreeLoopE.setEMasterI17_eq`, `QED.ThreeLoopE.gammaRatio17_eq`.
* `QED.ThreeLoopE.hasTruncLaurent_setEMasterI17`.
* `QED.ThreeLoopE.SetEMasters.Expansions.ofSetD_of_I17`: the set (e) inputs with `I₁₇` discharged.
-/

@[expose] public section

open Complex Filter Topology Real QED.Polylog QED.ThreeLoopD

namespace QED.ThreeLoopE

/-! ### Small-`ε` facts -/

theorem setEGamma17_lin_ne_zero {ε : ℂ} (hε : ‖ε‖ < 1 / 8) (c a : ℂ) (hc : 1 ≤ ‖c‖)
    (ha : ‖a‖ ≤ 6) {x : ℂ} (hx : x = c + a * ε) : x ≠ 0 := by
  rintro rfl
  have h : c = -(a * ε) := by linear_combination -hx
  have h2 := congrArg norm h
  rw [norm_neg, norm_mul] at h2
  nlinarith [norm_nonneg a, norm_nonneg ε]

theorem setEGamma17_norm_mul_lt_one {ε : ℂ} (hε : ‖ε‖ < 1 / 8) (a : ℂ) (ha : ‖a‖ ≤ 6) :
    ‖a * ε‖ < 1 := by
  rw [norm_mul]
  nlinarith [norm_nonneg a, norm_nonneg ε]

/-- The denominator `(2ε - 1)(3ε - 1)(3ε - 2)(2 - 3ε)(1 - 3ε)(3 - 4ε)(2 - 4ε)(1 - 4ε)`. -/
noncomputable def setEGammaD17 (ε : ℂ) : ℂ :=
  (2 * ε - 1) * (3 * ε - 1) * (3 * ε - 2) * (2 - 3 * ε) * (1 - 3 * ε) * (3 - 4 * ε) *
    (2 - 4 * ε) * (1 - 4 * ε)

/-- The numerator `(4 - 6ε)(3 - 6ε)(2 - 6ε)(1 - 6ε)`. -/
noncomputable def setEGammaN17 (ε : ℂ) : ℂ :=
  (4 - 6 * ε) * (3 - 6 * ε) * (2 - 6 * ε) * (1 - 6 * ε)

theorem setEGammaD17_ne_zero {ε : ℂ} (hε : ‖ε‖ < 1 / 8) : setEGammaD17 ε ≠ 0 := by
  have hl := fun c a hc ha {x : ℂ} (hx : x = c + a * ε) =>
    setEGamma17_lin_ne_zero hε c a hc ha hx
  have h1 := hl (-1) 2 (by norm_num) (by norm_num) (x := 2 * ε - 1) (by ring)
  have h2 := hl (-1) 3 (by norm_num) (by norm_num) (x := 3 * ε - 1) (by ring)
  have h3 := hl (-2) 3 (by norm_num) (by norm_num) (x := 3 * ε - 2) (by ring)
  have h4 := hl 2 (-3) (by norm_num) (by norm_num) (x := 2 - 3 * ε) (by ring)
  have h5 := hl 1 (-3) (by norm_num) (by norm_num) (x := 1 - 3 * ε) (by ring)
  have h6 := hl 3 (-4) (by norm_num) (by norm_num) (x := 3 - 4 * ε) (by ring)
  have h7 := hl 2 (-4) (by norm_num) (by norm_num) (x := 2 - 4 * ε) (by ring)
  have h8 := hl 1 (-4) (by norm_num) (by norm_num) (x := 1 - 4 * ε) (by ring)
  simp only [setEGammaD17]
  simp [h1, h2, h3, h4, h5, h6, h7, h8]

/-! ### The master as a rational function times a `Γ`-ratio -/

/-- `I₁₇ C⁻¹` as a rational function times a ratio of `Γ(1 + a ε)`. -/
theorem setEMasterI17_eq {ε : ℂ} (h0 : ε ≠ 0) (hε : ‖ε‖ < 1 / 8) :
    setEMasterI17 ε = setEGammaN17 ε / (6 * ε ^ 2 * setEGammaD17 ε) *
      (Gamma (1 + (-1) * ε) ^ 3 * Gamma (1 + 2 * ε) * Gamma (1 + 3 * ε) * Gamma (1 + (-6) * ε) /
        (Gamma (1 + 1 * ε) ^ 3 * Gamma (1 + (-3) * ε) * Gamma (1 + (-4) * ε))) := by
  have hl := fun c a hc ha {x : ℂ} (hx : x = c + a * ε) =>
    setEGamma17_lin_ne_zero hε c a hc ha hx
  have hG := fun a ha => Gamma_one_add_ne_zero (setEGamma17_norm_mul_lt_one hε a ha)
  have g1 : Gamma (1 + 1 - (4 - 2 * ε) / 2) = Gamma (1 + 1 * ε) / ε := by
    rw [show (1 : ℂ) + 1 - (4 - 2 * ε) / 2 = ε by ring]
    exact Gamma_eq_div_one h0 (by ring) rfl
  have g2 : Gamma (2 - (4 - 2 * ε) / 2) = Gamma (1 + 1 * ε) / ε := by
    rw [show (2 : ℂ) - (4 - 2 * ε) / 2 = ε by ring]
    exact Gamma_eq_div_one h0 (by ring) rfl
  have g3 : Gamma ((4 - 2 * ε) / 2 - 1) = Gamma (1 + (-1) * ε) := by
    congr 1; ring
  have g4 : Gamma (4 - 2 * ε - 1 - 1) = (1 - 2 * ε) * Gamma (1 + (-2) * ε) := by
    rw [show (4 : ℂ) - 2 * ε - 1 - 1 = 1 + (-2) * ε + 1 by ring,
      Gamma_add_one _ (hl 1 (-2) (by norm_num) (by norm_num) (by ring))]
    ring
  have g5 : Gamma ((4 - 2 * ε) / 2 - (2 - (4 - 2 * ε) / 2)) =
      (1 - 2 * ε) * Gamma (1 + (-2) * ε) := by
    rw [show (4 - 2 * ε) / 2 - (2 - (4 - 2 * ε) / 2) = 4 - 2 * ε - 1 - 1 by ring, g4]
  have g6 : Gamma (1 + (2 - (4 - 2 * ε) / 2) - (4 - 2 * ε) / 2) =
      Gamma (1 + 2 * ε) / (2 * ε * (2 * ε - 1)) :=
    Gamma_eq_div_two (hl (-1) 2 (by norm_num) (by norm_num) (by ring))
      (setDGamma_mul_ne_zero h0 2 two_ne_zero (by ring)) (by ring) (by ring)
  have g7 : Gamma (4 - 2 * ε - 1 - (2 - (4 - 2 * ε) / 2)) =
      (2 - 3 * ε) * (1 - 3 * ε) * Gamma (1 + (-3) * ε) := by
    rw [show 4 - 2 * ε - 1 - (2 - (4 - 2 * ε) / 2) = 1 + (-3) * ε + 1 + 1 by ring,
      Gamma_add_one _ (hl 2 (-3) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 1 (-3) (by norm_num) (by norm_num) (by ring))]
    ring
  have g8 : Gamma (3 - (4 - 2 * ε) + 1 - (4 - 2 * ε) / 2) =
      Gamma (1 + 3 * ε) / ((3 * ε) * (3 * ε - 1) * (3 * ε - 2)) :=
    Gamma_eq_div_three (hl (-2) 3 (by norm_num) (by norm_num) (by ring))
      (hl (-1) 3 (by norm_num) (by norm_num) (by ring))
      (setDGamma_mul_ne_zero h0 3 three_ne_zero (by ring)) (by ring) (by ring)
  have g9 : Gamma (4 - 2 * ε - 2 * (3 - (4 - 2 * ε)) - 1) =
      setEGammaN17 ε * Gamma (1 + (-6) * ε) := by
    rw [show 4 - 2 * ε - 2 * (3 - (4 - 2 * ε)) - 1 = 1 + (-6) * ε + 1 + 1 + 1 + 1 by ring,
      Gamma_add_one _ (hl 4 (-6) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 3 (-6) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 2 (-6) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 1 (-6) (by norm_num) (by norm_num) (by ring)), setEGammaN17]
    ring
  have g10 : Gamma (4 - 2 * ε - (3 - (4 - 2 * ε)) - 1) =
      (3 - 4 * ε) * (2 - 4 * ε) * (1 - 4 * ε) * Gamma (1 + (-4) * ε) := by
    rw [show 4 - 2 * ε - (3 - (4 - 2 * ε)) - 1 = 1 + (-4) * ε + 1 + 1 + 1 by ring,
      Gamma_add_one _ (hl 3 (-4) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 2 (-4) (by norm_num) (by norm_num) (by ring)),
      Gamma_add_one _ (hl 1 (-4) (by norm_num) (by norm_num) (by ring))]
    ring
  simp only [setEMasterI17, lr96I17, lr96C, QED.DimReg.masslessBubbleCoeff,
    QED.DimReg.OneLoopSchwinger.phi, QED.DimReg.lr96LoopFactor_four_sub, Complex.Gamma_one,
    inv_one, mul_one, one_mul]
  rw [g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, show (1 : ℂ) + ε = 1 + 1 * ε by ring]
  have hpi : (π : ℂ) ^ ε ≠ 0 := cpow_ne_zero_iff.mpr (Or.inl (ofReal_ne_zero.mpr pi_ne_zero))
  have hA := hG 1 (by norm_num)
  have hE := hG (-2) (by norm_num)
  have hF := hG (-3) (by norm_num)
  have hH := hG (-4) (by norm_num)
  have hD := setEGammaD17_ne_zero hε
  have k1 := hl 1 (-2) (by norm_num) (by norm_num) (x := 1 - 2 * ε) (by ring)
  have k2 := hl (-1) 2 (by norm_num) (by norm_num) (x := 2 * ε - 1) (by ring)
  have k3 := hl (-1) 3 (by norm_num) (by norm_num) (x := 3 * ε - 1) (by ring)
  have k4 := hl (-2) 3 (by norm_num) (by norm_num) (x := 3 * ε - 2) (by ring)
  have k5 := hl 2 (-3) (by norm_num) (by norm_num) (x := 2 - 3 * ε) (by ring)
  have k6 := hl 1 (-3) (by norm_num) (by norm_num) (x := 1 - 3 * ε) (by ring)
  have k7 := hl 3 (-4) (by norm_num) (by norm_num) (x := 3 - 4 * ε) (by ring)
  have k8 := hl 2 (-4) (by norm_num) (by norm_num) (x := 2 - 4 * ε) (by ring)
  have k9 := hl 1 (-4) (by norm_num) (by norm_num) (x := 1 - 4 * ε) (by ring)
  have hDd : setEGammaD17 ε = (2 * ε - 1) * (3 * ε - 1) * (3 * ε - 2) * (2 - 3 * ε) *
      (1 - 3 * ε) * (3 - 4 * ε) * (2 - 4 * ε) * (1 - 4 * ε) := rfl
  generalize setEGammaN17 ε = N
  generalize Gamma (1 + 1 * ε) = A at *
  generalize Gamma (1 + (-1) * ε) = B
  generalize Gamma (1 + 2 * ε) = C
  generalize Gamma (1 + 3 * ε) = C3
  generalize Gamma (1 + (-6) * ε) = G6
  generalize Gamma (1 + (-2) * ε) = E at *
  generalize Gamma (1 + (-3) * ε) = F at *
  generalize Gamma (1 + (-4) * ε) = H at *
  generalize (π : ℂ) ^ ε = P at *
  rw [hDd]
  clear g1 g2 g3 g4 g5 g6 g7 g8 g9 g10 hl hG hDd hD
  -- the linear factors as atoms: the identity needs no relation between them
  generalize 2 * ε - 1 = a1 at *
  generalize 3 * ε - 1 = a2 at *
  generalize 3 * ε - 2 = a3 at *
  generalize 2 - 3 * ε = a4 at *
  generalize 1 - 3 * ε = a5 at *
  generalize 3 - 4 * ε = a6 at *
  generalize 2 - 4 * ε = a7 at *
  generalize 1 - 4 * ε = a8 at *
  generalize 1 - 2 * ε = a9 at *
  field_simp
  ring

/-! ### The `Γ`-ratio as an exponential -/

theorem exp_ratio17 (a b c d e f g : ℂ) :
    exp a ^ 3 * exp b * exp c * exp d / (exp e ^ 3 * exp f * exp g) =
      exp (3 * a + b + c + d - 3 * e - f - g) := by
  rw [show 3 * a + b + c + d - 3 * e - f - g = a + a + a + b + c + d - (e + e + e) - f - g by
    ring]
  simp only [Complex.exp_sub, Complex.exp_add]
  ring

/-- The analytic remainder of the exponent for `I₁₇`. -/
noncomputable def setEGammaV17 (ε : ℂ) : ℂ :=
  3 * (-1) ^ 6 * QED.DimReg.logGammaRem ((-1) * ε) + 2 ^ 6 * QED.DimReg.logGammaRem (2 * ε) +
    3 ^ 6 * QED.DimReg.logGammaRem (3 * ε) + (-6) ^ 6 * QED.DimReg.logGammaRem ((-6) * ε) -
    3 * 1 ^ 6 * QED.DimReg.logGammaRem (1 * ε) - (-3) ^ 6 * QED.DimReg.logGammaRem ((-3) * ε) -
    (-4) ^ 6 * QED.DimReg.logGammaRem ((-4) * ε)

/-- The polynomial part `2π² + 32ζ₃ ε + 44π⁴/15 ε²` of the exponent for `I₁₇` over `ε²`. -/
noncomputable def setEGammaXp17 (ε : ℂ) : ℂ :=
  2 * (π : ℂ) ^ 2 + 32 * (zeta3 : ℂ) * ε + 44 / 15 * (π : ℂ) ^ 4 * ε ^ 2

/-- The rest of the exponent for `I₁₇`, over `ε⁵`. -/
noncomputable def setEGammaY17 (ε : ℂ) : ℂ := 1248 * (zeta5 : ℂ) + ε * setEGammaV17 ε

/-- The exponent for `I₁₇`, divided by `ε ^ 2`. -/
noncomputable def setEGammaX17 (ε : ℂ) : ℂ := setEGammaXp17 ε + ε ^ 3 * setEGammaY17 ε

theorem gammaRatio17_eq {ε : ℂ} (hε : ‖ε‖ < 1 / 8) :
    Gamma (1 + (-1) * ε) ^ 3 * Gamma (1 + 2 * ε) * Gamma (1 + 3 * ε) * Gamma (1 + (-6) * ε) /
        (Gamma (1 + 1 * ε) ^ 3 * Gamma (1 + (-3) * ε) * Gamma (1 + (-4) * ε)) =
      exp (ε ^ 2 * setEGammaX17 ε) := by
  rw [QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε (-1) (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε 2 (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε 3 (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε (-6) (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε 1 (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε (-3) (by norm_num)),
    QED.DimReg.Gamma_one_add_eq_exp (setEGamma17_norm_mul_lt_one hε (-4) (by norm_num)),
    exp_ratio17]
  congr 1
  simp only [setEGammaX17, setEGammaXp17, setEGammaY17, setEGammaV17]
  ring

/-! ### The expansion -/

/-- The polynomial part of the remainder for `I₁₇`
(generated by `scripts/numerics/three_loop_masters/i17gen.py`). -/
noncomputable def setEGammaP17 (ε : ℂ) : ℂ :=
  (352 / 5 * (π : ℂ) ^ 4 + 2236 / 3 * (π : ℂ) ^ 2 + 4480 * (zeta3 : ℂ) - 552041 / 54) +
    (-880 * (π : ℂ) ^ 4 - 42818 / 3 * (π : ℂ) ^ 2 - 70208 * (zeta3 : ℂ) + 11899055 / 108) * ε +
    (3696 * (π : ℂ) ^ 4 + 293912 / 3 * (π : ℂ) ^ 2 + 416384 * (zeta3 : ℂ)
      - 13376114 / 27) * ε ^ 2 +
    (-6336 * (π : ℂ) ^ 4 - 1015066 / 3 * (π : ℂ) ^ 2 - 1264576 * (zeta3 : ℂ)
      + 130933183 / 108) * ε ^ 3 +
    (19008 / 5 * (π : ℂ) ^ 4 + 661176 * (π : ℂ) ^ 2 + 2204928 * (zeta3 : ℂ)
      - 1749489) * ε ^ 4 +
    (-749496 * (π : ℂ) ^ 2 - 2283264 * (zeta3 : ℂ) + 4462831 / 3) * ε ^ 5 +
    (463104 * (π : ℂ) ^ 2 + 1327104 * (zeta3 : ℂ) - 686496) * ε ^ 6 +
    (-120960 * (π : ℂ) ^ 2 - 331776 * (zeta3 : ℂ) + 131376) * ε ^ 7

/-- The remainder `R₁₇` with `I₁₇ C⁻¹ = L₁₇ + ε² R₁₇`. -/
noncomputable def setEGammaR17 (ε : ℂ) : ℂ :=
  (setEGammaP17 ε + setEGammaN17 ε * (ε * setEGammaY17 ε + setEGammaX17 ε ^ 2 / 2 +
    ε ^ 2 * setEGammaX17 ε ^ 3 * QED.DimReg.expRem3 (ε ^ 2 * setEGammaX17 ε))) /
    (6 * setEGammaD17 ε)

theorem analyticAt_setEGammaV17 : AnalyticAt ℂ setEGammaV17 0 := by
  have h1 := analyticAt_logGammaRem_mul (-1)
  have h2 := analyticAt_logGammaRem_mul 2
  have h3 := analyticAt_logGammaRem_mul 3
  have h4 := analyticAt_logGammaRem_mul (-6)
  have h5 := analyticAt_logGammaRem_mul 1
  have h6 := analyticAt_logGammaRem_mul (-3)
  have h7 := analyticAt_logGammaRem_mul (-4)
  unfold setEGammaV17
  fun_prop

theorem analyticAt_setEGammaR17 : AnalyticAt ℂ setEGammaR17 0 := by
  have hV := analyticAt_setEGammaV17
  have hY : AnalyticAt ℂ setEGammaY17 0 := by unfold setEGammaY17; fun_prop
  have hXp : AnalyticAt ℂ setEGammaXp17 0 := by unfold setEGammaXp17; fun_prop
  have hX : AnalyticAt ℂ setEGammaX17 0 := by unfold setEGammaX17; fun_prop
  have hE : AnalyticAt ℂ (fun ε => QED.DimReg.expRem3 (ε ^ 2 * setEGammaX17 ε)) 0 :=
    QED.DimReg.analyticAt_expRem3.comp_of_eq (by fun_prop) (by simp)
  have hP : AnalyticAt ℂ setEGammaP17 0 := by unfold setEGammaP17; fun_prop
  have hN : AnalyticAt ℂ setEGammaN17 0 := by unfold setEGammaN17; fun_prop
  have hD : AnalyticAt ℂ setEGammaD17 0 := by unfold setEGammaD17; fun_prop
  unfold setEGammaR17
  refine AnalyticAt.div (by fun_prop) (by fun_prop) ?_
  norm_num [setEGammaD17]

/-- **The input for `I₁₇`, proved**: `I₁₇ C⁻¹ = L₁₇(ε) + ε² R₁₇(ε)` with `R₁₇` analytic at `0`,
`L₁₇ = setELaurentI17` the LR96 table entry through `ε`. -/
theorem hasTruncLaurent_setEMasterI17 : HasTruncLaurent setEMasterI17 setELaurentI17 2 := by
  refine ⟨setEGammaR17, analyticAt_setEGammaR17, ?_⟩
  filter_upwards [setDGamma_eventually_small, self_mem_nhdsWithin] with ε hε h0
  have h0 : ε ≠ 0 := h0
  have hD := setEGammaD17_ne_zero hε
  rw [setEMasterI17_eq h0 hε, gammaRatio17_eq hε, QED.DimReg.exp_eq_expRem3, setEGammaR17]
  generalize QED.DimReg.expRem3 (ε ^ 2 * setEGammaX17 ε) = E
  have hDd : setEGammaD17 ε = (2 * ε - 1) * (3 * ε - 1) * (3 * ε - 2) * (2 - 3 * ε) *
      (1 - 3 * ε) * (3 - 4 * ε) * (2 - 4 * ε) * (1 - 4 * ε) := rfl
  generalize setEGammaD17 ε = D at *
  simp only [setELaurentI17, setEGammaX17, setEGammaXp17, setEGammaY17, setEGammaP17,
    setEGammaN17]
  generalize setEGammaV17 ε = V
  field_simp
  rw [hDd]
  ring

/-- The set (e) inputs with `I₁₇` discharged: the set (d) inputs, `I₁₇` the proved master, and
the inputs for `I₁, I₃` (through `ε`), `I₄, I₆, I₇, I₁₀`. -/
theorem SetEMasters.Expansions.ofSetD_of_I17 {M : SetEMasters}
    (hd : M.toSetDMasters.Expansions) (h17 : M.I17 = setEMasterI17)
    (h1 : HasTruncLaurent M.I1 setELaurentI1 1)
    (h3 : HasTruncLaurent M.I3 setELaurentI3 2)
    (h4 : HasTruncLaurent M.I4 setELaurentI4 2)
    (h6 : HasTruncLaurent M.I6 setELaurentI6 2)
    (h7 : HasTruncLaurent M.I7 setELaurentI7 2)
    (h10 : HasTruncLaurent M.I10 setELaurentI10 2) : M.Expansions :=
  SetEMasters.Expansions.ofSetD hd h1 h3 h4 h6 h7 h10 (h17 ▸ hasTruncLaurent_setEMasterI17)

end QED.ThreeLoopE
