theorem f2aV0pB0_ok : f2aV0pB0.all (GBlock.ok f2aV0pCtx 2 3 5 1 f2aV0pQE f2aV0pYb f2aV0pNF
    f2aV0pZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2aV0pBlocks : List GBlock :=
    f2aV0pB0

theorem f2aV0pPart0 :
    partOk f2aV0pCtx f2aV0pDen (rGetL (chunks f2aV0pTargetL f2aV0pTarget) 0)
      (rGetL (chunks f2aV0pMsL f2aV0pMs) 0) f2aV0pBlocks 0 = true := by
  decide +kernel

theorem f2aV0pMT_ok : mtOk f2a f2aV0pCtx 90 10 = true := by decide +kernel

theorem f2aV0pFac_ok : facOk f2aV0pCtx f2aV0pFac f2aV0pQE f2aV0pNF = true := by decide +kernel

theorem f2aV0pZS_eq :
    f2aV0pZS = f2a.zeroSectors.map fun S => S.map fun a => (a, f2aV0pCtx.B ^ a) := by
  decide +kernel

theorem f2aV0pBlocks_ok :
    f2aV0pBlocks.all (GBlock.ok f2aV0pCtx 2 3 5 1 f2aV0pQE f2aV0pYb f2aV0pNF f2aV0pZS) = true := by
  simp only [f2aV0pBlocks, f2aV0pB0_ok]

theorem f2aV0pClaim_range :
    (f2aV0pTarget ++ f2aV0pMs).all (fun t => inRange 8 3 5 t.1) = true := by
  decide +kernel

theorem f2aV0pBound :
    (f2aV0pBlocks.map fun b => b.seeds.length).sum * (10 * (f2aV0pYb * 90)) +
      Poly.norm1 f2aV0pDen * (f2aV0pTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2aV0pMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2aV0pCtx.x0 := by
  decide +kernel

theorem f2aV0pTargetL_lt : f2aV0pTargetL.length < 1 := by decide +kernel

theorem f2aV0pMsL_lt : f2aV0pMsL.length < 1 := by decide +kernel

theorem f2aV0pDen_ne_zero : Poly.isZero f2aV0pDen = false := by decide +kernel

/-- The master list of the checker is the Kira masters plus the symmetry terms. -/
theorem f2aV0pMs_comb :
    LinComb.ofTerms (f2aV0pMs ++ LinComb.smul [-1] (f2aV0pMasters ++ symTerms f2aV0pSyms)) =
      [] := by
  decide +kernel

theorem f2aV0p_parts : ∀ p < 1,
    partOk f2aV0pCtx f2aV0pDen (rGetL (chunks f2aV0pTargetL f2aV0pTarget) p)
      (rGetL (chunks f2aV0pMsL f2aV0pMs) p) f2aV0pBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2aV0pPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2aV0p` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations, the scaleless sectors and the
relabelling symmetries of `f2aV0pSyms` of `f2a` at `d`, the target combination `Σ tₗ(d) I(l)` equals
`Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2aV0p_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2aV0pDen ≠ 0) (I : (Fin f2a.nProp → ℤ) → K → K)
    (hI : f2a.IBPHolds I d) (hz : f2a.ZeroSectors I d)
    (hs : ∀ e ∈ f2aV0pSyms, f2a.SymHoldsAt I d e.1 e.2.1) :
    (f2aV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
      (f2aV0pMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2aV0pDen * I (toVec f2a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2aV0pDen) (T := f2aV0pTarget) (Ms := f2aV0pMs)
    (tl := f2aV0pTargetL) (ml := f2aV0pMsL) f2aV0pMT_ok f2aV0pFac_ok f2aV0pZS_eq f2aV0pBlocks_ok
    f2aV0pClaim_range f2aV0pTargetL_lt f2aV0pMsL_lt f2aV0pBound f2aV0p_parts I d hI hz hd
  rw [h]
  exact masters_of_comb f2a I d f2aV0pDen f2aV0pMs f2aV0pMasters f2aV0pSyms f2aV0pMs_comb hs

/-- **The `f2aV0p` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling symmetries of
`f2aV0pSyms` of `f2a` at `d`, the target combination equals the certified combination of the Kira
masters. -/
theorem f2aV0p_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2aV0pDen ≠ 0 ∧
      ∀ I : (Fin f2a.nProp → ℤ) → K → K, f2a.IBPHolds I d → f2a.ZeroSectors I d →
      (∀ e ∈ f2aV0pSyms, f2a.SymHoldsAt I d e.1 e.2.1) →
        (f2aV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
          (f2aV0pMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2aV0pDen * I (toVec f2a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2aV0pDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz hsym =>
    f2aV0p_reduction_of_den d (hs d hd) I hI hz hsym⟩⟩

