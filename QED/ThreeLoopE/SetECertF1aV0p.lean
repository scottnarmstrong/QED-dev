/-- The `f1aV0p` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at
`d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f1aV0p_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f1aV0pDen ≠ 0) (I : (Fin f1a.nProp → ℤ) → K → K)
    (hI : f1a.IBPHolds I d) (hz : f1a.ZeroSectors I d) :
    (f1aV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
      (f1aV0pMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f1aV0pDen * I (toVec f1a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f1aV0pDen) (T := f1aV0pTarget) (Ms := f1aV0pMs)
    (tl := f1aV0pTargetL) (ml := f1aV0pMsL) f1aV0pMT_ok f1aV0pFac_ok f1aV0pZS_eq f1aV0pBlocks_ok
    f1aV0pClaim_range f1aV0pTargetL_lt f1aV0pMsL_lt f1aV0pBound f1aV0p_parts I d hI hz hd
  exact h

/-- **The `f1aV0p` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f1aV0p_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f1aV0pDen ≠ 0 ∧
      ∀ I : (Fin f1a.nProp → ℤ) → K → K, f1a.IBPHolds I d → f1a.ZeroSectors I d →
        (f1aV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
          (f1aV0pMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f1aV0pDen * I (toVec f1a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f1aV0pDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f1aV0p_reduction_of_den d (hs d hd) I hI hz⟩⟩

