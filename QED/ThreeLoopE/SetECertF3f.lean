module

public import QED.ThreeLoopE.SetECertF3fFamily
public import QED.ThreeLoopE.SetECertF3d
public import QED.ThreeLoopE.SetECertSymTerms

/-!
# The `f3f` reduction of set (e), from its mirror `f3d`

The mirror (reversal of the electron line) of self-energy topology `f3f` is topology `f3d`: a change
of loop momenta maps the denominators of `QED.ThreeLoopE.SetECert.f3f` to those of
`QED.ThreeLoopE.SetECert.f3d`, `D₁ ↦ D₂`, `D₂ ↦ D₃`, `D₃ ↦ D₁`, `D₄ ↦ D₈`, `D₅ ↦ D₇`, `D₆ ↦ D₆`, `D₇
↦ D₅`, `D₈ ↦ D₄`, `D₉ ↦ D₉`, and the projected combination `Y - (d - 1)² T₁` of the `f3f` diagrams
to that of the `f3d` diagrams term by term: relabelling the index vectors of `f3fTarget` by
`permLabel f3fSigma` gives exactly `f3dTarget` (`f3fTarget_map`), and likewise for the Kira masters
(`f3fMasters_map`). The reduction of `f3f` is therefore the `f3d` certificate, for values `I` of the
`f3f` integrals that equal the values `J` of the relabelled `f3d` integrals.

## Main statements

* `QED.ThreeLoopE.SetECert.f3f_reduction_of_den`: at every `d` with `q(d) ≠ 0` (`q = f3dDen`), for
  every family of values `J` satisfying the hypotheses of `f3d_reduction_of_den` and every `I` with
  `I(ν) = J(permLabel f3fSigma ν)`, the `f3f` target combination equals the certified combination of
  the `f3f` Kira masters.
* `QED.ThreeLoopE.SetECert.f3f_reduction`: the same off a finite set of `d`.

Generated by `genmirror.py` (offline cache `setecert/fams`); do not edit. Integers are written as
`.ofNat n` and `.negSucc n` (`= -n - 1`).
-/

@[expose] public section

namespace QED.ThreeLoopE.SetECert

open QED.Algebra.IBPCert QED.Algebra.IBPCert.Sector

/-- The relabelling of `f3d` index vectors to `f3f` index vectors (generated). -/
def f3fSigmaInv : List ℕ := [1, 2, 0, 7, 6, 5, 4, 3, 8]

/-- The target combination of `f3f`: the projected combination `Y - (d - 1)² T₁` of the `f3f`
diagrams (integrals in scaleless sectors dropped), written as the relabelling of `f3dTarget`. That
this is term by term the survey's FORM projection of the `f3f` diagrams was checked offline
(`mirror.py`: all labels and coefficients agree). -/
noncomputable def f3fTarget : List (List Int × List Int) :=
  f3dTarget.map fun t => (permLabel f3fSigmaInv t.1, t.2)

/-- The Kira masters of `f3f` with their numerators: the relabelled `f3dMasters`. -/
noncomputable def f3fMasters : List (List Int × List Int) :=
  f3dMasters.map fun t => (permLabel f3fSigmaInv t.1, t.2)

/-- The relabelling of `f3f` index vectors to `f3d` index vectors (generated). -/
def f3fSigma : List ℕ := [2, 0, 1, 7, 6, 5, 4, 3, 8]

theorem f3fTarget_map :
    f3fTarget.map (fun t => (permLabel f3fSigma t.1, t.2)) = f3dTarget := by
  decide +kernel

theorem f3fMasters_map :
    f3fMasters.map (fun t => (permLabel f3fSigma t.1, t.2)) = f3dMasters := by
  decide +kernel

/-- The `f3f` reduction at every `d` with `q(d) ≠ 0`, from the `f3d` certificate: for values `J` of
the `f3d` integrals satisfying the IBP relations, the scaleless sectors and the symmetry entries of
`f3d` at `d`, and values `I` of the `f3f` integrals with `I(ν) = J(permLabel f3fSigma ν)`, the `f3f`
target combination equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the `f3f` Kira masters. -/
theorem f3f_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f3dDen ≠ 0) (I : (Fin f3f.nProp → ℤ) → K → K)
    (J : (Fin f3d.nProp → ℤ) → K → K) (hJ : f3d.IBPHolds J d)
    (hz : f3d.ZeroSectors J d)
    (hs : ∀ e ∈ f3dSyms, f3d.SymHoldsAt J d e.1 e.2.1)
    (hx : ∀ ν : List ℤ,
      I (toVec f3f.nProp ν) d = J (toVec f3d.nProp (permLabel f3fSigma ν)) d) :
    (f3fTarget.map fun t => Poly.eval d t.2 * I (toVec f3f.nProp t.1) d).sum =
      (f3fMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f3dDen * I (toVec f3f.nProp m.1) d).sum := by
  have h1 := sum_relabel f3f.nProp f3d.nProp f3fSigma I J d (Poly.eval d) f3fTarget
    fun t _ => hx t.1
  have h2 := sum_relabel f3f.nProp f3d.nProp f3fSigma I J d
    (fun p => Poly.eval d p / Poly.eval d f3dDen) f3fMasters fun t _ => hx t.1
  rw [f3fTarget_map] at h1
  rw [f3fMasters_map] at h2
  exact h1.trans ((f3d_reduction_of_den d hd J hJ hz hs).trans h2.symm)

/-- **The `f3f` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and the `f3f` target
combination equals the certified combination of its Kira masters, for values `I` of the `f3f`
integrals equal to relabelled values `J` of `f3d` integrals satisfying the hypotheses of the `f3d`
certificate. -/
theorem f3f_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f3dDen ≠ 0 ∧
      ∀ (I : (Fin f3f.nProp → ℤ) → K → K) (J : (Fin f3d.nProp → ℤ) → K → K),
        f3d.IBPHolds J d → f3d.ZeroSectors J d →
        (∀ e ∈ f3dSyms, f3d.SymHoldsAt J d e.1 e.2.1) →
        (∀ ν : List ℤ,
          I (toVec f3f.nProp ν) d = J (toVec f3d.nProp (permLabel f3fSigma ν)) d) →
        (f3fTarget.map fun t => Poly.eval d t.2 * I (toVec f3f.nProp t.1) d).sum =
          (f3fMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f3dDen * I (toVec f3f.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f3dDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I J hJ hz hsy hx =>
    f3f_reduction_of_den d (hs d hd) I J hJ hz hsy hx⟩⟩

end QED.ThreeLoopE.SetECert
