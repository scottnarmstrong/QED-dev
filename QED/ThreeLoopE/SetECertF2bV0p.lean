theorem f2bV0pB0_ok : f2bV0pB0.all (GBlock.ok f2bV0pCtx 2 3 5 1 f2bV0pQE f2bV0pYb f2bV0pNF
    f2bV0pZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2bV0pBlocks : List GBlock :=
    f2bV0pB0

theorem f2bV0pPart0 :
    partOk f2bV0pCtx f2bV0pDen (rGetL (chunks f2bV0pTargetL f2bV0pTarget) 0)
      (rGetL (chunks f2bV0pMsL f2bV0pMs) 0) f2bV0pBlocks 0 = true := by
  decide +kernel

theorem f2bV0pMT_ok : mtOk f2b f2bV0pCtx 74 13 = true := by decide +kernel

theorem f2bV0pFac_ok : facOk f2bV0pCtx f2bV0pFac f2bV0pQE f2bV0pNF = true := by decide +kernel

theorem f2bV0pZS_eq :
    f2bV0pZS = f2b.zeroSectors.map fun S => S.map fun a => (a, f2bV0pCtx.B ^ a) := by
  decide +kernel

theorem f2bV0pBlocks_ok :
    f2bV0pBlocks.all (GBlock.ok f2bV0pCtx 2 3 5 1 f2bV0pQE f2bV0pYb f2bV0pNF f2bV0pZS) = true := by
  simp only [f2bV0pBlocks, f2bV0pB0_ok]

theorem f2bV0pClaim_range :
    (f2bV0pTarget ++ f2bV0pMs).all (fun t => inRange 7 2 5 t.1) = true := by
  decide +kernel

theorem f2bV0pBound :
    (f2bV0pBlocks.map fun b => b.seeds.length).sum * (13 * (f2bV0pYb * 74)) +
      Poly.norm1 f2bV0pDen * (f2bV0pTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2bV0pMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2bV0pCtx.x0 := by
  decide +kernel

theorem f2bV0pTargetL_lt : f2bV0pTargetL.length < 1 := by decide +kernel

theorem f2bV0pMsL_lt : f2bV0pMsL.length < 1 := by decide +kernel

theorem f2bV0pDen_ne_zero : Poly.isZero f2bV0pDen = false := by decide +kernel

theorem f2bV0p_parts : ∀ p < 1,
    partOk f2bV0pCtx f2bV0pDen (rGetL (chunks f2bV0pTargetL f2bV0pTarget) p)
      (rGetL (chunks f2bV0pMsL f2bV0pMs) p) f2bV0pBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2bV0pPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2bV0p` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at
`d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2bV0p_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2bV0pDen ≠ 0) (I : (Fin f2b.nProp → ℤ) → K → K)
    (hI : f2b.IBPHolds I d) (hz : f2b.ZeroSectors I d) :
    (f2bV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
      (f2bV0pMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2bV0pDen * I (toVec f2b.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2bV0pDen) (T := f2bV0pTarget) (Ms := f2bV0pMs)
    (tl := f2bV0pTargetL) (ml := f2bV0pMsL) f2bV0pMT_ok f2bV0pFac_ok f2bV0pZS_eq f2bV0pBlocks_ok
    f2bV0pClaim_range f2bV0pTargetL_lt f2bV0pMsL_lt f2bV0pBound f2bV0p_parts I d hI hz hd
  exact h

/-- **The `f2bV0p` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f2b` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f2bV0p_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2bV0pDen ≠ 0 ∧
      ∀ I : (Fin f2b.nProp → ℤ) → K → K, f2b.IBPHolds I d → f2b.ZeroSectors I d →
        (f2bV0pTarget.map fun t => Poly.eval d t.2 * I (toVec f2b.nProp t.1) d).sum =
          (f2bV0pMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2bV0pDen * I (toVec f2b.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2bV0pDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f2bV0p_reduction_of_den d (hs d hd) I hI hz⟩⟩

