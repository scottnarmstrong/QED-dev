theorem f2aV1tB0_ok : f2aV1tB0.all (GBlock.ok f2aV1tCtx 2 3 5 1 f2aV1tQE f2aV1tYb f2aV1tNF
    f2aV1tZS) = true := by
  decide +kernel

/-- All seed blocks (generated). -/
noncomputable def f2aV1tBlocks : List GBlock :=
    f2aV1tB0

theorem f2aV1tPart0 :
    partOk f2aV1tCtx f2aV1tDen (rGetL (chunks f2aV1tTargetL f2aV1tTarget) 0)
      (rGetL (chunks f2aV1tMsL f2aV1tMs) 0) f2aV1tBlocks 0 = true := by
  decide +kernel

theorem f2aV1tMT_ok : mtOk f2a f2aV1tCtx 98 10 = true := by decide +kernel

theorem f2aV1tFac_ok : facOk f2aV1tCtx f2aV1tFac f2aV1tQE f2aV1tNF = true := by decide +kernel

theorem f2aV1tZS_eq :
    f2aV1tZS = f2a.zeroSectors.map fun S => S.map fun a => (a, f2aV1tCtx.B ^ a) := by
  decide +kernel

theorem f2aV1tBlocks_ok :
    f2aV1tBlocks.all (GBlock.ok f2aV1tCtx 2 3 5 1 f2aV1tQE f2aV1tYb f2aV1tNF f2aV1tZS) = true := by
  simp only [f2aV1tBlocks, f2aV1tB0_ok]

theorem f2aV1tClaim_range :
    (f2aV1tTarget ++ f2aV1tMs).all (fun t => inRange 9 3 5 t.1) = true := by
  decide +kernel

theorem f2aV1tBound :
    (f2aV1tBlocks.map fun b => b.seeds.length).sum * (10 * (f2aV1tYb * 98)) +
      Poly.norm1 f2aV1tDen * (f2aV1tTarget.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum +
      (f2aV1tMs.map fun t : List ℤ × Poly => Poly.norm1 t.2).sum < f2aV1tCtx.x0 := by
  decide +kernel

theorem f2aV1tTargetL_lt : f2aV1tTargetL.length < 1 := by decide +kernel

theorem f2aV1tMsL_lt : f2aV1tMsL.length < 1 := by decide +kernel

theorem f2aV1tDen_ne_zero : Poly.isZero f2aV1tDen = false := by decide +kernel

/-- The master list of the checker is the Kira masters plus the symmetry terms. -/
theorem f2aV1tMs_comb :
    LinComb.ofTerms (f2aV1tMs ++ LinComb.smul [-1] (f2aV1tMasters ++ symTerms f2aV1tSyms)) =
      [] := by
  decide +kernel

theorem f2aV1t_parts : ∀ p < 1,
    partOk f2aV1tCtx f2aV1tDen (rGetL (chunks f2aV1tTargetL f2aV1tTarget) p)
      (rGetL (chunks f2aV1tMsL f2aV1tMs) p) f2aV1tBlocks p = true := fun p hp =>
  match p, hp with
  | 0, _ => f2aV1tPart0
  | _ + 1, h => absurd h (by omega)

/-- The `f2aV1t` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations, the scaleless sectors and the
relabelling symmetries of `f2aV1tSyms` of `f2a` at `d`, the target combination `Σ tₗ(d) I(l)` equals
`Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f2aV1t_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f2aV1tDen ≠ 0) (I : (Fin f2a.nProp → ℤ) → K → K)
    (hI : f2a.IBPHolds I d) (hz : f2a.ZeroSectors I d)
    (hs : ∀ e ∈ f2aV1tSyms, f2a.SymHoldsAt I d e.1 e.2.1) :
    (f2aV1tTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
      (f2aV1tMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f2aV1tDen * I (toVec f2a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f2aV1tDen) (T := f2aV1tTarget) (Ms := f2aV1tMs)
    (tl := f2aV1tTargetL) (ml := f2aV1tMsL) f2aV1tMT_ok f2aV1tFac_ok f2aV1tZS_eq f2aV1tBlocks_ok
    f2aV1tClaim_range f2aV1tTargetL_lt f2aV1tMsL_lt f2aV1tBound f2aV1t_parts I d hI hz hd
  rw [h]
  exact masters_of_comb f2a I d f2aV1tDen f2aV1tMs f2aV1tMasters f2aV1tSyms f2aV1tMs_comb hs

/-- **The `f2aV1t` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations, the scaleless sectors and the relabelling symmetries of
`f2aV1tSyms` of `f2a` at `d`, the target combination equals the certified combination of the Kira
masters. -/
theorem f2aV1t_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f2aV1tDen ≠ 0 ∧
      ∀ I : (Fin f2a.nProp → ℤ) → K → K, f2a.IBPHolds I d → f2a.ZeroSectors I d →
      (∀ e ∈ f2aV1tSyms, f2a.SymHoldsAt I d e.1 e.2.1) →
        (f2aV1tTarget.map fun t => Poly.eval d t.2 * I (toVec f2a.nProp t.1) d).sum =
          (f2aV1tMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f2aV1tDen * I (toVec f2a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f2aV1tDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz hsym =>
    f2aV1t_reduction_of_den d (hs d hd) I hI hz hsym⟩⟩

