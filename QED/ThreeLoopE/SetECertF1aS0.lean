/-- The `f1aS0` reduction at every dimension `d` where the common denominator `q(d)` is nonzero: for
every family of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`,
the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f1aS0_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f1aS0Den ≠ 0) (I : (Fin f1a.nProp → ℤ) → K → K)
    (hI : f1a.IBPHolds I d) (hz : f1a.ZeroSectors I d) :
    (f1aS0Target.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
      (f1aS0Masters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f1aS0Den * I (toVec f1a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f1aS0Den) (T := f1aS0Target) (Ms := f1aS0Ms)
    (tl := f1aS0TargetL) (ml := f1aS0MsL) f1aS0MT_ok f1aS0Fac_ok f1aS0ZS_eq f1aS0Blocks_ok
    f1aS0Claim_range f1aS0TargetL_lt f1aS0MsL_lt f1aS0Bound f1aS0_parts I d hI hz hd
  exact h

/-- **The `f1aS0` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f1aS0_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f1aS0Den ≠ 0 ∧
      ∀ I : (Fin f1a.nProp → ℤ) → K → K, f1a.IBPHolds I d → f1a.ZeroSectors I d →
        (f1aS0Target.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
          (f1aS0Masters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f1aS0Den * I (toVec f1a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f1aS0Den_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f1aS0_reduction_of_den d (hs d hd) I hI hz⟩⟩

