/-- The `f1aV0t` reduction at every dimension `d` where the common denominator `q(d)` is nonzero:
for every family of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at
`d`, the target combination `Σ tₗ(d) I(l)` equals `Σ (nⱼ(d) / q(d)) I(Mⱼ)` over the Kira masters. -/
theorem f1aV0t_reduction_of_den {K : Type*} [Field K] [CharZero K] (d : K)
    (hd : Poly.eval d f1aV0tDen ≠ 0) (I : (Fin f1a.nProp → ℤ) → K → K)
    (hI : f1a.IBPHolds I d) (hz : f1a.ZeroSectors I d) :
    (f1aV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
      (f1aV0tMasters.map fun m =>
        Poly.eval d m.2 / Poly.eval d f1aV0tDen * I (toVec f1a.nProp m.1) d).sum := by
  have h := gcert_reduction (P := 1) (den := f1aV0tDen) (T := f1aV0tTarget) (Ms := f1aV0tMs)
    (tl := f1aV0tTargetL) (ml := f1aV0tMsL) f1aV0tMT_ok f1aV0tFac_ok f1aV0tZS_eq f1aV0tBlocks_ok
    f1aV0tClaim_range f1aV0tTargetL_lt f1aV0tMsL_lt f1aV0tBound f1aV0t_parts I d hI hz hd
  exact h

/-- **The `f1aV0t` reduction.** Off a finite set of dimensions `d`, `q(d) ≠ 0` and, for every family
of values `I` satisfying the IBP relations and the scaleless sectors of `f1a` at `d`, the target
combination equals the certified combination of the Kira masters. -/
theorem f1aV0t_reduction {K : Type*} [Field K] [CharZero K] :
    ∃ s : Finset K, ∀ d ∉ s, Poly.eval d f1aV0tDen ≠ 0 ∧
      ∀ I : (Fin f1a.nProp → ℤ) → K → K, f1a.IBPHolds I d → f1a.ZeroSectors I d →
        (f1aV0tTarget.map fun t => Poly.eval d t.2 * I (toVec f1a.nProp t.1) d).sum =
          (f1aV0tMasters.map fun m =>
            Poly.eval d m.2 / Poly.eval d f1aV0tDen * I (toVec f1a.nProp m.1) d).sum := by
  obtain ⟨s, hs⟩ := Poly.exists_finset_eval_ne_zero (K := K) f1aV0tDen_ne_zero
  exact ⟨s, fun d hd => ⟨hs d hd, fun I hI hz =>
    f1aV0t_reduction_of_den d (hs d hd) I hI hz⟩⟩

